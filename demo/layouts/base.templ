package layouts

// Base is the HTML shell shared by every demo page: the full document with
// head, topbar navigation, a centered <main> for page content, the component
// script bundle, and the toast container. Wrap page bodies in it so all demo
// pages get identical chrome and JS wiring.
//
// title is interpolated into the document title as "{title} — Webframe".
//
// Returns a templ.Component rendering a complete <!DOCTYPE html> document;
// children render inside <main> (max-w-5xl, centered).
//
// What it loads, in order:
//   - /static/css/output.css — the compiled Tailwind stylesheet
//   - an inline flash-free theme script that reads localStorage key
//     "wf-theme" and sets data-theme on <html> (falling back to "dark")
//     before first paint
//   - htmx.min.js (blocking) and alpine.min.js (deferred)
//   - the per-component scripts: popover, dropdown, dialog, selectbox, tabs,
//     input, checkbox, textarea, avatar, label, theme-toggle
//   - an inline htmx:afterSwap listener that calls Alpine.initTree on
//     swapped-in content, so Alpine components keep working after HTMX
//     updates
//
// It also renders the #toast-container div targeted by the demo's
// out-of-band toast swaps, and the data-theme-toggle button that
// theme-toggle.js wires up. Note trafficstream.min.js is NOT included here;
// pages using TrafficStream must add trafficstream.Script() themselves.
//
// @side-effects inline scripts mutate document state at load time (data-theme
// attribute, Alpine re-init on HTMX swaps)
// @boundary browser localStorage ("wf-theme") and static asset URLs under /static/
templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } — Webframe</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script>
				// Flash-free theme init
				(function(){
					var t;
					try { t = localStorage.getItem('wf-theme'); } catch(e) {}
					document.documentElement.setAttribute('data-theme', t || 'dark');
				})();
			</script>
			<script src="/static/js/htmx.min.js"></script>
			<script defer src="/static/js/alpine.min.js"></script>
		</head>
		<body class="wf-theme antialiased">
			<!-- Topbar -->
			<nav class="wf-topbar">
				<div class="wf-topbar-inner">
					<div class="flex items-center gap-6">
						<a href="/" class="text-lg font-bold tracking-tight">Webframe</a>
						<div class="hidden sm:flex items-center gap-4">
							<a href="#buttons" class="wf-nav-link">Buttons</a>
							<a href="#cards" class="wf-nav-link">Cards</a>
							<a href="#forms" class="wf-nav-link">Forms</a>
							<a href="#interactive" class="wf-nav-link">Interactive</a>
							<a href="#patterns" class="wf-nav-link">Patterns</a>
							<a href="/traffic" class="wf-nav-link">Traffic</a>
						</div>
					</div>
					<button data-theme-toggle class="wf-theme-toggle">Light Mode</button>
				</div>
			</nav>
			<!-- Main content -->
			<main class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
				{ children... }
			</main>
			<!-- Scripts -->
			<script defer src="/static/js/popover.min.js"></script>
			<script defer src="/static/js/dropdown.min.js"></script>
			<script defer src="/static/js/dialog.min.js"></script>
			<script defer src="/static/js/selectbox.min.js"></script>
			<script defer src="/static/js/tabs.min.js"></script>
			<script defer src="/static/js/input.min.js"></script>
			<script defer src="/static/js/checkbox.min.js"></script>
			<script defer src="/static/js/textarea.min.js"></script>
			<script defer src="/static/js/avatar.min.js"></script>
			<script defer src="/static/js/label.min.js"></script>
			<script defer src="/static/js/theme-toggle.js"></script>
			<!-- HTMX + Alpine integration -->
			<script>
				document.addEventListener('htmx:afterSwap', function(e) {
					if (window.Alpine) Alpine.initTree(e.detail.elt);
				});
			</script>
			<!-- Toast container -->
			<div id="toast-container" class="wf-toast-container"></div>
		</body>
	</html>
}
