package pages

import (
	"github.com/bplus/webframe/components/action"
	"github.com/bplus/webframe/components/button"
	"github.com/bplus/webframe/components/form"
	"github.com/bplus/webframe/components/keyvalueeditor"
	"github.com/bplus/webframe/components/layout"
)

// SettingsAfter is the settings page's After content
// (settingspage.Props.After): the Environment editor, then the Danger zone.
// Both sit outside the settings form, after it and before the save bar, so
// a settings submit never posts them and an error re-render never redraws
// them.
templ SettingsAfter(env keyvalueeditor.Props, danger action.Action) {
	@layout.Stack(layout.StackProps{Gap: layout.GapL}) {
		@EnvironmentSection(env)
		@DangerZone(danger)
	}
}

// EnvironmentSection is an h2 section holding the Environment key/value
// editor in its own form.Form: the editor is not a formfield type, so it
// cannot be a field of the settings form, and its rows post to
// /settings/environment with their own Save button. Add variable appends a
// row under the last one and nothing above it moves; a row left with a
// blank name is dropped on save.
templ EnvironmentSection(env keyvalueeditor.Props) {
	@layout.Section(layout.SectionProps{ID: "environment", Title: "Environment", Description: "Variables the demo would pass to a build. Rows post as env.key and env.value pairs; the handler zips them back together.", Level: 2}) {
		@form.Form(form.Props{ID: "environment-form", Action: "/settings/environment", HxPost: "/settings/environment", HxSwap: "none"}) {
			@layout.Stack(layout.StackProps{Gap: layout.GapS}) {
				@keyvalueeditor.KeyValueEditor(env)
				@layout.Inline(layout.InlineProps{Justify: layout.JustifyEnd}) {
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantSecondary}) {
						Save environment
					}
				}
			}
		}
	}
}

// DangerZone is an h2 section holding one destructive action that asks
// first; the demo then refuses it (HandleDeleteAccount).
templ DangerZone(danger action.Action) {
	@layout.Section(layout.SectionProps{ID: "danger-zone", Title: "Danger zone", Description: "Deleting the account removes every item and pack it owns; the dialog asks first, and the demo then refuses.", Level: 2}) {
		@action.Button(danger)
	}
}
