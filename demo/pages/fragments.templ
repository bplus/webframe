package pages

import (
	"fmt"
	"strconv"

	"github.com/bplus/webframe/components/badge"
	"github.com/bplus/webframe/components/button"
	"github.com/bplus/webframe/components/layout"
)

// The fragments below are the htmx responses of the demo's interaction
// examples (served by demo/handlers.go). They compose components only, so
// the handlers never build HTML from Go strings.

// ClickButton is the replacement button for the click-to-update demo: it
// posts back to /api/click with the count in hx-vals and swaps itself out.
templ ClickButton(n int) {
	@button.Button(button.Props{Attributes: templ.Attributes{
		"hx-post": "/api/click",
		"hx-swap": "outerHTML",
		"hx-vals": fmt.Sprintf(`{"count":"%d"}`, n),
	}}) {
		Clicked { strconv.Itoa(n) } times
	}
}

// PickedResult is the autocomplete form's submit reply: a badge showing
// the hidden framework value the form sent ("framework=" alone, plus a
// "nothing picked" note, when the user typed without picking), followed by
// the visible text box value q.
templ PickedResult(value, text string) {
	@layout.Inline(layout.InlineProps{Gap: layout.GapS, Align: layout.AlignCenter, Wrap: true}) {
		@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
			framework={ value }
		}
		if value == "" {
			<small>nothing picked</small>
		}
		if text != "" {
			<small>q={ text }</small>
		}
	}
}

// SlowResult is the spinner demo's reply (GET /api/slow): the clock time
// the server answered, as one small line, so each click visibly changes it.
templ SlowResult(at string) {
	<small>Answered at { at }</small>
}
