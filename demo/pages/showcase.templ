templ customSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "custom", Title: "Custom fences", Description: "The declared escape hatch for markup no component covers."}) {
		<p>Markup no component covers goes inside a <code>customblock.CustomBlock</code> (or a whole page inside a <code>custompage.CustomPage</code>) with a written Reason. Everything inside a fence is exempt from the lint, and every fence is printed by <code>make check-ui</code> so none can hide.</p>
		<p>This demo declares no fences: the swatch below is an ordinary component, and <code>make check-ui</code> reports zero custom fences for the whole demo.</p>
		@swatch.Swatch(swatch.Props{Color: "var(--color-border)", Label: "no fence needed"})
	}
}

// ═══════════════════════════════════════
// Sticky table header and the phone sort control
// ═══════════════════════════════════════

// manyRows builds n example rows for the sticky header tables: numbered
// names, the four types and four status words in rotation, no actions.
func manyRows(n int) []datatable.Row {
	types := []string{"Weapon", "Armor", "Accessory", "Consumable"}
	statuses := []string{"published", "draft", "running", "failed"}
	rows := make([]datatable.Row, 0, n)
	for i := 0; i < n; i++ {
		status := statuses[i%len(statuses)]
		rows = append(rows, datatable.Row{
			ID: strconv.Itoa(i + 1),
			Cells: []datatable.Cell{
				{Text: "Example item " + strconv.Itoa(i+1)},
				{Text: types[i%len(types)], Muted: true},
				datatable.BadgeCell(badge.StatusLabel(status), status),
				{Text: strconv.Itoa(i+1) + "d"},
			},
		})
	}
	return rows
}

templ stickyheaderSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "stickyheader", Title: "Sticky table header", Description: "Scroll inside the first table and the page past the second: the header row stays in view in both; below 768px the second one's header sticks only within the table's own scroll box, since that box is what keeps a wide table reachable on a phone."}) {
		@panel.Panel(panel.Props{Level: 4, Title: "Thirty rows in a 400px box", Flush: true, Subtitle: "MaxHeight Md caps the table and the rows scroll inside it; the header sticks to the top of that box at every width."}) {
			@datatable.DataTable(datatable.Props{
				ID:           "sticky-capped",
				Caption:      "Thirty example items in a capped table",
				Columns:      tableColumns,
				Rows:         manyRows(30),
				Spec:         tableSpec(),
				Base:         "#",
				StickyHeader: true,
				MaxHeight:    datatable.HeightMd,
			})
		}
		@panel.Panel(panel.Props{Level: 4, Title: "Twelve rows, page-level", Flush: true, Subtitle: "No cap: the table is as tall as its rows and, from 768px up, the header sticks to the top of the window while the page scrolls past it."}) {
			@datatable.DataTable(datatable.Props{
				ID:           "sticky-page",
				Caption:      "Twelve example items with a page-level sticky header",
				Columns:      tableColumns,
				Rows:         manyRows(12),
				Spec:         tableSpec(),
				Base:         "#",
				StickyHeader: true,
			})
		}
	}
}

templ phonesortSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "phonesort", Title: "Phone sort control", Description: "Open the Items list at 390px: the Type and Updated columns are hidden there, and their sort links with them, so the filter bar ends in a Sort select offering every sortable column both ways; choose Updated ↑ and the list re-sorts exactly as a header click would."}) {
		<p>There is nothing to add to a page for it: listpage renders the select whenever a column is sortable, below 768px only, and keeps it in step with the header links. See it on <a href="/items">Items</a>.</p>
	}
}

// ═══════════════════════════════════════
// Error and auth pages
// ═══════════════════════════════════════
templ errorpageSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "errorpage", Title: "Error pages", Description: "Each link answers with the status it names and renders the page in the shell, so the nav still works; the 500 shows a request id to quote, and any address this demo does not serve gets the 404 the same way."}) {
		@layout.Stack(layout.StackProps{Gap: layout.GapS}) {
			<p><a href="/errors/404">404 Page not found</a>: the default wording and a Go home button.</p>
			<p><a href="/errors/403">403 Not allowed</a>: for a signed-in user without access to the page.</p>
			<p><a href="/errors/500">500 Something went wrong</a>: with the request id under the message.</p>
			<p><a href="/no-such-page">/no-such-page</a>: the server's catch-all, through the same component.</p>
		}
	}
}

templ authpageSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "authpage", Title: "Auth pages", Description: "The three pages an app shows outside its shell: no nav, one centered card with the app name as the heading; the sign-in form refuses every submission and re-renders with the error and the typed email."}) {
		@layout.Stack(layout.StackProps{Gap: layout.GapS}) {
			<p><a href="/signin">Sign in</a>: email and password with a full-width submit button.</p>
			<p><a href="/signed-out">Signed out</a>: the message and a link back to sign in.</p>
			<p><a href="/forbidden">Forbidden</a>: the message and a way home.</p>
		}
	}
}

// ═══════════════════════════════════════
// Feedback: toast, flash, confirm dialog, skeleton, spinner, bottom sheet
// ═══════════════════════════════════════
templ feedbackGroup() {
	@layout.Section(layout.SectionProps{Level: 2, ID: "feedback", Title: "Feedback"}) {
		@toastSection()
		@flashSection()
		@confirmSection()
		@skeletonSection()
		@spinnerSection()
		@bottomsheetSection()
		@errorswapSection()
	}
}

// variantVals is the hx-vals JSON that tells /api/toast which toast to
// send; v is one of the showcase's fixed variant words, never user input.
func variantVals(v string) string {
	return `{"variant":"` + v + `"}`
}

// toastButton is one Toast section button: it posts the variant to
// /api/toast and swaps nothing itself, since the reply arrives out of band.
templ toastButton(variant, label string, v button.Variant) {
	@button.Button(button.Props{Size: button.SizeSm, Variant: v, Attributes: templ.Attributes{"hx-post": "/api/toast", "hx-vals": variantVals(variant), "hx-swap": "none"}}) {
		{ label }
	}
}

templ toastSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "toast", Title: "Toast", Description: "Each button posts to the server and the reply is one toast appended out of band to the container the shell renders: watch the top right (the top of the screen on a phone), where toasts stack and leave on their own after four seconds; the sticky one stays until you dismiss it."}) {
		@layout.Inline(layout.InlineProps{Wrap: true, Gap: layout.GapS}) {
			@toastButton("error", "Error", button.VariantDestructive)
			@toastButton("warning", "Warning", button.VariantOutline)
			@toastButton("info", "Info", button.VariantSecondary)
			@toastButton("success", "Success", button.VariantDefault)
			@toastButton("sticky", "Sticky error", button.VariantOutline)
		}
		<p><code>toast.Send</code> writes the toast only for an htmx request; a handler that answers with a redirect has no page to put it on and sets a flash instead (next section). Errors and warnings are the expected kinds; a success toast is opt-in, for an action whose only visible result would otherwise be nothing.</p>
	}
}

templ flashSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "flash", Title: "Flash", Description: "Submit the form: the server stores a one-shot warning in a cookie and redirects to the top of this page, where the banner appears once in the slot above the page title; reload and it is gone."}) {
		@form.Form(form.Props{ID: "flash-form", Action: "/api/flash"}) {
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
				Set a flash and redirect
			}
		}
		<p>The cookie is HttpOnly, lives five minutes at most and is cleared by the render that shows it. A flash set by an htmx action reaches the same slot out of band, on the page the user is already looking at.</p>
	}
}

templ confirmSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "confirmdialog", Title: "Confirm dialog", Description: "Both actions ask first, in the styled dialog instead of the browser's box: Cancel, Escape and the backdrop close it and send nothing; Confirm sends the request exactly once, and the reply is a toast."}) {
		@action.Group([]action.Action{
			{Label: "Delete item", Variant: action.VariantDestructive, HxPost: "/api/toast", HxSwap: "none", Attributes: templ.Attributes{"hx-vals": variantVals("warning")}, Confirm: &action.Confirm{Title: "Delete this item?", Message: "Deleting is permanent; the item leaves every pack that uses it.", ConfirmLabel: "Delete", CancelLabel: "Keep it"}},
			{Label: "Archive item", HxPost: "/api/toast", HxSwap: "none", Attributes: templ.Attributes{"hx-vals": variantVals("info")}, Confirm: &action.Confirm{Message: "Archive this item? You can restore it later."}},
		})
		<p>A destructive action gets the destructive confirm button, a plain one the primary. Title, message and both labels come from <code>action.Confirm</code>; only the message is required, and it doubles as the native <code>hx-confirm</code> text when the script is missing.</p>
	}
}

// skeletonRows are the three rows of the Skeleton section's real table, the
// counterpart of skeleton.Table(3, 4): four plain cells, no actions.
var skeletonRows = []datatable.Row{
	{ID: "s1", Cells: []datatable.Cell{{Text: "Flame Tongue"}, {Text: "Weapon", Muted: true}, datatable.BadgeCell(badge.StatusLabel("published"), "published"), {Text: "2d"}}},
	{ID: "s2", Cells: []datatable.Cell{{Text: "Cloak of Billowing"}, {Text: "Armor", Muted: true}, datatable.BadgeCell(badge.StatusLabel("draft"), "draft"), {Text: "5h"}}},
	{ID: "s3", Cells: []datatable.Cell{{Text: "Bottled Bolt"}, {Text: "Consumable", Muted: true}, datatable.BadgeCell(badge.StatusLabel("failed"), "failed"), {Text: "1w"}}},
}

templ skeletonSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "skeleton", Title: "Skeleton", Description: "Each placeholder sits beside the real thing it stands in for: Card, Table and Tile are the height of the panel, table and stat tile next to them, so a region that shows the skeleton while it loads does not move when the content arrives; Lines is the bare run of bars for a short block of text."}) {
		@dashboardgrid.Grid(dashboardgrid.Props{Flush: true}) {
			@dashboardgrid.Slot(dashboardgrid.SlotProps{ColSpan: 6}) {
				@skeleton.Card()
			}
			@dashboardgrid.Slot(dashboardgrid.SlotProps{ColSpan: 6}) {
				@panel.Panel(panel.Props{Level: 4, Title: "Build summary"}) {
					@layout.Stack(layout.StackProps{Gap: layout.GapXS}) {
						<p>Thirty-one of thirty-eight builds passed.</p>
						<p>Seven failed on missing textures.</p>
						<p>The last run finished two hours ago.</p>
					}
				}
			}
			@dashboardgrid.Slot(dashboardgrid.SlotProps{ColSpan: 6}) {
				@skeleton.Table(3, 4)
			}
			@dashboardgrid.Slot(dashboardgrid.SlotProps{ColSpan: 6}) {
				@datatable.DataTable(datatable.Props{
					ID:      "skeleton-table",
					Caption: "Three example items",
					Columns: tableColumns,
					Rows:    skeletonRows,
					Spec:    tableSpec(),
					Base:    "#",
				})
			}
			@dashboardgrid.Slot(dashboardgrid.SlotProps{ColSpan: 6}) {
				@skeleton.Tile()
			}
			@dashboardgrid.Slot(dashboardgrid.SlotProps{ColSpan: 6}) {
				@stattile.StatTile(stattile.Props{Label: "Builds", Value: "38", Delta: &stattile.Delta{Value: "+4", Direction: statcomparison.DirectionUp}, Sub: "31 passed · 7 failed"})
			}
			@dashboardgrid.Slot(dashboardgrid.SlotProps{ColSpan: 6}) {
				@skeleton.Lines(3)
			}
			@dashboardgrid.Slot(dashboardgrid.SlotProps{ColSpan: 6}) {
				<p>skeleton.Lines(n) is n bars at the pitch of small text, with no frame around them: the placeholder for a block of lines like this one while it loads.</p>
			}
		}
	}
}

templ spinnerSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "spinner", Title: "Spinner", Description: "Three sizes and the inline form with its label; the spinner inside the button is an htmx indicator, invisible until you click, fading in while the slow request (1.5 s) is in flight and out when the answer lands beside it."}) {
		@layout.Inline(layout.InlineProps{Wrap: true, Align: layout.AlignCenter}) {
			@spinner.Spinner(spinner.Props{Size: spinner.SizeSm, Label: "Loading, small"})
			@spinner.Spinner(spinner.Props{Label: "Loading, medium"})
			@spinner.Spinner(spinner.Props{Size: spinner.SizeLg, Label: "Loading, large"})
			@spinner.Inline("Saving…")
		}
		@layout.Inline(layout.InlineProps{Wrap: true, Gap: layout.GapS, Align: layout.AlignCenter}) {
			@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{"hx-get": "/api/slow", "hx-target": "#slow-result"}}) {
				@spinner.Spinner(spinner.Props{Size: spinner.SizeSm, Indicator: true, Label: "Waiting for the server"})
				Load slowly
			}
			<span id="slow-result"></span>
		}
	}
}

// sheetParagraphs fill the bottom sheet past its 60vh cap on a phone, so
// the Body scrolls while the header and footer stay put.
var sheetParagraphs = []string{
	"A bottom sheet holds the controls a phone has no room for beside the content: a filter set, a row's actions, a share menu. On a desktop it is the same panel, still anchored to the bottom edge.",
	"It spans the full width at every size and rises to at most 60% of the viewport here (Height Md; Sm is 40%, Lg 85%). Past that cap this body scrolls on its own while the title above and the buttons below stay where they are.",
	"The header keeps its close button, Escape and the backdrop close it, and focus moves into the panel when it opens and back to the trigger after.",
	"The footer's Fire a toast button posts to the server while the sheet is open: the toast appears at the top of the screen, above the sheet and its backdrop, so it is seen without covering Done.",
	"The sheet respects the safe area at the bottom of a phone screen, so the footer's buttons sit above the home indicator rather than under it.",
	"Everything in here is ordinary page content: paragraphs, a form, a list, whatever the task needs. Only the frame is the component's.",
	"This paragraph exists so there is enough text to scroll at 390 by 844; on a desktop the cap is rarely reached and the sheet is only as tall as its content.",
}

templ bottomsheetSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "bottomsheet", Title: "Bottom sheet", Description: "Open it at any width, then at 390px: the sheet rises from the bottom edge, spans the width, stops at 60% of the viewport and scrolls inside; a toast fired from its footer appears at the top of the screen, above the sheet and never over its buttons."}) {
		@slideover.SlideOver(slideover.Props{ID: "sheet-demo"}) {
			@slideover.Trigger() {
				@button.Button(button.Props{Variant: button.VariantOutline}) {
					Open bottom sheet
				}
			}
			@slideover.Panel(slideover.PanelProps{Title: "Filter items", Side: slideover.SideBottom, Height: slideover.HeightMd}) {
				@slideover.Body() {
					@layout.Stack(layout.StackProps{Gap: layout.GapS}) {
						for _, text := range sheetParagraphs {
							<p>{ text }</p>
						}
					}
				}
				@slideover.Footer() {
					@button.Button(button.Props{Variant: button.VariantSecondary, Attributes: templ.Attributes{"hx-post": "/api/toast", "hx-vals": variantVals("warning"), "hx-swap": "none"}}) {
						Fire a toast
					}
					@slideover.Close() {
						@button.Button() {
							Done
						}
					}
				}
			}
		}
	}
}

// ═══════════════════════════════════════
// Card grid, timeline, split pane, the three page types
// ═══════════════════════════════════════

// showcaseArt is the local placeholder every showcase card shows.
const showcaseArt = "/static/img/placeholder-wide.svg"

// showcaseCards are the Card grid section's four cards: a title that wraps,
// a status of each kind, meta facts and one footer action each.
var showcaseCards = []cardgrid.Card{
	{Title: "Blade of the Fallen Star", Subtitle: "Weapon", Href: "/items/1", Art: &cardgrid.Art{Src: showcaseArt}, Badges: []cardgrid.Badge{cardgrid.StatusBadge("", "published")}, Meta: []string{"Starfall Pack", "Updated 2d ago"}, Actions: []action.Action{{Label: "Edit", Href: "/items/1/edit"}}},
	{Title: "Cloak of Whispers", Subtitle: "Armor", Href: "/items/2", Art: &cardgrid.Art{Src: showcaseArt}, Badges: []cardgrid.Badge{cardgrid.StatusBadge("", "draft")}, Meta: []string{"Not in a pack", "Updated 3d ago"}, Actions: []action.Action{{Label: "Edit", Href: "/items/2/edit"}}},
	{Title: "Circlet of Borrowed Thought and Other Long Names", Subtitle: "Accessory", Href: "/items/9", Art: &cardgrid.Art{Src: showcaseArt}, Badges: []cardgrid.Badge{cardgrid.StatusBadge("", "published"), cardgrid.StatusBadge("Remixable", "info")}, Meta: []string{"Updated 3w ago"}, Actions: []action.Action{{Label: "Edit", Href: "/items/9/edit"}}},
	{Title: "Bottled Bolt", Subtitle: "Consumable", Badges: []cardgrid.Badge{cardgrid.StatusBadge("", "failed")}, Meta: []string{"Build failed", "1w ago"}, Actions: []action.Action{{Label: "Retry", HxPost: "/api/toast", HxSwap: "none", Attributes: templ.Attributes{"hx-vals": variantVals("info")}}}},
}

templ cardgridSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "cardgrid", Title: "Card grid", Description: "Narrow the window: four columns at 1280px, two around 640px and one at 390px, the art keeping its 16:9 frame at every width; the whole card is the link, and the footer button still works on its own."}) {
		@cardgrid.CardGrid(cardgrid.Props{ID: "showcase-cards", Items: showcaseCards})
		<p>The last card has no art and no link, so its title is plain text and the card starts at the title. A grid with no items shows an empty state across the full width.</p>
	}
}

// showcaseEvents are the Timeline section's events: two days, every dot
// tone, a wrapping title and a body, all at fixed times so the page is
// deterministic.
var showcaseEvents = []timeline.Item{
	{At: time.Date(2026, 10, 30, 9, 12, 0, 0, time.UTC), Title: "Blade of the Fallen Star published", Body: "Visible to every builder from the Starfall Pack page.", Href: "/items/1", Variant: badge.VariantSuccess, Meta: "by Morgan"},
	{At: time.Date(2026, 10, 30, 8, 40, 0, 0, time.UTC), Title: "Build of Starfall Pack started", Variant: badge.VariantInfo},
	{At: time.Date(2026, 10, 29, 17, 5, 0, 0, time.UTC), Title: "Cloak of Whispers saved as a draft, with a title long enough to wrap onto a second line at phone width", Body: "The rail and the dots stay aligned while this title wraps.", Href: "/items/2", Variant: badge.VariantSecondary},
	{At: time.Date(2026, 10, 29, 11, 30, 0, 0, time.UTC), Title: "Bottled Bolt build failed", Body: "The recipe names a texture the pack does not ship.", Variant: badge.VariantDestructive, Meta: "trace-demo-014"},
	{At: time.Date(2026, 10, 29, 9, 0, 0, 0, time.UTC), Title: "Netherese Relics marked stale", Variant: badge.VariantWarning},
}

templ timelineSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "timeline", Title: "Timeline", Description: "Dated events on a rail, newest first and grouped by day; at 390px the time moves above the title and the third item's long title wraps while the rail and dots stay in one line."}) {
		@timeline.Timeline(timeline.Props{ID: "showcase-timeline", Items: showcaseEvents, Location: time.UTC})
		<p>Each dot takes the tone of the badge variant the event names (success, info, secondary, destructive, warning), and a title with a link opens the item. The dashboard's <a href="/dashboard">Recent changes</a> section is the same component fed from the Items store.</p>
	}
}

templ splitpaneSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "splitpane", Title: "Split pane", Description: "Open Browse at 1280px and click a name: only the right pane changes and the address bar follows; open it at 390px and the same click is a plain navigation to the detail, with All items leading back."}) {
		@layout.Stack(layout.StackProps{Gap: layout.GapS}) {
			<p><a href="/browse">Browse</a>: the list of item names on the left and, from 768px up, a placeholder on the right until something is picked; at 390px the list alone.</p>
			<p><a href="/browse/3">Browse, item 3</a>: the same page with Ring of Hoarded Light selected; reload it at 390px and the detail shows with the back link, so a bookmark and the browser's Back both work.</p>
		}
	}
}

templ dashboardpageSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "dashboardpage", Title: "Dashboard page", Description: "Four tiles on one row at 1280px, then Recent changes beside Newest items (4 and 8 of 12 columns); below 900px every tile and section stacks one per row with nothing wider than the screen."}) {
		<p><a href="/dashboard">Dashboard</a>: the tiles count the Items store, the timeline lists its last eight updates and the card grid shows the four newest items; create or publish an item and come back.</p>
	}
}

templ settingspageSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "settingspage", Title: "Settings page", Description: "Clear the display name and save: the form re-renders in place with the error under the field and in the banner, every other value kept, and the save bar still at the bottom of the screen; fix it and save, and the page simply reloads with the saved values."}) {
		<p><a href="/settings">Settings</a>: Profile and Notifications as groups of fields, a save bar that is always there (at 390px it sits above the home indicator and never covers the last field), and a Danger zone whose Delete account asks first and is then refused.</p>
	}
}

templ streampageSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "streampage", Title: "Stream page", Description: "The Traffic page is one streampage declaration: header, the live panel and its script; at 390px the panel's search and selects stack and its table scrolls sideways inside the panel, not the page."}) {
		<p><a href="/traffic">Traffic</a>: the stream opens its connection as soon as the page loads and the panel's own controls filter it.</p>
	}
}

templ methodnotallowedSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "methodnotallowed", Title: "405 page", Description: "Submit the form: it POSTs to /traffic, which only answers GET, and the styled 405 page renders in the shell with an Allow header naming what the address accepts."}) {
		@form.Form(form.Props{ID: "post-get-only", Action: "/traffic"}) {
			@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline}) {
				POST to a GET-only address
			}
		}
		<p>Go's ServeMux answers a wrong method itself, in plain text, before any handler runs; the demo's server wraps the mux as the errorpage package documents, asking the mux first and rendering the 405 (or the 404) page only when it has no route.</p>
	}
}

templ errorswapSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "errorswap", Title: "Error-swap guard", Description: "Click the button: the server answers a plain-text 500 (a bare http.Error) and the sentence beside the button must not change, because an error body that is not HTML is never swapped into a target."}) {
		@layout.Inline(layout.InlineProps{Wrap: true, Gap: layout.GapS, Align: layout.AlignCenter}) {
			@button.Button(button.Props{Variant: button.VariantOutline, Attributes: templ.Attributes{"hx-get": "/api/boom", "hx-target": "#boom-result", "hx-swap": "innerHTML"}}) {
				Request a plain 500
			}
			<span id="boom-result">Nothing here has changed.</span>
		}
		<p>htmx is configured to swap error responses so a 422 form, a 409 toast and a 404 page reach the user; htmx-errors.js refuses the swap only when the body is not HTML or the target is marked <code>data-wf-swallow-errors</code>, as the shell's live badges are.</p>
		@panel.Panel(panel.Props{ID: "panic", Level: 4, Title: "A handler panic", Subtitle: "Follow the link: the handler panics on purpose, the shell's middleware recovers it, and the styled 500 page renders in the shell with the request id the server log carries; the Back button returns here with nothing changed."}) {
			@action.Button(action.Action{Label: "Panic in a handler", Href: "/api/panic", Variant: action.VariantDestructive})
		}
	}
}

