templ datetimepickerSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "datetimepicker", Title: "Date and time", Description: "Three native controls, one per kind: on a phone each opens the platform's own picker (the wheel sheet on iOS, the dialog on Android) and nothing custom has to fit the screen; the date is capped at the end of 2026 by Max, and the time shows seconds because its Step is 15."}) {
		@panel.Panel(panel.Props{Level: 4, Title: "Date, date and time, time"}) {
			@layout.Stack(layout.StackProps{Gap: layout.GapL}) {
				@layout.Stack(layout.StackProps{Gap: layout.GapS}) {
					@label.Label(label.Props{For: "showcase-date"}) {
						Released
					}
					@datetimepicker.DateTimePicker(datetimepicker.Props{ID: "showcase-date", Name: "released", Kind: datetimepicker.KindDate, Value: showcaseReleased, Max: "2026-12-31"})
				}
				@layout.Stack(layout.StackProps{Gap: layout.GapS}) {
					@label.Label(label.Props{For: "showcase-datetime"}) {
						Build starts
					}
					@datetimepicker.DateTimePicker(datetimepicker.Props{ID: "showcase-datetime", Name: "starts", Kind: datetimepicker.KindDateTime, Value: showcaseReleased.Add(9*time.Hour + 30*time.Minute)})
				}
				@layout.Stack(layout.StackProps{Gap: layout.GapS}) {
					@label.Label(label.Props{For: "showcase-time"}) {
						Quiet hours start
					}
					@datetimepicker.DateTimePicker(datetimepicker.Props{ID: "showcase-time", Name: "quiet", Kind: datetimepicker.KindTime, Value: showcaseReleased.Add(22 * time.Hour), Step: 15})
				}
			}
		}
	}
}

// showcaseReleased is the date the three pickers start from (midnight UTC,
// so the rendered values are deterministic).
var showcaseReleased = time.Date(2026, 9, 12, 0, 0, 0, 0, time.UTC)

