	@layout.Section(layout.SectionProps{Level: 3, ID: "rating", Title: "Rating", Description: "The three read-only rows are announced as \"n of 5\" and cannot be changed; in the input row every star is a 44px target, the arrow keys move the choice once a star has focus, hovering previews a value and the checked one returns when the pointer leaves, and the form would submit stars=n."}) {
