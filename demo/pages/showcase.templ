				}
				@layout.Inline(layout.InlineProps{Gap: layout.GapS, Align: layout.AlignCenter}) {
					@rating.Rating(rating.Props{ID: "showcase-rating-md", ReadOnly: true, Value: 4, Label: "Medium"})
					<small>SizeMd, 4 of 5</small>
				}
				@layout.Inline(layout.InlineProps{Gap: layout.GapS, Align: layout.AlignCenter}) {
					@rating.Rating(rating.Props{ID: "showcase-rating-lg", ReadOnly: true, Value: 5, Size: rating.SizeLg, Label: "Large"})
					<small>SizeLg, 5 of 5</small>
				}
			}
		}
		@panel.Panel(panel.Props{Level: 4, Title: "As an input"}) {
			@rating.Rating(rating.Props{ID: "showcase-rating-input", Name: "stars", Value: 2, Size: rating.SizeLg, Label: "Your rating"})
		}
	}
}

