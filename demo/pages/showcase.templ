package pages

import (
	"github.com/bplus/webframe/components/action"
	"github.com/bplus/webframe/components/aspectratio"
	"github.com/bplus/webframe/components/avatar"
	"github.com/bplus/webframe/components/badge"
	"github.com/bplus/webframe/components/breadcrumbs"
	"github.com/bplus/webframe/components/button"
	"github.com/bplus/webframe/components/card"
	"github.com/bplus/webframe/components/checkbox"
	"github.com/bplus/webframe/components/customblock"
	"github.com/bplus/webframe/components/dialog"
	"github.com/bplus/webframe/components/dropdown"
	"github.com/bplus/webframe/components/form"
	"github.com/bplus/webframe/components/gameicon"
	"github.com/bplus/webframe/components/hovercard"
	"github.com/bplus/webframe/components/icon"
	"github.com/bplus/webframe/components/input"
	"github.com/bplus/webframe/components/label"
	"github.com/bplus/webframe/components/layout"
	"github.com/bplus/webframe/components/pageheader"
	"github.com/bplus/webframe/components/panel"
	"github.com/bplus/webframe/components/popover"
	"github.com/bplus/webframe/components/radio"
	"github.com/bplus/webframe/components/selectbox"
	"github.com/bplus/webframe/components/separator"
	"github.com/bplus/webframe/components/table"
	"github.com/bplus/webframe/components/tabs"
	"github.com/bplus/webframe/components/textarea"
)

// Showcase renders the full component reference page — every webframe
// component demonstrated in labeled sections with a hero and a table of
// contents — so developers can eyeball the library in one scroll and copy
// usage snippets.
//
// It takes no parameters and no children; all content is static demo data
// composed from the unexported per-topic section templates below.
//
// Returns a templ.Component producing the page body only; the document and
// shell are supplied by demo.App.Render.
//
// Rendering is static, but the emitted markup wires live browser behavior:
// Alpine x-data examples, and HTMX demos that POST/GET /api/click,
// /api/search, /api/validate, and /api/toast (handled in demo/handlers.go),
// all relying on the scripts loaded by appshell.Document.
//
// @ai-context served by demo.HandleShowcase at GET /; demo-only, not part of
// the library's importable API
templ Showcase() {
	<!-- Hero -->
	<div class="text-center py-8 mb-8 border-b border-border">
		<h1 class="text-4xl font-bold tracking-tight mb-2">Webframe Components</h1>
		<p class="text-muted-foreground text-lg">
			A reference sheet of templUI components with Tailwind v4, Alpine.js, and HTMX.
		</p>
	</div>
	<!-- Table of Contents -->
	<nav class="mb-12 p-4 rounded-lg bg-card border border-border">
		<h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3">Contents</h2>
		<div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-sm">
			<a href="#typography" class="hover:text-primary transition-colors">Typography</a>
			<a href="#colors" class="hover:text-primary transition-colors">Colors</a>
			<a href="#icons" class="hover:text-primary transition-colors">Icons</a>
			<a href="#buttons" class="hover:text-primary transition-colors">Buttons</a>
			<a href="#badges" class="hover:text-primary transition-colors">Badges</a>
			<a href="#cards" class="hover:text-primary transition-colors">Cards</a>
			<a href="#forms" class="hover:text-primary transition-colors">Form Elements</a>
			<a href="#dialog" class="hover:text-primary transition-colors">Dialog</a>
			<a href="#dropdown" class="hover:text-primary transition-colors">Dropdown</a>
			<a href="#tabs" class="hover:text-primary transition-colors">Tabs</a>
			<a href="#selectbox" class="hover:text-primary transition-colors">Selectbox</a>
			<a href="#popover" class="hover:text-primary transition-colors">Popover</a>
			<a href="#hovercard" class="hover:text-primary transition-colors">Hover Card</a>
			<a href="#avatar" class="hover:text-primary transition-colors">Avatar</a>
			<a href="#separator" class="hover:text-primary transition-colors">Separator</a>
			<a href="#aspectratio" class="hover:text-primary transition-colors">Aspect Ratio</a>
			<a href="#gameicon" class="hover:text-primary transition-colors">Game Icon</a>
			<a href="#alpine" class="hover:text-primary transition-colors">Alpine.js</a>
			<a href="#htmx" class="hover:text-primary transition-colors">HTMX</a>
		</div>
	</nav>
	@typographySection()
	@colorsSection()
	@iconsSection()
	@buttonsSection()
	@badgesSection()
	@cardsSection()
	@formsSection()
	@dialogSection()
	@dropdownSection()
	@tabsSection()
	@selectboxSection()
	@popoverSection()
	@hovercardSection()
	@avatarSection()
	@separatorSection()
	@aspectratioSection()
	@gameiconSection()
	@alpineSection()
	@htmxSection()
	@actionSection()
	@shellSection()
	@layoutSection()
	@panelSection()
	@customSection()
}

// ═══════════════════════════════════════
// Typography
// ═══════════════════════════════════════
templ typographySection() {
	<section id="typography" class="wf-section">
		<h2 class="wf-section-title">Typography</h2>
		<p class="wf-section-desc">Font scale and text styles using Inter.</p>
		<div class="space-y-4">
			<h1 class="text-4xl font-bold tracking-tight">Heading 1 — text-4xl</h1>
			<h2 class="text-3xl font-bold">Heading 2 — text-3xl</h2>
			<h3 class="text-2xl font-semibold">Heading 3 — text-2xl</h3>
			<h4 class="text-xl font-semibold">Heading 4 — text-xl</h4>
			<h5 class="text-lg font-medium">Heading 5 — text-lg</h5>
			<p class="text-base">Body text — text-base. The quick brown fox jumps over the lazy dog.</p>
			<p class="text-sm text-muted-foreground">Small/muted text — text-sm text-muted-foreground.</p>
			<p class="text-xs text-muted-foreground">Extra small — text-xs. Used for labels and captions.</p>
			<code class="wf-code inline text-sm">code — font-mono</code>
		</div>
	</section>
}

// ═══════════════════════════════════════
// Colors
// ═══════════════════════════════════════
templ colorsSection() {
	<section id="colors" class="wf-section">
		<h2 class="wf-section-title">Color Palette</h2>
		<p class="wf-section-desc">CSS custom properties via Tailwind v4 @theme. Swap the palette by editing input.css.</p>
		<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3">Primary</h3>
		<div class="flex gap-3 flex-wrap mb-6">
			<div class="wf-swatch"><div class="wf-swatch-color bg-primary-100"></div><span class="wf-swatch-label">100</span></div>
			<div class="wf-swatch"><div class="wf-swatch-color bg-primary-300"></div><span class="wf-swatch-label">300</span></div>
			<div class="wf-swatch"><div class="wf-swatch-color bg-primary-500"></div><span class="wf-swatch-label">500</span></div>
			<div class="wf-swatch"><div class="wf-swatch-color bg-primary-600"></div><span class="wf-swatch-label">600</span></div>
			<div class="wf-swatch"><div class="wf-swatch-color bg-primary-700"></div><span class="wf-swatch-label">700</span></div>
			<div class="wf-swatch"><div class="wf-swatch-color bg-primary-900"></div><span class="wf-swatch-label">900</span></div>
		</div>
		<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3">Accent</h3>
		<div class="flex gap-3 flex-wrap mb-6">
			<div class="wf-swatch"><div class="wf-swatch-color bg-accent-100"></div><span class="wf-swatch-label">100</span></div>
			<div class="wf-swatch"><div class="wf-swatch-color bg-accent-300"></div><span class="wf-swatch-label">300</span></div>
			<div class="wf-swatch"><div class="wf-swatch-color bg-accent-500"></div><span class="wf-swatch-label">500</span></div>
			<div class="wf-swatch"><div class="wf-swatch-color bg-accent-700"></div><span class="wf-swatch-label">700</span></div>
			<div class="wf-swatch"><div class="wf-swatch-color bg-accent-900"></div><span class="wf-swatch-label">900</span></div>
		</div>
		<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3">Semantic</h3>
		<div class="flex gap-3 flex-wrap">
			<div class="wf-swatch"><div class="wf-swatch-color bg-background border"></div><span class="wf-swatch-label">bg</span></div>
			<div class="wf-swatch"><div class="wf-swatch-color bg-card border"></div><span class="wf-swatch-label">card</span></div>
			<div class="wf-swatch"><div class="wf-swatch-color bg-muted"></div><span class="wf-swatch-label">muted</span></div>
			<div class="wf-swatch"><div class="wf-swatch-color bg-primary"></div><span class="wf-swatch-label">primary</span></div>
			<div class="wf-swatch"><div class="wf-swatch-color bg-secondary"></div><span class="wf-swatch-label">secondary</span></div>
			<div class="wf-swatch"><div class="wf-swatch-color bg-destructive"></div><span class="wf-swatch-label">destructive</span></div>
		</div>
	</section>
}

// ═══════════════════════════════════════
// Icons
// ═══════════════════════════════════════
templ iconsSection() {
	<section id="icons" class="wf-section">
		<h2 class="wf-section-title">Icons (Lucide)</h2>
		<p class="wf-section-desc">~600 Lucide icons available as Go variables. Used internally by button, input, dialog, checkbox.</p>
		<div class="wf-demo-row mb-6">
			<div class="flex flex-col items-center gap-1">
				<div class="p-2 rounded-md border border-border">@icon.Check()
</div>
				<span class="text-xs text-muted-foreground">Check</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				<div class="p-2 rounded-md border border-border">@icon.X()
</div>
				<span class="text-xs text-muted-foreground">X</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				<div class="p-2 rounded-md border border-border">@icon.ChevronDown()
</div>
				<span class="text-xs text-muted-foreground">ChevronDown</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				<div class="p-2 rounded-md border border-border">@icon.Search()
</div>
				<span class="text-xs text-muted-foreground">Search</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				<div class="p-2 rounded-md border border-border">@icon.Plus()
</div>
				<span class="text-xs text-muted-foreground">Plus</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				<div class="p-2 rounded-md border border-border">@icon.Minus()
</div>
				<span class="text-xs text-muted-foreground">Minus</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				<div class="p-2 rounded-md border border-border">@icon.Eye()
</div>
				<span class="text-xs text-muted-foreground">Eye</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				<div class="p-2 rounded-md border border-border">@icon.EyeOff()
</div>
				<span class="text-xs text-muted-foreground">EyeOff</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				<div class="p-2 rounded-md border border-border">@icon.Settings()
</div>
				<span class="text-xs text-muted-foreground">Settings</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				<div class="p-2 rounded-md border border-border">@icon.Trash2()
</div>
				<span class="text-xs text-muted-foreground">Trash2</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				<div class="p-2 rounded-md border border-border">@icon.Copy()
</div>
				<span class="text-xs text-muted-foreground">Copy</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				<div class="p-2 rounded-md border border-border">@icon.Download()
</div>
				<span class="text-xs text-muted-foreground">Download</span>
			</div>
		</div>
		<div class="wf-code text-xs">
			<code>{ `@icon.Check()  // renders inline SVG, cached in-process` }</code>
		</div>
	</section>
}

// ═══════════════════════════════════════
// Buttons
// ═══════════════════════════════════════
templ buttonsSection() {
	<section id="buttons" class="wf-section">
		<h2 class="wf-section-title">Buttons</h2>
		<p class="wf-section-desc">All button variants and sizes from the button component.</p>
		<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3">Variants</h3>
		<div class="wf-demo-row mb-6">
			@button.Button(button.Props{}) {
				Default 
			}
			@button.Button(button.Props{Variant: button.VariantDestructive}) {
				Destructive 
			}
			@button.Button(button.Props{Variant: button.VariantOutline}) {
				Outline 
			}
			@button.Button(button.Props{Variant: button.VariantSecondary}) {
				Secondary 
			}
			@button.Button(button.Props{Variant: button.VariantGhost}) {
				Ghost 
			}
			@button.Button(button.Props{Variant: button.VariantLink}) {
				Link 
			}
		</div>
		<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3">Sizes</h3>
		<div class="wf-demo-row mb-6">
			@button.Button(button.Props{Size: button.SizeSm}) {
				Small 
			}
			@button.Button(button.Props{}) {
				Default 
			}
			@button.Button(button.Props{Size: button.SizeLg}) {
				Large 
			}
			@button.Button(button.Props{Size: button.SizeIcon}) {
				+ 
			}
		</div>
		<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3">States</h3>
		<div class="wf-demo-row mb-6">
			@button.Button(button.Props{}) {
				Enabled 
			}
			@button.Button(button.Props{Disabled: true}) {
				Disabled 
			}
			@button.Button(button.Props{FullWidth: true}) {
				Full Width 
			}
		</div>
		<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3">As Link</h3>
		<div class="wf-demo-row">
			@button.Button(button.Props{Href: "#buttons"}) {
				Link Button 
			}
			@button.Button(button.Props{Href: "#buttons", Variant: button.VariantOutline}) {
				Outline Link 
			}
		</div>
	</section>
}

// ═══════════════════════════════════════
// Badges
// ═══════════════════════════════════════
templ badgesSection() {
	<section id="badges" class="wf-section">
		<h2 class="wf-section-title">Badges</h2>
		<p class="wf-section-desc">Inline label variants.</p>
		<div class="wf-demo-row">
			@badge.Badge(badge.Props{}) {
				Default 
			}
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				Secondary 
			}
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
				Destructive 
			}
			@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
				Outline 
			}
		</div>
	</section>
}

// ═══════════════════════════════════════
// Cards
// ═══════════════════════════════════════
templ cardsSection() {
	<section id="cards" class="wf-section">
		<h2 class="wf-section-title">Cards</h2>
		<p class="wf-section-desc">Composable card components: Card, Header, Title, Description, Content, Footer.</p>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<!-- Basic card -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Basic Card 
					}
					@card.Description() {
						A simple card with header and content. 
					}
				}
				@card.Content() {
					<p class="text-sm">Card body content goes here. This is a versatile container for any grouped content.</p>
				}
			}
			<!-- Card with footer -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Card with Footer 
					}
					@card.Description() {
						Includes action buttons in the footer. 
					}
				}
				@card.Content() {
					<p class="text-sm">Some content that needs actions below it.</p>
				}
				@card.Footer() {
					<div class="flex gap-2">
						@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
							Cancel 
						}
						@button.Button(button.Props{Size: button.SizeSm}) {
							Save 
						}
					</div>
				}
			}
			<!-- Card as form -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Login 
					}
					@card.Description() {
						Enter your credentials below. 
					}
				}
				@card.Content() {
					<div class="space-y-4">
						<div>
							@label.Label(label.Props{}) {
								Email 
							}
							@input.Input(input.Props{Type: input.TypeEmail, Placeholder: "you@example.com"})
						</div>
						<div>
							@label.Label(label.Props{}) {
								Password 
							}
							@input.Input(input.Props{Type: input.TypePassword, Placeholder: "••••••••"})
						</div>
					</div>
				}
				@card.Footer() {
					@button.Button(button.Props{FullWidth: true}) {
						Sign In 
					}
				}
			}
			<!-- Minimal card -->
			@card.Card() {
				@card.Content() {
					<p class="text-sm text-muted-foreground">A card with only content — no header or footer. Good for simple containers.</p>
				}
			}
		</div>
	</section>
}

// ═══════════════════════════════════════
// Form Elements
// ═══════════════════════════════════════
templ formsSection() {
	<section id="forms" class="wf-section">
		<h2 class="wf-section-title">Form Elements</h2>
		<p class="wf-section-desc">Input, Textarea, Checkbox, Radio, Label, and Form layout components.</p>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			<!-- Text inputs -->
			<div class="space-y-4">
				<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Text Inputs</h3>
				@form.Item() {
					@form.Label() {
						Default Input 
					}
					@input.Input(input.Props{Placeholder: "Type something..."})
					@form.Description() {
						A standard text input. 
					}
				}
				@form.Item() {
					@form.Label() {
						Email 
					}
					@input.Input(input.Props{Type: input.TypeEmail, Placeholder: "you@example.com"})
				}
				@form.Item() {
					@form.Label() {
						Password (with toggle) 
					}
					@input.Input(input.Props{Type: input.TypePassword, Placeholder: "••••••••"})
				}
				@form.Item() {
					@form.Label() {
						Disabled 
					}
					@input.Input(input.Props{Disabled: true, Placeholder: "Cannot edit"})
				}
				@form.Item() {
					@form.Label() {
						With Error 
					}
					@input.Input(input.Props{HasError: true, Placeholder: "Invalid value"})
					@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
						This field is required 
					}
				}
			</div>
			<!-- Textarea + checks -->
			<div class="space-y-4">
				<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Textarea</h3>
				@form.Item() {
					@form.Label() {
						Description 
					}
					@textarea.Textarea(textarea.Props{Placeholder: "Write a description...", Rows: 3})
				}
				@form.Item() {
					@form.Label() {
						Auto-resize 
					}
					@textarea.Textarea(textarea.Props{Placeholder: "This textarea grows as you type...", Rows: 2, AutoResize: true})
				}
				<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mt-6">Checkbox</h3>
				<div class="space-y-3">
					<label class="flex items-center gap-2 text-sm">
						@checkbox.Checkbox(checkbox.Props{Name: "terms"})
						Accept terms and conditions
					</label>
					<label class="flex items-center gap-2 text-sm">
						@checkbox.Checkbox(checkbox.Props{Name: "newsletter", Checked: true})
						Subscribe to newsletter
					</label>
					<label class="flex items-center gap-2 text-sm">
						@checkbox.Checkbox(checkbox.Props{Name: "disabled-cb", Disabled: true})
						Disabled option
					</label>
				</div>
				<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mt-6">Radio</h3>
				<div class="space-y-3">
					<label class="flex items-center gap-2 text-sm">
						@radio.Radio(radio.Props{Name: "plan", Value: "free"})
						Free
					</label>
					<label class="flex items-center gap-2 text-sm">
						@radio.Radio(radio.Props{Name: "plan", Value: "pro", Checked: true})
						Pro
					</label>
					<label class="flex items-center gap-2 text-sm">
						@radio.Radio(radio.Props{Name: "plan", Value: "enterprise"})
						Enterprise
					</label>
				</div>
			</div>
		</div>
		<!-- Form layout demo -->
		<div class="mt-8">
			<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-4">Form Layout (Item + ItemFlex)</h3>
			@card.Card() {
				@card.Content() {
					<div class="space-y-4">
						@form.ItemFlex() {
							<div class="flex-1">
								@form.Label() {
									Full Name 
								}
								@form.Description() {
									Your display name. 
								}
							</div>
							@input.Input(input.Props{Placeholder: "Jane Smith", Class: "max-w-xs"})
						}
						@form.ItemFlex() {
							<div class="flex-1">
								@form.Label() {
									Notifications 
								}
								@form.Description() {
									Receive email notifications. 
								}
							</div>
							@checkbox.Checkbox(checkbox.Props{Name: "notifications"})
						}
					</div>
				}
			}
		</div>
	</section>
}

// ═══════════════════════════════════════
// Dialog
// ═══════════════════════════════════════
templ dialogSection() {
	<section id="dialog" class="wf-section">
		<h2 class="wf-section-title">Dialog</h2>
		<p class="wf-section-desc">Modal dialogs with trigger, content, header, footer.</p>
		<div class="wf-demo-row">
			@dialog.Dialog() {
				@dialog.Trigger() {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						Open Dialog 
					}
				}
				@dialog.Content() {
					@dialog.Header() {
						@dialog.Title() {
							Confirm Action 
						}
						@dialog.Description() {
							Are you sure you want to proceed? This action cannot be undone. 
						}
					}
					@dialog.Footer() {
						@dialog.Close() {
							@button.Button(button.Props{Variant: button.VariantOutline}) {
								Cancel 
							}
						}
						@dialog.Close() {
							@button.Button(button.Props{}) {
								Confirm 
							}
						}
					}
				}
			}
			@dialog.Dialog() {
				@dialog.Trigger() {
					@button.Button(button.Props{}) {
						Form Dialog 
					}
				}
				@dialog.Content() {
					@dialog.Header() {
						@dialog.Title() {
							Edit Profile 
						}
						@dialog.Description() {
							Update your profile information below. 
						}
					}
					<div class="space-y-4 py-4">
						@form.Item() {
							@form.Label() {
								Name 
							}
							@input.Input(input.Props{Placeholder: "Your name"})
						}
						@form.Item() {
							@form.Label() {
								Bio 
							}
							@textarea.Textarea(textarea.Props{Placeholder: "Tell us about yourself...", Rows: 3})
						}
					</div>
					@dialog.Footer() {
						@dialog.Close() {
							@button.Button(button.Props{Variant: button.VariantOutline}) {
								Cancel 
							}
						}
						@button.Button(button.Props{}) {
							Save Changes 
						}
					}
				}
			}
		</div>
	</section>
}

// ═══════════════════════════════════════
// Dropdown
// ═══════════════════════════════════════
templ dropdownSection() {
	<section id="dropdown" class="wf-section">
		<h2 class="wf-section-title">Dropdown Menu</h2>
		<p class="wf-section-desc">Click-triggered dropdown with items, groups, separators, and sub-menus.</p>
		<div class="wf-demo-row">
			@dropdown.Dropdown() {
				@dropdown.Trigger() {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						Open Menu 
					}
				}
				@dropdown.Content() {
					@dropdown.Label() {
						My Account 
					}
					@dropdown.Separator()
					@dropdown.Item(dropdown.ItemProps{Href: "#dropdown"}) {
						Profile 
					}
					@dropdown.Item(dropdown.ItemProps{Href: "#dropdown"}) {
						Settings 
					}
					@dropdown.Item(dropdown.ItemProps{Href: "#dropdown"}) {
						Keyboard Shortcuts
						@dropdown.Shortcut() {
							⌘K 
						}
					}
					@dropdown.Separator()
					@dropdown.Sub() {
						@dropdown.SubTrigger() {
							More Options 
						}
						@dropdown.SubContent() {
							@dropdown.Item(dropdown.ItemProps{Href: "#dropdown"}) {
								Import 
							}
							@dropdown.Item(dropdown.ItemProps{Href: "#dropdown"}) {
								Export 
							}
						}
					}
					@dropdown.Separator()
					@dropdown.Item(dropdown.ItemProps{Href: "#dropdown"}) {
						Log Out 
					}
				}
			}
		</div>
	</section>
}

// ═══════════════════════════════════════
// Tabs
// ═══════════════════════════════════════
templ tabsSection() {
	<section id="tabs" class="wf-section">
		<h2 class="wf-section-title">Tabs</h2>
		<p class="wf-section-desc">Tab navigation with content panels.</p>
		@tabs.Tabs() {
			@tabs.List() {
				@tabs.Trigger(tabs.TriggerProps{Value: "overview", IsActive: true}) {
					Overview 
				}
				@tabs.Trigger(tabs.TriggerProps{Value: "features"}) {
					Features 
				}
				@tabs.Trigger(tabs.TriggerProps{Value: "code"}) {
					Code 
				}
			}
			@tabs.Content(tabs.ContentProps{Value: "overview", IsActive: true}) {
				@card.Card() {
					@card.Content() {
						<p class="text-sm">This is the overview tab. Content switches without a page reload.</p>
					}
				}
			}
			@tabs.Content(tabs.ContentProps{Value: "features"}) {
				@card.Card() {
					@card.Content() {
						<ul class="text-sm space-y-1 list-disc list-inside">
							<li>Keyboard accessible (arrow keys)</li>
							<li>JavaScript-driven show/hide</li>
							<li>Works with HTMX for lazy loading</li>
						</ul>
					}
				}
			}
			@tabs.Content(tabs.ContentProps{Value: "code"}) {
				@card.Card() {
					@card.Content() {
						<pre class="wf-code">
							{ `@tabs.Tabs() {
  @tabs.List() {
    @tabs.Trigger(tabs.TriggerProps{Value: "tab1", IsActive: true}) { Tab 1 }
  }
  @tabs.Content(tabs.ContentProps{Value: "tab1"}) { Content }
}` }
						</pre>
					}
				}
			}
		}
	</section>
}

// ═══════════════════════════════════════
// Selectbox
// ═══════════════════════════════════════
templ selectboxSection() {
	<section id="selectbox" class="wf-section">
		<h2 class="wf-section-title">Selectbox</h2>
		<p class="wf-section-desc">Custom select with search, groups, and multi-select.</p>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3">Basic</h3>
				@selectbox.SelectBox() {
					@selectbox.Trigger(selectbox.TriggerProps{Name: "framework"}) {
						@selectbox.Value(selectbox.ValueProps{Placeholder: "Select a framework..."})
					}
					@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
						@selectbox.Group() {
							@selectbox.Label() {
								Frontend 
							}
							@selectbox.Item(selectbox.ItemProps{Value: "react"}) {
								React 
							}
							@selectbox.Item(selectbox.ItemProps{Value: "vue"}) {
								Vue 
							}
							@selectbox.Item(selectbox.ItemProps{Value: "svelte"}) {
								Svelte 
							}
						}
						@selectbox.Group() {
							@selectbox.Label() {
								Backend 
							}
							@selectbox.Item(selectbox.ItemProps{Value: "go"}) {
								Go 
							}
							@selectbox.Item(selectbox.ItemProps{Value: "python"}) {
								Python 
							}
							@selectbox.Item(selectbox.ItemProps{Value: "rust"}) {
								Rust 
							}
						}
					}
				}
			</div>
			<div>
				<h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3">With Search</h3>
				@selectbox.SelectBox() {
					@selectbox.Trigger(selectbox.TriggerProps{Name: "language"}) {
						@selectbox.Value(selectbox.ValueProps{Placeholder: "Search languages..."})
					}
					@selectbox.Content() {
						@selectbox.Item(selectbox.ItemProps{Value: "go"}) {
							Go 
						}
						@selectbox.Item(selectbox.ItemProps{Value: "rust"}) {
							Rust 
						}
						@selectbox.Item(selectbox.ItemProps{Value: "python"}) {
							Python 
						}
						@selectbox.Item(selectbox.ItemProps{Value: "typescript"}) {
							TypeScript 
						}
						@selectbox.Item(selectbox.ItemProps{Value: "java"}) {
							Java 
						}
						@selectbox.Item(selectbox.ItemProps{Value: "csharp"}) {
							C# 
						}
					}
				}
			</div>
		</div>
	</section>
}

// ═══════════════════════════════════════
// Popover
// ═══════════════════════════════════════
templ popoverSection() {
	<section id="popover" class="wf-section">
		<h2 class="wf-section-title">Popover</h2>
		<p class="wf-section-desc">Positioning primitive used by dropdown, selectbox, and hovercard. Click or hover triggers with configurable placement.</p>
		<div class="wf-demo-row">
			<!-- Click popover -->
			<div>
				@popover.Trigger(popover.TriggerProps{For: "pop-click"}) {
					@button.Button(button.Props{Variant: button.VariantOutline}) {
						Click Popover 
					}
				}
				@popover.Content(popover.ContentProps{ID: "pop-click", Placement: popover.PlacementBottom, ShowArrow: true}) {
					<div class="p-4 max-w-xs">
						<h4 class="font-semibold text-sm mb-1">Click-triggered Popover</h4>
						<p class="text-xs text-muted-foreground">This popover opens on click and positions itself below the trigger with an arrow.</p>
					</div>
				}
			</div>
			<!-- Hover popover -->
			<div>
				@popover.Trigger(popover.TriggerProps{For: "pop-hover", TriggerType: popover.TriggerTypeHover}) {
					@button.Button(button.Props{Variant: button.VariantSecondary}) {
						Hover Popover 
					}
				}
				@popover.Content(popover.ContentProps{
					ID:            "pop-hover",
					Placement:     popover.PlacementTop,
					ShowArrow:     true,
					HoverDelay:    200,
					HoverOutDelay: 150,
				}) {
					<div class="p-4 max-w-xs">
						<h4 class="font-semibold text-sm mb-1">Hover-triggered</h4>
						<p class="text-xs text-muted-foreground">200ms delay before show, 150ms before hide. Configurable via HoverDelay/HoverOutDelay.</p>
					</div>
				}
			</div>
			<!-- Right placement -->
			<div>
				@popover.Trigger(popover.TriggerProps{For: "pop-right"}) {
					@button.Button(button.Props{Variant: button.VariantGhost}) {
						Right Side 
					}
				}
				@popover.Content(popover.ContentProps{ID: "pop-right", Placement: popover.PlacementRight, ShowArrow: true}) {
					<div class="p-4">
						<p class="text-xs text-muted-foreground">Placement: Right</p>
					</div>
				}
			</div>
		</div>
	</section>
}

// ═══════════════════════════════════════
// Hover Card
// ═══════════════════════════════════════
templ hovercardSection() {
	<section id="hovercard" class="wf-section">
		<h2 class="wf-section-title">Hover Card</h2>
		<p class="wf-section-desc">Rich popover on hover — shows title, metadata, description, and optional icon. Built on popover + gameicon.</p>
		<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
			<!-- Product hover card -->
			@hovercard.Hover(hovercard.Props{
				ID:          "hc-product",
				Title:       "Flame Tongue Greatsword",
				Category:    "Weapon · Very Rare",
				Description: "A legendary blade wreathed in magical fire that deals extra damage to enemies.",
				Meta: []hovercard.MetaRow{
					{Label: "Damage", Value: "2d6 + 1d6 Fire"},
					{Label: "Weight", Value: "6 lb"},
					{Label: "Properties", Value: "Heavy, Two-Handed"},
				},
				IconName: "broadsword",
				Link:     "#hovercard",
			}) {
				@card.Card() {
					@card.Content() {
						<p class="text-sm font-medium">Hover me — Product Card</p>
						<p class="text-xs text-muted-foreground">Shows item details with metadata rows and icon</p>
					}
				}
			}
			<!-- User profile hover card -->
			@hovercard.Hover(hovercard.Props{
				ID:          "hc-user",
				Title:       "Jane Developer",
				Category:    "Team Lead",
				Description: "Full-stack engineer focused on Go, React, and distributed systems.",
				Meta: []hovercard.MetaRow{
					{Label: "Location", Value: "San Francisco"},
					{Label: "Projects", Value: "12 active"},
					{Label: "Joined", Value: "March 2023"},
				},
				Link:     "#hovercard",
				LinkText: "View full profile →",
			}) {
				@card.Card() {
					@card.Content() {
						<p class="text-sm font-medium">Hover me — User Profile</p>
						<p class="text-xs text-muted-foreground">No icon panel — text-only hover card</p>
					}
				}
			}
			<!-- Minimal hover card -->
			@hovercard.Hover(hovercard.Props{
				ID:          "hc-minimal",
				Title:       "Quick Tooltip",
				Description: "A minimal hover card with just a title and description. No metadata, no icon, no link.",
			}) {
				@card.Card() {
					@card.Content() {
						<p class="text-sm font-medium">Hover me — Minimal</p>
						<p class="text-xs text-muted-foreground">Title + description only</p>
					}
				}
			}
		</div>
	</section>
}

// ═══════════════════════════════════════
// Avatar
// ═══════════════════════════════════════
templ avatarSection() {
	<section id="avatar" class="wf-section">
		<h2 class="wf-section-title">Avatar</h2>
		<p class="wf-section-desc">Circular avatar with image and text fallback.</p>
		<div class="wf-demo-row">
			@avatar.Avatar() {
				@avatar.Image(avatar.ImageProps{Src: "https://i.pravatar.cc/150?img=1", Alt: "User"})
				@avatar.Fallback() {
					JD 
				}
			}
			@avatar.Avatar() {
				@avatar.Image(avatar.ImageProps{Src: "https://i.pravatar.cc/150?img=5", Alt: "User"})
				@avatar.Fallback() {
					AK 
				}
			}
			@avatar.Avatar() {
				@avatar.Fallback() {
					WF 
				}
			}
			@avatar.Avatar(avatar.Props{Class: "h-16 w-16"}) {
				@avatar.Image(avatar.ImageProps{Src: "https://i.pravatar.cc/150?img=12", Alt: "User"})
				@avatar.Fallback() {
					LG 
				}
			}
		</div>
	</section>
}

// ═══════════════════════════════════════
// Separator
// ═══════════════════════════════════════
templ separatorSection() {
	<section id="separator" class="wf-section">
		<h2 class="wf-section-title">Separator</h2>
		<p class="wf-section-desc">Horizontal and vertical dividers.</p>
		<div class="space-y-4">
			<p class="text-sm">Content above the separator.</p>
			@separator.Separator()
			<p class="text-sm">Content below the separator.</p>
			@separator.Separator(separator.Props{Decoration: separator.DecorationDashed})
			@separator.Separator() {
				<span class="text-xs text-muted-foreground px-2">OR</span>
			}
			<div class="flex items-center gap-4 h-8">
				<span class="text-sm">Left</span>
				@separator.Separator(separator.Props{Orientation: separator.OrientationVertical})
				<span class="text-sm">Center</span>
				@separator.Separator(separator.Props{Orientation: separator.OrientationVertical})
				<span class="text-sm">Right</span>
			</div>
		</div>
	</section>
}

// ═══════════════════════════════════════
// Aspect Ratio
// ═══════════════════════════════════════
templ aspectratioSection() {
	<section id="aspectratio" class="wf-section">
		<h2 class="wf-section-title">Aspect Ratio</h2>
		<p class="wf-section-desc">Container that maintains a fixed aspect ratio. Useful for images, videos, maps.</p>
		<div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
			<div>
				<p class="text-xs font-semibold uppercase text-muted-foreground mb-2">16:9 (Video)</p>
				@aspectratio.AspectRatio(aspectratio.Props{Ratio: aspectratio.RatioVideo}) {
					<div class="w-full h-full rounded-md bg-muted flex items-center justify-center text-muted-foreground text-sm">
						16:9
					</div>
				}
			</div>
			<div>
				<p class="text-xs font-semibold uppercase text-muted-foreground mb-2">3:4 (Portrait)</p>
				@aspectratio.AspectRatio(aspectratio.Props{Ratio: aspectratio.RatioPortrait}) {
					<div class="w-full h-full rounded-md bg-muted flex items-center justify-center text-muted-foreground text-sm">
						3:4
					</div>
				}
			</div>
			<div>
				<p class="text-xs font-semibold uppercase text-muted-foreground mb-2">1:1 (Square)</p>
				@aspectratio.AspectRatio(aspectratio.Props{Ratio: aspectratio.RatioSquare}) {
					<div class="w-full h-full rounded-md bg-muted flex items-center justify-center text-muted-foreground text-sm">
						1:1
					</div>
				}
			</div>
		</div>
	</section>
}

// ═══════════════════════════════════════
// Game Icon
// ═══════════════════════════════════════
templ gameiconSection() {
	<section id="gameicon" class="wf-section">
		<h2 class="wf-section-title">Game Icon (SVG Sprite)</h2>
		<p class="wf-section-desc">SVG sprite wrapper — references icons by name from /static/icons/game-icons.svg. Source: game-icons.net (CC BY 3.0). Swap the sprite file for your own icon set.</p>
		<div class="wf-demo-row">
			<div class="flex flex-col items-center gap-1">
				@gameicon.GameIcon(gameicon.Props{Name: "broadsword", Class: "w-10 h-10 text-foreground"})
				<span class="text-xs text-muted-foreground">broadsword</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				@gameicon.GameIcon(gameicon.Props{Name: "armor-vest", Class: "w-10 h-10 text-foreground"})
				<span class="text-xs text-muted-foreground">armor-vest</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				@gameicon.GameIcon(gameicon.Props{Name: "gem-pendant", Class: "w-10 h-10 text-foreground"})
				<span class="text-xs text-muted-foreground">gem-pendant</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				@gameicon.GameIcon(gameicon.Props{Name: "ring", Class: "w-10 h-10 text-foreground"})
				<span class="text-xs text-muted-foreground">ring</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				@gameicon.GameIcon(gameicon.Props{Name: "cloak-dagger", Class: "w-10 h-10 text-foreground"})
				<span class="text-xs text-muted-foreground">cloak-dagger</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				@gameicon.GameIcon(gameicon.Props{Name: "shield", Class: "w-10 h-10 text-foreground"})
				<span class="text-xs text-muted-foreground">shield</span>
			</div>
			<div class="flex flex-col items-center gap-1">
				@gameicon.GameIcon(gameicon.Props{Name: "swords-emblem", Class: "w-10 h-10 text-primary"})
				<span class="text-xs text-muted-foreground">swords-emblem <span class="text-primary-500">(tinted)</span></span>
			</div>
			<div class="flex flex-col items-center gap-1">
				@gameicon.GameIcon(gameicon.Props{Name: "bottled-bolt", Class: "w-10 h-10 text-accent-500"})
				<span class="text-xs text-muted-foreground">bottled-bolt <span class="text-accent-500">(tinted)</span></span>
			</div>
		</div>
		<div class="wf-code text-xs mt-4">
			<code>{ `@gameicon.GameIcon(gameicon.Props{Name: "broadsword", Class: "w-10 h-10 text-foreground"})` }</code>
		</div>
	</section>
}

// ═══════════════════════════════════════
// Alpine.js Patterns
// ═══════════════════════════════════════
templ alpineSection() {
	<section id="alpine" class="wf-section">
		<h2 class="wf-section-title">Alpine.js Patterns</h2>
		<p class="wf-section-desc">Common Alpine.js patterns used with these components.</p>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<!-- Toggle visibility -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Toggle (x-show) 
					}
				}
				@card.Content() {
					<div x-data="{ open: false }">
						@button.Button(button.Props{
							Attributes: templ.Attributes{"@click": "open = !open"},
							Size:       button.SizeSm,
						}) {
							Toggle Content 
						}
						<div x-show="open" x-transition x-cloak class="mt-3 p-3 rounded-md bg-muted text-sm">
							This content is toggled with <code class="font-mono text-xs">x-show</code> and <code class="font-mono text-xs">x-transition</code>.
						</div>
					</div>
				}
			}
			<!-- Counter with x-data -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Reactive State (x-data) 
					}
				}
				@card.Content() {
					<div x-data="{ count: 0 }" class="flex items-center gap-4">
						<button @click="count--" class="inline-flex items-center justify-center rounded-md border border-input bg-background h-8 w-8 text-sm hover:bg-accent transition-colors">-</button>
						<span x-text="count" class="text-2xl font-bold tabular-nums w-12 text-center">0</span>
						<button @click="count++" class="inline-flex items-center justify-center rounded-md border border-input bg-background h-8 w-8 text-sm hover:bg-accent transition-colors">+</button>
					</div>
				}
			}
			<!-- Two-way binding -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Two-way Binding (x-model) 
					}
				}
				@card.Content() {
					<div x-data="{ name: '' }">
						@input.Input(input.Props{
							Placeholder: "Type your name...",
							Attributes:  templ.Attributes{"x-model": "name"},
						})
						<p class="mt-2 text-sm text-muted-foreground">
							Hello, <span x-text="name || 'stranger'" class="font-medium text-foreground"></span>!
						</p>
					</div>
				}
			}
			<!-- Dropdown with click.outside -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Click Outside (@@click.outside) 
					}
				}
				@card.Content() {
					<div x-data="{ open: false }" class="relative">
						<button @click="open = !open" class="inline-flex items-center justify-center rounded-md border border-input bg-background px-3 py-1.5 text-sm hover:bg-accent transition-colors">
							<span x-text="open ? 'Close' : 'Open'">Open</span> Panel
						</button>
						<div
							x-show="open"
							x-transition
							@click.outside="open = false"
							x-cloak
							class="absolute top-full mt-2 p-4 rounded-md border border-border bg-popover shadow-lg text-sm z-10"
						>
							Click outside this panel to close it.
						</div>
					</div>
				}
			}
		</div>
	</section>
}

// ═══════════════════════════════════════
// HTMX Patterns
// ═══════════════════════════════════════
templ htmxSection() {
	<section id="htmx" class="wf-section">
		<h2 class="wf-section-title">HTMX Patterns</h2>
		<p class="wf-section-desc">Common HTMX patterns: click-to-load, live search, validation, out-of-band swaps.</p>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<!-- Click counter -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Click to Update (hx-post + hx-swap) 
					}
				}
				@card.Content() {
					<p class="text-sm text-muted-foreground mb-3">Button replaces itself with server response.</p>
					<button
						hx-post="/api/click"
						hx-swap="outerHTML"
						hx-vals='{"count":"0"}'
						class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-colors"
					>
						Click me
					</button>
				}
			}
			<!-- Live search -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Live Search (hx-get + debounce) 
					}
				}
				@card.Content() {
					<input
						type="search"
						name="q"
						hx-get="/api/search"
						hx-trigger="input changed delay:300ms, search"
						hx-target="#search-results"
						placeholder="Search frameworks..."
						class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
					/>
					<div id="search-results" class="mt-3 max-h-48 overflow-y-auto rounded-md border border-border">
						<ul class="space-y-1 p-1">
							<li class="px-3 py-2 text-sm text-muted-foreground">Type to search...</li>
						</ul>
					</div>
				}
			}
			<!-- Field validation on blur -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Blur Validation (hx-post + hx-trigger="blur") 
					}
				}
				@card.Content() {
					<div class="space-y-4">
						<div>
							@label.Label(label.Props{}) {
								Email 
							}
							<input
								type="email"
								name="value"
								hx-post="/api/validate"
								hx-trigger="blur"
								hx-target="#email-feedback"
								hx-vals='{"field":"email"}'
								placeholder="you@example.com"
								class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
							/>
							<div id="email-feedback"></div>
						</div>
						<div>
							@label.Label(label.Props{}) {
								Name 
							}
							<input
								type="text"
								name="value"
								hx-post="/api/validate"
								hx-trigger="blur"
								hx-target="#name-feedback"
								hx-vals='{"field":"name"}'
								placeholder="Your name"
								class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
							/>
							<div id="name-feedback"></div>
						</div>
					</div>
				}
			}
			<!-- Toast via OOB swap -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Toast (hx-swap-oob) 
					}
				}
				@card.Content() {
					<p class="text-sm text-muted-foreground mb-3">Server responds with out-of-band HTML injected into #toast-container.</p>
					<div class="flex gap-2 flex-wrap">
						<button
							hx-post="/api/toast"
							hx-vals='{"variant":"success"}'
							hx-swap="none"
							class="inline-flex items-center justify-center rounded-md bg-emerald-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-emerald-700 transition-colors"
						>
							Success
						</button>
						<button
							hx-post="/api/toast"
							hx-vals='{"variant":"error"}'
							hx-swap="none"
							class="inline-flex items-center justify-center rounded-md bg-destructive px-3 py-1.5 text-xs font-medium text-white hover:bg-destructive/90 transition-colors"
						>
							Error
						</button>
						<button
							hx-post="/api/toast"
							hx-vals='{"variant":"info"}'
							hx-swap="none"
							class="inline-flex items-center justify-center rounded-md bg-primary px-3 py-1.5 text-xs font-medium text-white hover:bg-primary/90 transition-colors"
						>
							Info
						</button>
						<button
							hx-post="/api/toast"
							hx-vals='{"variant":"warning"}'
							hx-swap="none"
							class="inline-flex items-center justify-center rounded-md bg-amber-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-amber-700 transition-colors"
						>
							Warning
						</button>
					</div>
				}
			}
		</div>
	</section>
}

// ═══════════════════════════════════════
// Page-layer components: actions, shell, layout, panel, fences
// ═══════════════════════════════════════

templ actionSection() {
	@layout.Section(layout.SectionProps{ID: "actions", Title: "Actions", Description: "One action model rendered as a button or link, with variants, confirmation and HTMX wiring."}) {
		@action.Group([]action.Action{
			{Label: "Save", Variant: action.VariantPrimary},
			{Label: "Cancel", Variant: action.VariantSecondary},
			{Label: "Delete", Variant: action.VariantDestructive, Confirm: &action.Confirm{Message: "Delete the thing?"}},
			{Label: "Skip", Variant: action.VariantGhost},
		})
		@action.Group([]action.Action{
			{Label: "Open docs", Href: "/#shell"},
			{Label: "Post to server", HxPost: "/api/click", HxTarget: "#click-result"},
		})
		<span id="click-result"></span>
	}
}

templ shellSection() {
	@layout.Section(layout.SectionProps{ID: "shell", Title: "Shell and page header", Description: "The application frame, breadcrumbs and the page header."}) {
		@panel.Panel(panel.Props{Title: "The frame around this page"}) {
			<p>The page frame around this showcase is appshell.Shell: the topbar, the More disclosure for overflow navigation, and the theme toggle.</p>
		}
		@breadcrumbs.Breadcrumbs(breadcrumbs.Props{Items: []breadcrumbs.Item{
			{Label: "Home", Href: "/"},
			{Label: "Projects", Href: "/#shell"},
			{Label: "Webframe"},
		}})
		@pageheader.PageHeader(pageheader.Props{
			Title:       "Webframe",
			Subtitle:    "A Go component library for server-rendered apps.",
			Breadcrumbs: []breadcrumbs.Item{{Label: "Home", Href: "/"}, {Label: "Projects", Href: "/#shell"}, {Label: "Webframe"}},
			Back:        &pageheader.Link{Label: "All projects", Href: "/"},
			Status:      &badge.Props{Variant: badge.VariantOutline},
			StatusText:  "Active",
			Primary:     &action.Action{Label: "New release", Variant: action.VariantPrimary},
			Secondary: []action.Action{
				{Label: "Settings"},
				{Label: "Export"},
			},
		})
	}
}

templ layoutAsidePanel() {
	@panel.Panel(panel.Props{Title: "Aside", Subtitle: "Sticky on wide screens"}) {
		<p>Supporting content lives here.</p>
	}
}

templ layoutLeftPanel() {
	@panel.Panel(panel.Props{Title: "Left"}) {
		<p>Navigation or filters.</p>
	}
}

templ layoutRightPanel() {
	@panel.Panel(panel.Props{Title: "Right"}) {
		<p>Details or help.</p>
	}
}

templ layoutSection() {
	@layout.Section(layout.SectionProps{ID: "layout", Title: "Layout", Description: "Stack, Inline, TwoColumn, ThreeColumn and Divider arrange content without any raw classes."}) {
		@layout.Stack() {
			@panel.Panel(panel.Props{Title: "First"}) {
				<p>Stacked panel one.</p>
			}
			@panel.Panel(panel.Props{Title: "Second"}) {
				<p>Stacked panel two.</p>
			}
			@panel.Panel(panel.Props{Title: "Third"}) {
				<p>Stacked panel three.</p>
			}
		}
		@layout.Inline(layout.InlineProps{Wrap: true}) {
			@badge.Badge() {
				One
			}
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				Two
			}
			@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
				Three
			}
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
				Four
			}
			@badge.Badge() {
				Five
			}
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				Six
			}
		}
		@layout.TwoColumn(layout.TwoColumnProps{Aside: layoutAsidePanel(), Sticky: true}) {
			<p>The main column takes the remaining width. On narrow screens the aside stacks below it. On wide screens the aside stays pinned while this column scrolls, which suits long documents with a table of contents or a summary beside them.</p>
		}
		@layout.ThreeColumn(layout.ThreeColumnProps{Left: layoutLeftPanel(), Right: layoutRightPanel()}) {
			<p>The center column holds the primary content. On narrow screens the two side columns collapse into disclosures.</p>
		}
		<p>Content above the divider.</p>
		@layout.Divider(layout.DividerProps{Label: "or"})
		<p>Content below the divider.</p>
	}
}

templ panelSection() {
	@layout.Section(layout.SectionProps{ID: "panel", Title: "Panel", Description: "A titled surface with variants, optional collapsing and a flush mode for tables."}) {
		@panel.Panel(panel.Props{Title: "Default", Subtitle: "The standard surface"}) {
			<p>Default panel body.</p>
		}
		@panel.Panel(panel.Props{Title: "Muted", Variant: panel.VariantMuted}) {
			<p>Muted panel body.</p>
		}
		@panel.Panel(panel.Props{Title: "Danger", Variant: panel.VariantDanger}) {
			<p>Danger panel body.</p>
		}
		@panel.Panel(panel.Props{Title: "Collapsible, open", Collapsible: true, Open: true}) {
			<p>This panel starts open.</p>
		}
		@panel.Panel(panel.Props{Title: "Collapsible, closed", Collapsible: true}) {
			<p>This panel starts closed.</p>
		}
		@panel.Panel(panel.Props{Title: "Flush with a table", Flush: true}) {
			@table.Table() {
				@table.Header() {
					@table.Row() {
						@table.Head() {
							Name
						}
						@table.Head() {
							Role
						}
					}
				}
				@table.Body() {
					@table.Row() {
						@table.Cell() {
							Ada
						}
						@table.Cell() {
							Engineer
						}
					}
					@table.Row() {
						@table.Cell() {
							Grace
						}
						@table.Cell() {
							Admiral
						}
					}
				}
			}
		}
	}
}

templ customSection() {
	@layout.Section(layout.SectionProps{ID: "custom", Title: "Custom fences", Description: "The declared escape hatch for markup no component covers."}) {
		<p>Everything inside a fence is exempt from the lint, and every fence is printed by make check-ui so none can hide.</p>
		@customblock.CustomBlock(customblock.Props{Reason: "demo: shows what a declared fence looks like"}) {
			<div style="padding:12px;border:2px dashed var(--color-border);border-radius:8px">
				<p>This raw div is inside a declared fence.</p>
			</div>
		}
	}
}
