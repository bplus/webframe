package pages

import (
	"github.com/bplus/webframe/components/layout"
	"github.com/bplus/webframe/components/logviewer"
	"github.com/bplus/webframe/components/pageheader"
)

// Logs is the Logs page body (GET /logs): the page header and the one
// logviewer, declared by demo.logsProps, which polls /logs/tail for the
// lines the Items handlers append.
templ Logs(p logviewer.Props) {
	@layout.Stack(layout.StackProps{Gap: layout.GapL}) {
		@pageheader.PageHeader(pageheader.Props{
			Title:    "Logs",
			Subtitle: "Every change to the Items app lands here within three seconds. Scroll up and the box stays where you left it; the filter narrows the lines on this page.",
		})
		@logviewer.LogViewer(p)
	}
}
