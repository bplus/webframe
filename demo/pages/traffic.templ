package pages

import (
	"github.com/bplus/webframe/components/trafficstream"
	"github.com/bplus/webframe/demo/layouts"
)

// Traffic renders the traffic stream demo page: a heading plus one
// TrafficStream panel pointed at the demo SSE endpoint, showing the
// component working end-to-end against live data.
//
// It takes no parameters and no children. The panel is configured with
// StreamURL "/api/traffic/stream" (served by demo.HandleTrafficStream,
// which emits a synthetic event every 1.2s), a 560px table height, demo
// provider/event filter options, and two seed InitialRows sharing a trace
// ID; trafficstream.Script() is included so the panel actually connects.
//
// Returns a templ.Component producing the complete HTML document via
// layouts.Base("Traffic Stream").
//
// @boundary the rendered page opens an SSE (EventSource) connection to
// /api/traffic/stream in the browser
// @ai-context served by demo.HandleTraffic at GET /traffic; demo-only
templ Traffic() {
	@layouts.Base("Traffic Stream") {
		<div class="mb-8 space-y-2 border-b border-border pb-6">
			<h1 class="text-4xl font-bold tracking-tight">Traffic Stream</h1>
			<p class="max-w-3xl text-muted-foreground">
				A live operator surface for watching request and response activity, filtering by provider and event type, and pausing the feed without losing context.
			</p>
		</div>
		@trafficstream.TrafficStream(trafficstream.Props{
			StreamURL:       "/api/traffic/stream",
			Height:          560,
			ProviderOptions: []string{"anthropic", "openai", "gemini", "local"},
			EventOptions:    []string{"request.received", "proxy.forward_start", "proxy.forward_end", "proxy.error", "local.command"},
			InitialRows: []trafficstream.Row{{
				Time:      "12:00:01",
				Provider:  "anthropic",
				Direction: "request",
				Event:     "request.received",
				Status:    "",
				TraceID:   "trace-demo-001",
				Summary:   "POST /v1/messages",
			}, {
				Time:      "12:00:02",
				Provider:  "anthropic",
				Direction: "response",
				Event:     "proxy.forward_end",
				Status:    "200",
				TraceID:   "trace-demo-001",
				Summary:   "Completed upstream round-trip",
			}},
		})
		@trafficstream.Script()
	}
}
