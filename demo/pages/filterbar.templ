package pages

import (
	"strconv"

	"github.com/bplus/webframe/components/filterbar"
	"github.com/bplus/webframe/components/layout"
	"github.com/bplus/webframe/components/panel"
)

// filterbarSection is the showcase's Filter bar section. The showcase is a
// static page, so the first render shows the unfiltered list; the bar loads
// FilterDemoResponse from GET /api/filter-demo (data in filterdemo.go).
templ filterbarSection() {
	{{ filters, found, total := FilterDemo(nil) }}
	@layout.Section(layout.SectionProps{Level: 3, ID: "filterbar", Title: "Filter bar", Description: "The row of controls above a list. listpage builds one from its Filters (see /items); this one is called directly."}) {
		@panel.Panel(panel.Props{Level: 4, Title: "One choice of sixteen, with counts", Subtitle: "TypeChoice: a click selects one school, a second click on it (or on All) clears it. The buttons stay on one line that scrolls sideways; the cut-off edge fades. Type in Search and each count follows: the answer renders the group again out of band (ControlsOOB), and the search box keeps the focus."}) {
			@layout.Stack(layout.StackProps{Gap: layout.GapM}) {
				@filterbar.FilterBar(filterbar.Props{
					ID:        FilterDemoID,
					Filters:   filters,
					HxGet:     "/api/filter-demo",
					HxTarget:  "#" + FilterDemoID + "-results",
					ShowReset: true,
				})
				@layout.Stack(layout.StackProps{ID: FilterDemoID + "-results", Gap: layout.GapS}) {
					@FilterDemoResults(found, total)
				}
			}
		}
	}
}

// FilterDemoResponse is what the bar's request is answered with: the
// results region's content, then the bar's controls out of band
// (filterbar.ControlsOOB renders the School group and skips the search box).
templ FilterDemoResponse(filters []filterbar.FilterConfig, found []FilterDemoSpell, total int) {
	@FilterDemoResults(found, total)
	@filterbar.ControlsOOB(FilterDemoID, filters...)
}

// FilterDemoResults is the content of the demo's results region: a count
// line and the matching spells.
templ FilterDemoResults(found []FilterDemoSpell, total int) {
	<p><strong>{ strconv.Itoa(len(found)) }</strong> of { strconv.Itoa(total) } spells</p>
	if len(found) > 0 {
		<ul>
			for _, s := range found {
				<li>{ s.Name } <small>{ s.School }</small></li>
			}
		</ul>
	}
}
