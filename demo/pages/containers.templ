package pages

import (
	"fmt"
	"github.com/bplus/webframe/components/button"
	"github.com/bplus/webframe/components/dialog"
	"github.com/bplus/webframe/components/layout"
	"github.com/bplus/webframe/components/panel"
	"github.com/bplus/webframe/components/slideover"
)

// The demos of this file show a long list inside a container: the list
// scrolls and the lines around it stay in view. Each is called from its
// component's section of the showcase.

// containerRows is how many rows each long-list demo shows.
const containerRows = 100

// longList is a list long enough to need scrolling in every container.
templ longList() {
	<ul>
		for i := range containerRows {
			<li>{ fmt.Sprintf("Row %d of %d", i+1, containerRows) }</li>
		}
	</ul>
}

// longListDialog is a dialog of the 800px tier whose Body scrolls: the
// header, the count line and the footer are pinned.
templ longListDialog() {
	@dialog.Dialog(dialog.Props{ID: "long-list-dialog"}) {
		@dialog.Trigger() {
			@button.Button(button.Props{ID: "long-list-dialog-open", Variant: button.VariantOutline}) {
				Long list dialog
			}
		}
		@dialog.Content(dialog.ContentProps{Width: dialog.WidthXl}) {
			@dialog.Header() {
				@dialog.Title() {
					Pick a row
				}
				@dialog.Description() {
					The dialog is 800px wide and never taller than the screen.
				}
			}
			@layout.Inline(layout.InlineProps{ID: "long-list-dialog-count"}) {
				<span>{ fmt.Sprintf("Showing %d of %d. This line and the footer stay in view.", containerRows, containerRows) }</span>
			}
			@dialog.Body(dialog.BodyProps{ID: "long-list-dialog-body", Label: "Rows"}) {
				@longList()
			}
			@dialog.Footer(dialog.FooterProps{ID: "long-list-dialog-footer"}) {
				@dialog.Close() {
					@button.Button() {
						Done
					}
				}
			}
		}
	}
}

// drawerSection shows a drawer with a Pinned line: the title, the pinned
// line and the footer stay in view while the Body scrolls.
templ drawerSection() {
	@layout.Section(layout.SectionProps{Level: 3, ID: "drawer", Title: "Drawer with a pinned line", Description: "A slide-over from the right with a long list. The line under the title is a Pinned part: it stays in view while the list scrolls, as the footer does."}) {
		@slideover.SlideOver(slideover.Props{ID: "long-list-drawer"}) {
			@slideover.Trigger() {
				@button.Button(button.Props{ID: "long-list-drawer-open", Variant: button.VariantOutline}) {
					Open drawer
				}
			}
			@slideover.Panel(slideover.PanelProps{Title: "Pick a row", Width: slideover.WidthLg}) {
				@slideover.Pinned(slideover.PinnedProps{ID: "long-list-drawer-pinned"}) {
					<span>{ fmt.Sprintf("Showing %d of %d. This line stays in view.", containerRows, containerRows) }</span>
				}
				@slideover.Body(slideover.BodyProps{ID: "long-list-drawer-body"}) {
					@longList()
				}
				@slideover.Footer() {
					@slideover.Close() {
						@button.Button() {
							Done
						}
					}
				}
			}
		}
	}
}

// scrollDemo shows layout.Scroll in a panel: the line above the box stays
// in view while the rows scroll, and the page does not grow by 100 rows.
templ scrollDemo() {
	@panel.Panel(panel.Props{ID: "scroll-demo", Level: 4, Title: "Scroll", Subtitle: "A box with a height limit (240px here) that scrolls a long list inside the page."}) {
		@layout.Stack(layout.StackProps{Gap: layout.GapS}) {
			<span>{ fmt.Sprintf("Showing %d of %d. This line stays in view.", containerRows, containerRows) }</span>
			@layout.Scroll(layout.ScrollProps{ID: "scroll-demo-rows", MaxHeight: layout.ScrollS, Label: "Rows"}) {
				@longList()
			}
		}
	}
}
