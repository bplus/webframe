// templui component tabs - version: v1.3.0 installed by templui v1.3.0
// 📚 Documentation: https://templui.io/docs/components/tabs
package tabs

import (
	"context"
	"github.com/bplus/webframe/utils"
)

// Sizing decides how tall the tab group is as the user switches panels.
type Sizing string

const (
	SizingTallest Sizing = ""      // default: group is as tall as its tallest panel; nothing moves on switch
	SizingFixed   Sizing = "fixed" // every panel is Height tall and scrolls inside
	SizingFit     Sizing = "fit"   // group grows and shrinks with the active panel
)

// Height is the panel height used by SizingFixed.
type Height string

const (
	HeightM Height = ""  // 20rem
	HeightS Height = "s" // 12rem
	HeightL Height = "l" // 32rem
)

// Props configures the Tabs root. ID doubles as the tabs group ID shared by
// all Triggers and Contents; leave it empty to get a random one. Sizing
// defaults to SizingTallest; Height is only read when Sizing == SizingFixed.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Sizing     Sizing
	Height     Height // only read when Sizing == SizingFixed
}

// ListProps configures the List strip that holds the Trigger buttons.
type ListProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// TriggerProps configures a tab button. Value is REQUIRED and must match the
// Value of exactly one Content in the same group. IsActive marks the
// initially selected tab (mark exactly one Trigger/Content pair). TabsID
// overrides the group ID from context — needed only when the Trigger is
// rendered outside its Tabs root (e.g. returned from an HTMX partial).
type TriggerProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Value      string
	IsActive   bool
	TabsID     string
}

// ContentProps configures a tab panel; Value, IsActive and TabsID follow the
// same rules as TriggerProps. Leave Sizing zero inside a Tabs root, where it
// is inherited; set it, with TabsID, when rendering the Content standalone.
type ContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Value      string
	IsActive   bool
	TabsID     string
	Sizing     Sizing // "" = inherit from the enclosing Tabs; set with TabsID for standalone rendering
}

// Tabs is the root container of a tab group. The expected structure is
// Tabs > { List > Trigger..., Content... }, with Script rendered once per
// page. The group ID (random when Props.ID is empty) reaches List, Trigger
// and Content through the render context; a part rendered standalone must
// pass TabsID instead. The initially active tab is the pair rendered with
// IsActive; switching happens client-side.
//
// Under SizingTallest (the default) all panels share one grid cell, so the
// group is as tall as its tallest panel and nothing moves on switch.
// SizingFixed gives every panel Height and scrolls inside it, making each
// panel focusable so it can be scrolled by keyboard. SizingFit grows and
// shrinks with the active panel.
//
// Under SizingTallest and SizingFixed inactive panels are laid out, so an
// hx-trigger="intersect" inside one fires at page load. Use a "revealed" or
// click trigger, or SizingFit, for content that should load on first open.
templ Tabs(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ tabsID := p.ID }}
	if tabsID == "" {
		{{ tabsID = utils.RandomID() }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge(utils.IfElse(p.Sizing == SizingFit, "flex flex-col gap-2", "grid gap-2"), p.Class) }
		data-tui-tabs
		data-tui-tabs-id={ tabsID }
		data-wf-tabs-sizing={ sizingAttr(p.Sizing) }
		if p.Sizing == SizingFixed {
			data-wf-tabs-height={ heightAttr(p.Height) }
		}
		{ p.Attributes... }
	>
		{{ ctx = context.WithValue(ctx, "tabsId", tabsID) }}
		{{ ctx = context.WithValue(ctx, sizingKey{}, p.Sizing) }}
		{ children... }
	</div>
}

// List renders the strip that groups the Trigger buttons. It reads the
// group ID from the enclosing Tabs and has no TabsID override, so render it
// inside Tabs.
templ List(props ...ListProps) {
	{{ var p ListProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ tabsID := IDFromContext(ctx) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			utils.TwMerge(
				"bg-muted text-muted-foreground inline-flex h-9 w-fit items-center justify-center rounded-lg p-[3px]",
				p.Class,
			),
		}
		data-tui-tabs-list
		data-tui-tabs-id={ tabsID }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Trigger renders one tab button that activates the Content with the same
// Value in its group. An empty Value renders an inline error before the
// button. Rendered outside Tabs without TabsID, it matches no panel.
templ Trigger(props ...TriggerProps) {
	{{ var p TriggerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ tabsID := p.TabsID }}
	if tabsID == "" {
		{{ tabsID = IDFromContext(ctx) }}
	}
	if p.Value == "" {
		<span class="text-xs text-destructive">Error: Tab Trigger missing required 'Value' attribute.</span>
	}
	<button
		if p.ID != "" {
			id={ p.ID }
		}
		type="button"
		class={
			utils.TwMerge(
				"data-[tui-tabs-state=active]:bg-background dark:data-[tui-tabs-state=active]:text-foreground focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:outline-ring dark:data-[tui-tabs-state=active]:border-input dark:data-[tui-tabs-state=active]:bg-input/30 text-foreground dark:text-muted-foreground inline-flex h-[calc(100%-1px)] flex-1 items-center justify-center gap-1.5 rounded-md border border-transparent px-2 py-1 text-sm font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:ring-[3px] focus-visible:outline-1 disabled:pointer-events-none disabled:opacity-50 data-[tui-tabs-state=active]:shadow-sm [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4",
				p.Class,
			),
		}
		data-tui-tabs-trigger
		data-tui-tabs-id={ tabsID }
		data-tui-tabs-value={ p.Value }
		data-tui-tabs-state={ utils.IfElse(p.IsActive, "active", "inactive") }
		{ p.Attributes... }
	>
		{ children... }
	</button>
}

// Content renders one tab panel, hidden unless IsActive. An empty Value
// renders an inline error. Group ID and Sizing come from the enclosing Tabs
// unless TabsID and Sizing are set; a standalone partial must set both.
templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ tabsID := p.TabsID }}
	if tabsID == "" {
		{{ tabsID = IDFromContext(ctx) }}
	}
	if p.Value == "" {
		<span class="text-xs text-destructive">Error: Tab Content missing required 'Value' attribute.</span>
	}
	{{ sizing := p.Sizing }}
	if sizing == "" {
		{{ sizing = sizingFromContext(ctx) }}
	}
	{{ fixed := sizing == SizingFixed }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			utils.TwMerge(
				"flex-1",
				// Fixed panels are focusable (tabindex=0, they scroll), so they
				// get the Trigger's visible focus ring; other modes are not
				// focusable and keep outline-none.
				utils.IfElse(fixed, "focus-visible:outline-1 focus-visible:outline-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]", "outline-none"),
				utils.If(!p.IsActive, "hidden"),
				p.Class,
			),
		}
		data-tui-tabs-content
		data-tui-tabs-id={ tabsID }
		data-tui-tabs-value={ p.Value }
		data-tui-tabs-state={ utils.IfElse(p.IsActive, "active", "inactive") }
		if fixed {
			tabindex="0"
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// sizingKey is the ctx key under which Tabs stores its Sizing for Content.
type sizingKey struct{}

// sizingFromContext returns the enclosing Tabs' Sizing, or SizingTallest
// outside a Tabs render.
func sizingFromContext(ctx context.Context) Sizing {
	s, _ := ctx.Value(sizingKey{}).(Sizing)
	return s
}

// IDFromContext returns the group ID of the enclosing Tabs, or "" outside a
// Tabs render.
func IDFromContext(ctx context.Context) string {
	if tabsID, ok := ctx.Value("tabsId").(string); ok {
		return tabsID
	}
	return ""
}

// sizingAttr maps Sizing to its data-wf-tabs-sizing value; anything other
// than fixed or fit is treated as the tallest default.
func sizingAttr(s Sizing) string {
	switch s {
	case SizingFixed:
		return "fixed"
	case SizingFit:
		return "fit"
	default:
		return "tallest"
	}
}

// heightAttr maps Height to its data-wf-tabs-height value; anything other
// than s or l is treated as the m default.
func heightAttr(h Height) string {
	switch h {
	case HeightS:
		return "s"
	case HeightL:
		return "l"
	default:
		return "m"
	}
}

// Script emits the deferred script tag for tabs.min.js, which switches tabs
// client-side. Include it once per page that renders Tabs.
templ Script() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/static/js/tabs.min.js") }></script>
}
