// templui component separator - version: v1.3.0 installed by templui v1.3.0
// 📚 Documentation: https://templui.io/docs/components/separator
package separator

import "github.com/bplus/webframe/utils"

// Orientation selects the separator's axis. The zero value is treated
// as OrientationHorizontal by Separator; any other non-empty value
// (including typos) falls through to the vertical branch.
type Orientation string

// Decoration selects the line style of the separator's rule. The zero
// value (and any unrecognized value) renders the default solid border.
type Decoration string

const (
	// OrientationHorizontal draws a full-width horizontal rule; this is
	// the default when Props.Orientation is unset.
	OrientationHorizontal Orientation = "horizontal"
	// OrientationVertical draws a full-height vertical rule; the parent
	// must give the separator a height for it to be visible.
	OrientationVertical Orientation = "vertical"
)

const (
	// DecorationDashed renders the rule as a dashed line.
	DecorationDashed Decoration = "dashed"
	// DecorationDotted renders the rule as a dotted line.
	DecorationDotted Decoration = "dotted"
)

// Props configures a Separator. The zero value renders a plain solid
// horizontal rule. Class is merged onto the outer wrapper (not the rule
// itself) via utils.TwMerge, and Attributes are spread onto the same
// wrapper.
type Props struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Orientation Orientation
	Decoration  Decoration
}

// Separator renders a divider between regions, optionally with a label
// (the children) centered on the line. The label sits on a bg-background
// chip that masks the line, so on another surface (such as bg-card)
// override its color. The chip is emitted even with no children, leaving a
// small gap at the center.
templ Separator(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Orientation == "" {
		{{ p.Orientation = OrientationHorizontal }}
	}
	if p.Orientation == OrientationHorizontal {
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			role="separator"
			aria-orientation="horizontal"
			class={ utils.TwMerge("shrink-0 w-full", p.Class) }
			{ p.Attributes... }
		>
			<div class="relative flex items-center w-full">
				<span
					class={
						utils.TwMerge(
							"absolute w-full border-t h-[1px]",
							decorationClasses(p.Decoration),
						),
					}
					aria-hidden="true"
				></span>
				<span class="relative mx-auto bg-background px-2 text-xs text-muted-foreground">
					{ children... }
				</span>
			</div>
		</div>
	} else {
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			role="separator"
			aria-orientation="vertical"
			class={ utils.TwMerge("shrink-0 h-full", p.Class) }
			{ p.Attributes... }
		>
			<div class="relative flex flex-col items-center h-full">
				<span
					class={
						utils.TwMerge(
							"absolute h-full border-l w-[1px]",
							decorationClasses(p.Decoration),
						),
					}
					aria-hidden="true"
				></span>
				<span class="relative my-auto bg-background py-2 text-xs text-muted-foreground">
					{ children... }
				</span>
			</div>
		</div>
	}
}

func decorationClasses(decoration Decoration) string {
	switch decoration {
	case DecorationDashed:
		return "border-dashed"
	case DecorationDotted:
		return "border-dotted"
	default:
		return ""
	}
}
