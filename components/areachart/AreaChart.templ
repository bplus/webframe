package areachart

import (
	"fmt"
	"github.com/bplus/webframe/utils"
	"math"
	"strings"
)

// DataPoint is one sample in a Series. Points render in slice order,
// evenly spaced; Label is display text only.
type DataPoint struct {
	Label string  // X-axis label (e.g. date)
	Value float64 // Y value
}

// Series is one named line-plus-area. An empty Color is picked by index
// from theme tokens (primary, success, warning, info, destructive), so the
// chart follows light and dark; a set Color is sanitized, so an invalid
// value renders gray.
type Series struct {
	Label string // Legend label
	Data  []DataPoint
	Color string // Line/fill color (any CSS color, e.g. "var(--color-info)")
}

// Props configures AreaChart. Width and Height (default 400x200) are the
// natural size and set the drawing's proportions; the SVG scales down to fit
// a narrower container.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Series     []Series // One or more data series
	Width      int      // SVG width (default 400)
	Height     int      // SVG height (default 200)
	ShowLabels bool     // X-axis labels
	ShowLegend bool     // Legend below chart
	ShowGrid   bool     // Horizontal grid lines
}

func (p Props) resolveWidth() int {
	if p.Width > 0 {
		return p.Width
	}
	return 400
}

func (p Props) resolveHeight() int {
	if p.Height > 0 {
		return p.Height
	}
	return 200
}

// areaDefaultColors are the series colors used when a Series sets none.
var areaDefaultColors = []string{
	"var(--color-primary)", "var(--color-success)", "var(--color-warning)",
	"var(--color-info)", "var(--color-destructive)",
}

func globalMinMax(series []Series) (float64, float64) {
	minV := math.Inf(1)
	maxV := math.Inf(-1)
	for _, s := range series {
		for _, d := range s.Data {
			if d.Value < minV {
				minV = d.Value
			}
			if d.Value > maxV {
				maxV = d.Value
			}
		}
	}
	if math.IsInf(minV, 1) || math.IsInf(maxV, -1) {
		// No data points at all
		return 0, 1
	}
	if minV == maxV {
		return minV, minV + 1
	}
	return minV, maxV
}

func buildAreaPoints(data []DataPoint, w, h, padL, padR, padT, padB int, minV, maxV float64) (polyline string, polygon string) {
	n := len(data)
	if n == 0 {
		return "", ""
	}
	plotW := float64(w - padL - padR)
	plotH := float64(h - padT - padB)
	rang := maxV - minV
	if rang == 0 {
		rang = 1
	}
	pts := make([]string, n)
	for i, d := range data {
		x := float64(padL) + float64(i)*plotW/float64(max(n-1, 1))
		y := float64(padT) + plotH - ((d.Value - minV) * plotH / rang)
		pts[i] = fmt.Sprintf("%.2f,%.2f", x, y)
	}
	polyline = strings.Join(pts, " ")
	// Close polygon for fill: add bottom-right and bottom-left corners
	lastX := float64(padL) + float64(n-1)*plotW/float64(max(n-1, 1))
	polygon = polyline + fmt.Sprintf(" %.2f,%d %.2f,%d", lastX, padT+int(plotH), float64(padL), padT+int(plotH))
	return
}

// AreaChart renders overlaid line-plus-area series as an inline SVG. All
// series share one Y scale, so they are directly comparable; if every
// value is equal, the lines sit on the bottom edge. X-axis labels
// (ShowLabels) come from the first series, thinned to about six. The
// legend shows only with two or more series.
templ AreaChart(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ w := p.resolveWidth() }}
	{{ h := p.resolveHeight() }}
	{{ padL := 10 }}
	{{ padR := 10 }}
	{{ padT := 10 }}
	{{ padB := 20 }}
	if !p.ShowLabels {
		{{ padB = 10 }}
	}
	{{ minV, maxV := globalMinMax(p.Series) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("inline-block max-w-full", p.Class) }
		{ p.Attributes... }
	>
		<svg
			width={ fmt.Sprintf("%d", w) }
			height={ fmt.Sprintf("%d", h) }
			viewBox={ fmt.Sprintf("0 0 %d %d", w, h) }
			style="max-width:100%;height:auto;"
			xmlns="http://www.w3.org/2000/svg"
		>
			if p.ShowGrid {
				for i := 0; i <= 4; i++ {
					{{ gy := padT + (h-padT-padB)*i/4 }}
					<line
						x1={ fmt.Sprintf("%d", padL) }
						y1={ fmt.Sprintf("%d", gy) }
						x2={ fmt.Sprintf("%d", w-padR) }
						y2={ fmt.Sprintf("%d", gy) }
						stroke="var(--color-border)"
						stroke-width="0.5"
						stroke-dasharray="4 4"
					/>
				}
			}
			for si, s := range p.Series {
				{{ var color string }}
				if s.Color == "" {
					{{ color = areaDefaultColors[si%len(areaDefaultColors)] }}
				} else {
					{{ color = utils.SanitizeColor(s.Color) }}
				}
				{{ polyline, polygon := buildAreaPoints(s.Data, w, h, padL, padR, padT, padB, minV, maxV) }}
				if len(s.Data) > 0 {
					<polygon
						points={ polygon }
						fill={ color }
						fill-opacity="0.15"
					/>
					<polyline
						points={ polyline }
						fill="none"
						stroke={ color }
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				}
			}
			if p.ShowLabels && len(p.Series) > 0 && len(p.Series[0].Data) > 0 {
				{{ data := p.Series[0].Data }}
				{{ n := len(data) }}
				{{ plotW := w - padL - padR }}
				{{ step := max(n/6, 1) }}
				for i := 0; i < n; i += step {
					{{ x := padL + (i * plotW / max(n-1, 1)) }}
					<text
						x={ fmt.Sprintf("%d", x) }
						y={ fmt.Sprintf("%d", h-2) }
						text-anchor="middle"
						class="fill-muted-foreground"
						style="font-size: 9px"
					>{ data[i].Label }</text>
				}
			}
		</svg>
		if p.ShowLegend && len(p.Series) > 1 {
			<div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted-foreground mt-2">
				for si, s := range p.Series {
					{{ var color string }}
					if s.Color == "" {
						{{ color = areaDefaultColors[si%len(areaDefaultColors)] }}
					} else {
						{{ color = utils.SanitizeColor(s.Color) }}
					}
					<div class="flex items-center gap-1.5">
						<span class="inline-block w-3 h-0.5 rounded shrink-0" style={ fmt.Sprintf("background-color: %s", color) }></span>
						<span>{ s.Label }</span>
					</div>
				}
			</div>
		}
	</div>
}
