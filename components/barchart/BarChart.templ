package barchart

import (
	"fmt"
	"github.com/bplus/webframe/utils"
	"math"
)

// Orientation selects the bar direction. Any value other than Vertical,
// including "", is Horizontal.
type Orientation string

const (
	// Horizontal lays bars left-to-right with labels in a left-hand gutter.
	Horizontal Orientation = "horizontal"
	// Vertical lays bars bottom-up with labels underneath.
	Vertical Orientation = "vertical"
)

// Bar is one bar. Bars are drawn by |Value|, so a negative value looks the
// same as its positive counterpart. A non-empty Color is sanitized and
// overrides Props.BarColor for this bar.
type Bar struct {
	Label string
	Value float64
	Color string // optional per-bar color override
}

// Props configures BarChart. When len(Bars) exceeds MaxBars > 0, the MaxBars
// largest bars (by raw value) are kept, sorted descending, and the rest are
// summed into one "Other (K)" bar. Otherwise bar order is kept.
type Props struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Bars        []Bar
	Orientation Orientation // default horizontal
	Width       int         // SVG width (default 300)
	Height      int         // SVG height (default 200)
	BarColor    string      // default bar color (default "var(--color-primary)")
	ShowValues  bool        // show value labels on bars
	ShowLabels  bool        // show axis labels
	MaxBars     int         // cap bar count; extra bars fold into "Other (K)" (0 = unlimited)
}

func (p Props) resolveOrientation() Orientation {
	if p.Orientation == Vertical {
		return Vertical
	}
	return Horizontal
}

func (p Props) resolveWidth() int {
	if p.Width > 0 {
		return p.Width
	}
	return 300
}

func (p Props) resolveHeight() int {
	if p.Height > 0 {
		return p.Height
	}
	return 200
}

func (p Props) resolveBarColor() string {
	if p.BarColor != "" {
		return p.BarColor
	}
	return "var(--color-primary)"
}

func maxVal(bars []Bar) float64 {
	if len(bars) == 0 {
		return 1
	}
	m := 0.0
	for _, b := range bars {
		if math.Abs(b.Value) > m {
			m = math.Abs(b.Value)
		}
	}
	if m == 0 {
		return 1
	}
	return m
}

// BarChart renders a bar chart as an inline SVG. Width and Height are the
// natural size; the SVG scales down to fit a narrower container.
//
// With Horizontal and ShowLabels, the label gutter grows to fit the widest
// label (up to 45% of the SVG, which may widen to 2x Width), and labels that
// still don't fit are truncated with the full text in a hover <title>.
// Vertical labels are never truncated.
templ BarChart(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ w := p.resolveWidth() }}
	{{ h := p.resolveHeight() }}
	{{ orientation := p.resolveOrientation() }}
	{{ defaultColor := utils.SanitizeColor(p.resolveBarColor()) }}
	{{ bars := capBars(p.Bars, p.MaxBars) }}
	{{ labelW := 60 }}
	if orientation == Horizontal {
		{{ labelW, w = computeLabelGutter(bars, w, p.ShowLabels) }}
	}
	{{ mv := maxVal(bars) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("inline-block max-w-full", p.Class) }
		{ p.Attributes... }
	>
		<svg
			width={ fmt.Sprintf("%d", w) }
			height={ fmt.Sprintf("%d", h) }
			viewBox={ fmt.Sprintf("0 0 %d %d", w, h) }
			style="max-width:100%;height:auto;"
			xmlns="http://www.w3.org/2000/svg"
		>
			if orientation == Horizontal {
				{{ plotW := w - labelW - 10 }}
				{{ barH := 0 }}
				if len(bars) > 0 {
					{{ barH = (h - 10) / len(bars) }}
				}
				{{ gap := 4 }}
				for i, bar := range bars {
					{{ color := defaultColor }}
					if bar.Color != "" {
						{{ color = utils.SanitizeColor(bar.Color) }}
					}
					{{ barWidth := max(0, int(math.Abs(bar.Value)*float64(plotW)/mv)) }}
					{{ y := i*barH + gap/2 }}
					{{ rectH := barH - gap }}
					if rectH < 2 {
						{{ rectH = 2 }}
					}
					if p.ShowLabels {
						{{ disp, truncated := fitLabel(bar.Label, labelW) }}
						<text
							x={ fmt.Sprintf("%d", labelW-4) }
							y={ fmt.Sprintf("%d", y+rectH/2+4) }
							text-anchor="end"
							class="text-xs fill-muted-foreground"
							style="font-size: 11px"
						>
							if truncated {
								<title>{ bar.Label }</title>
							}
							{ disp }
						</text>
					}
					<rect
						x={ fmt.Sprintf("%d", labelW) }
						y={ fmt.Sprintf("%d", y) }
						width={ fmt.Sprintf("%d", barWidth) }
						height={ fmt.Sprintf("%d", rectH) }
						fill={ color }
						rx="2"
					/>
					if p.ShowValues {
						<text
							x={ fmt.Sprintf("%d", labelW+barWidth+4) }
							y={ fmt.Sprintf("%d", y+rectH/2+4) }
							class="text-xs fill-foreground"
							style="font-size: 10px"
						>{ fmt.Sprintf("%.4g", bar.Value) }</text>
					}
				}
			} else {
				{{ labelH := 20 }}
				{{ plotH := h - labelH - 10 }}
				{{ barW := 0 }}
				if len(bars) > 0 {
					{{ barW = (w - 10) / len(bars) }}
				}
				{{ gap := 4 }}
				for i, bar := range bars {
					{{ color := defaultColor }}
					if bar.Color != "" {
						{{ color = utils.SanitizeColor(bar.Color) }}
					}
					{{ barHeight := max(0, int(math.Abs(bar.Value)*float64(plotH)/mv)) }}
					{{ x := i*barW + gap/2 }}
					{{ rectW := barW - gap }}
					if rectW < 2 {
						{{ rectW = 2 }}
					}
					<rect
						x={ fmt.Sprintf("%d", x) }
						y={ fmt.Sprintf("%d", plotH-barHeight) }
						width={ fmt.Sprintf("%d", rectW) }
						height={ fmt.Sprintf("%d", barHeight) }
						fill={ color }
						rx="2"
					/>
					if p.ShowLabels {
						<text
							x={ fmt.Sprintf("%d", x+rectW/2) }
							y={ fmt.Sprintf("%d", h-2) }
							text-anchor="middle"
							class="text-xs fill-muted-foreground"
							style="font-size: 10px"
						>{ bar.Label }</text>
					}
					if p.ShowValues {
						<text
							x={ fmt.Sprintf("%d", x+rectW/2) }
							y={ fmt.Sprintf("%d", plotH-barHeight-4) }
							text-anchor="middle"
							class="text-xs fill-foreground"
							style="font-size: 10px"
						>{ fmt.Sprintf("%.4g", bar.Value) }</text>
					}
				}
			}
		</svg>
	</div>
}
