// templui component dropdown - version: v1.3.0 installed by templui v1.3.0
// 📚 Documentation: https://templui.io/docs/components/dropdown
package dropdown

import (
	"context"
	"github.com/bplus/webframe/components/popover"
	"github.com/bplus/webframe/utils"
)

// Placement is an alias for popover.Placement, re-exported so callers can
// position dropdown content without importing the popover package directly.
type Placement = popover.Placement

// Placement constants re-exported from the popover package. Pass one of these
// as ContentProps.Placement; PlacementBottomStart is the default used by Content.
const (
	PlacementTop         = popover.PlacementTop
	PlacementTopStart    = popover.PlacementTopStart
	PlacementTopEnd      = popover.PlacementTopEnd
	PlacementRight       = popover.PlacementRight
	PlacementRightStart  = popover.PlacementRightStart
	PlacementRightEnd    = popover.PlacementRightEnd
	PlacementBottom      = popover.PlacementBottom
	PlacementBottomStart = popover.PlacementBottomStart
	PlacementBottomEnd   = popover.PlacementBottomEnd
	PlacementLeft        = popover.PlacementLeft
	PlacementLeftStart   = popover.PlacementLeftStart
	PlacementLeftEnd     = popover.PlacementLeftEnd
)

type contextKey string

var (
	contentIDKey    contextKey = "contentID"
	subContentIDKey contextKey = "subContentID"
)

// Props configures Dropdown. ID, when set, is the popover content ID shared by
// Trigger and Content; empty means a random one. Set it only to reference the
// menu from outside (or across an HTMX swap); it must be unique per page.
type Props struct {
	ID string
}

// TriggerProps configures Trigger. Fields pass through to popover.Trigger.
type TriggerProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// ContentProps configures Content. Placement defaults to PlacementBottomStart.
type ContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Placement  Placement
}

// GroupProps configures a Group section (role="group") inside Content.
type GroupProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// LabelProps configures a non-interactive Label heading inside Content.
type LabelProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// ItemProps configures Item. Href renders an <a> instead of a <button>
// (Target applies only then). PreventClose keeps the menu open after the item
// is activated.
type ItemProps struct {
	ID           string
	Class        string
	Attributes   templ.Attributes
	Disabled     bool
	Href         string
	Target       string
	PreventClose bool
}

// SeparatorProps configures a Separator rule between menu sections.
type SeparatorProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// ShortcutProps configures a Shortcut hint span rendered inside an Item.
type ShortcutProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// SubProps configures Sub. ID, when set, is the content ID linking SubTrigger
// and SubContent; empty means a random one.
type SubProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// SubTriggerProps configures the hover trigger row of a submenu.
type SubTriggerProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// SubContentProps configures the fly-out panel of a submenu.
type SubContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// Dropdown is the root of a click-triggered menu: Dropdown > { Trigger,
// Content > (Group | Label | Item | Separator | Sub) }. It renders only its
// children and passes the shared content ID to Trigger and Content through the
// render context, so both must render inside it. Outside a Dropdown they fall
// back to utils.PairedID, which links the n-th orphaned Trigger to the n-th
// orphaned Content of the same render.
templ Dropdown(props ...Props) {
	{{
		var p Props
		if len(props) > 0 {
			p = props[0]
		}
		contentID := p.ID
		if contentID == "" {
			contentID = utils.RandomID()
		}
		ctx = context.WithValue(ctx, contentIDKey, contentID)
	}}
	{ children... }
}

// Trigger wraps its children (typically a button) in a click popover.Trigger
// that opens the sibling Content.
templ Trigger(props ...TriggerProps) {
	{{
		var p TriggerProps
		if len(props) > 0 {
			p = props[0]
		}
		contentID, ok := ctx.Value(contentIDKey).(string)
		if !ok {
			var err error
			if contentID, err = utils.PairedID(ctx, "wf-dropdown", "trigger"); err != nil {
				return err
			}
		}
	}}
	@popover.Trigger(popover.TriggerProps{
		ID:          p.ID,
		Class:       p.Class,
		Attributes:  p.Attributes,
		For:         contentID,
		TriggerType: popover.TriggerTypeClick,
	}) {
		{ children... }
	}
}

// Content renders the menu panel as an exclusive popover.Content (opening it
// closes other exclusive popovers). Its DOM ID comes from the enclosing
// Dropdown; ContentProps.ID is not applied.
templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ contentID, ok := ctx.Value(contentIDKey).(string) }}
	if !ok {
		{{
			var err error
			if contentID, err = utils.PairedID(ctx, "wf-dropdown", "content"); err != nil { // prefix must match Trigger's
				return err
			}
		}}
	}
	{{
		placement := p.Placement
		if placement == "" {
			placement = PlacementBottomStart
		}
	}}
	@popover.Content(popover.ContentProps{
		ID:        contentID,
		Placement: placement,
		Class: utils.TwMerge(
			"z-50 rounded-md bg-popover p-1 shadow-md focus:outline-none overflow-auto",
			"border border-border",
			"min-w-[8rem] max-h-[300px]",
			p.Class,
		),
		Attributes: p.Attributes,
		Exclusive:  true,
	}) {
		{ children... }
	}
}

// Group clusters related Items inside Content under role="group".
templ Group(props ...GroupProps) {
	{{ var p GroupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("py-1", p.Class) }
		role="group"
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Label renders a non-interactive heading inside Content.
templ Label(props ...LabelProps) {
	{{ var p LabelProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("px-2 py-1.5 text-sm font-semibold", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Item renders a menu entry (role="menuitem"): an <a> when Href is set,
// otherwise a <button>. Activating it closes the menu unless PreventClose is
// set. Unlike the other parts, it always renders an id (random if unset).
templ Item(props ...ItemProps) {
	{{ var p ItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	if p.Href != "" {
		<a
			id={ p.ID }
			if p.Href != "" {
				href={ p.Href }
			}
			if p.Target != "" {
				target={ p.Target }
			}
			class={
				utils.TwMerge(
					"flex text-left items-center justify-between px-2 py-1.5 text-sm rounded-sm",
					utils.If(!p.Disabled, "focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground cursor-default"),
					utils.If(p.Disabled, "opacity-50 pointer-events-none"),
					p.Class,
				),
			}
			role="menuitem"
			data-tui-dropdown-item
			if p.PreventClose {
				data-tui-dropdown-prevent-close="true"
			}
			{ p.Attributes... }
		>
			{ children... }
		</a>
	} else {
		<button
			id={ p.ID }
			class={
				utils.TwMerge(
					"w-full text-left flex items-center justify-between px-2 py-1.5 text-sm rounded-sm",
					utils.If(!p.Disabled, "focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground cursor-default"),
					utils.If(p.Disabled, "opacity-50 pointer-events-none"),
					p.Class,
				),
			}
			role="menuitem"
			data-tui-dropdown-item
			disabled?={ p.Disabled }
			if p.PreventClose {
				data-tui-dropdown-prevent-close="true"
			}
			{ p.Attributes... }
		>
			{ children... }
		</button>
	}
}

// Separator draws a horizontal rule between menu sections.
templ Separator(props ...SeparatorProps) {
	{{ var p SeparatorProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("h-px my-1 -mx-1 bg-muted", p.Class) }
		role="separator"
		{ p.Attributes... }
	></div>
}

// Shortcut renders a right-aligned keyboard hint (e.g. "⌘K") as the last
// child of an Item. It is visual only and binds no key handler.
templ Shortcut(props ...ShortcutProps) {
	{{ var p ShortcutProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("ml-auto text-xs tracking-widest opacity-60", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

// Sub is a nested submenu inside Content: Sub > { SubTrigger, SubContent }.
// Like Dropdown, it links its two children through the render context, under
// a separate key so it does not replace the parent's content ID.
templ Sub(props ...SubProps) {
	{{
		var p SubProps
		if len(props) > 0 {
			p = props[0]
		}
		subContentID := p.ID
		if subContentID == "" {
			subContentID = utils.RandomID()
		}
		ctx = context.WithValue(ctx, subContentIDKey, subContentID)
	}}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-tui-dropdown-submenu
		class={ utils.TwMerge("relative", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// SubTrigger renders the hover-activated row, with a chevron, that opens
// SubContent. Unlike Trigger, Class and Attributes go on the inner button.
templ SubTrigger(props ...SubTriggerProps) {
	{{
		var p SubTriggerProps
		if len(props) > 0 {
			p = props[0]
		}
		subContentID, ok := ctx.Value(subContentIDKey).(string)
		if !ok {
			var err error
			if subContentID, err = utils.PairedID(ctx, "wf-dropdown-sub", "trigger"); err != nil {
				return err
			}
		}
	}}
	@popover.Trigger(popover.TriggerProps{
		ID:          p.ID,
		For:         subContentID,
		TriggerType: popover.TriggerTypeHover,
	}) {
		<button
			type="button"
			data-tui-dropdown-submenu-trigger
			class={
				utils.TwMerge(
					"w-full text-left flex items-center justify-between px-2 py-1.5 text-sm rounded-sm",
					"focus:bg-accent focus:text-accent-foreground hover:bg-accent hover:text-accent-foreground cursor-default",
					p.Class,
				),
			}
			{ p.Attributes... }
		>
			<span>
				{ children... }
			</span>
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-auto">
				<path d="M6.5 3L11.5 8L6.5 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</button>
	}
}

// SubContent renders the submenu fly-out to the right of SubTrigger. It is not
// exclusive, so opening it keeps the parent menu open. Its DOM ID comes from
// the enclosing Sub; SubContentProps.ID is not applied.
templ SubContent(props ...SubContentProps) {
	{{
		var p SubContentProps
		if len(props) > 0 {
			p = props[0]
		}
		subContentID, ok := ctx.Value(subContentIDKey).(string)
		if !ok {
			var err error
			if subContentID, err = utils.PairedID(ctx, "wf-dropdown-sub", "content"); err != nil {
				return err
			}
		}
	}}
	@popover.Content(popover.ContentProps{
		ID:            subContentID,
		Placement:     popover.PlacementRightStart,
		Offset:        -4, // overlap the parent menu slightly
		HoverDelay:    100, // ms
		HoverOutDelay: 200, // ms
		Class: utils.TwMerge(
			"z-[9999] min-w-[8rem] rounded-md border bg-popover p-1 shadow-lg",
			p.Class,
		),
		Attributes: p.Attributes,
	}) {
		{ children... }
	}
}

// Script loads dropdown.min.js, which closes the menu when an Item is clicked.
// Include it once per page that renders a Dropdown, alongside the popover script.
templ Script() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/static/js/dropdown.min.js") }></script>
}
