package toolbar

import (
	"github.com/bplus/webframe/components/action"
	"github.com/bplus/webframe/components/button"
	"github.com/bplus/webframe/components/dropdown"
	"github.com/bplus/webframe/components/icon"
	"github.com/bplus/webframe/utils"
)

// Toolbar renders <div role="toolbar"> holding the Left action group, the
// children in a growing middle slot, and the Right group. Below md the
// middle slot moves to its own row; an empty slot adds no row.
//
// Below md, when either side has more actions than Props.Overflow, each
// side renders twice: a full group for md and up and a phone group showing
// the first Overflow actions plus a "⋯" menu with the rest. An Action.ID
// then appears twice in the DOM, so prefer targeting by class or a wrapping
// id. In the menu, Variant and Icon do not apply. The page must include
// dropdown.Script (appshell does) for the menu to open.
templ Toolbar(props ...Props) {
	{{
		var p Props
		if len(props) > 0 {
			p = props[0]
		}
		collapse := p.collapses()
	}}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		role="toolbar"
		class={ utils.TwMerge("flex flex-wrap items-center gap-2", p.Class) }
		{ p.Attributes... }
	>
		@side(p.Left, p.overflow(), collapse, dropdown.PlacementBottomStart, "")
		<div class="flex-1 min-w-0 empty:hidden max-md:basis-full max-md:order-last">
			{ children... }
		</div>
		@side(p.Right, p.overflow(), collapse, dropdown.PlacementBottomEnd, "ml-auto")
	</div>
}

// side renders one action group: once when not collapsing, otherwise a
// desktop rendering plus a phone rendering with the overflow menu.
templ side(actions []action.Action, n int, collapse bool, placement dropdown.Placement, class string) {
	if len(actions) > 0 {
		if !collapse {
			<div class={ utils.TwMerge("flex flex-wrap items-center gap-2", class) }>
				@action.Group(actions)
			</div>
		} else {
			<div class={ utils.TwMerge("hidden md:flex flex-wrap items-center gap-2", class) }>
				for _, a := range actions {
					@action.Button(a)
				}
			</div>
			{{ inline, menu := split(actions, n) }}
			<div class={ utils.TwMerge("flex md:hidden items-center gap-2", class) }>
				for _, a := range inline {
					@action.Button(a)
				}
				if len(menu) > 0 {
					@moreMenu(menu, placement)
				}
			</div>
		}
	}
}

// moreMenu renders the "⋯" trigger and its dropdown of surplus actions.
templ moreMenu(menu []action.Action, placement dropdown.Placement) {
	@dropdown.Dropdown() {
		@dropdown.Trigger() {
			@button.Button(button.Props{
				Variant:    button.VariantGhost,
				Size:       button.SizeIcon,
				Attributes: templ.Attributes{"aria-label": "More actions"},
			}) {
				@icon.Ellipsis()
			}
		}
		@dropdown.Content(dropdown.ContentProps{Placement: placement}) {
			for _, a := range menu {
				if a.IsLink() {
					@dropdown.Item(dropdown.ItemProps{Href: a.Href, Disabled: a.Disabled, Attributes: a.Attributes}) {
						{ a.Label }
					}
				} else {
					@dropdown.Item(dropdown.ItemProps{Disabled: a.Disabled, Attributes: action.MenuAttrs(a)}) {
						{ a.Label }
					}
				}
			}
		}
	}
}
