package dashboardgrid

import (
	"fmt"
	"github.com/bplus/webframe/utils"
)

// Props configures Grid. Cols is clamped to [1, 24]. Gap and PageMargin
// take their defaults only when exactly 0. Flush drops the outer padding,
// for a grid inside a container that already insets its content.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Cols       int  // grid columns, default 12
	Gap        int  // gap in pixels, default 16
	PageMargin int  // outer padding in pixels, default 32
	Flush      bool // outer padding 0, overriding PageMargin
}

// SlotProps configures Slot. Both spans are clamped to [1, 12], even when
// the Grid has more than 12 columns.
type SlotProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	ColSpan    int // columns to span, default 12 (full width)
	RowSpan    int // rows to span, default 1
}

// Grid renders a CSS grid for dashboard tiles, typically Slots. Below md it
// collapses to one column via the wf-dashgrid rule in static/css/input.css,
// since a media query cannot otherwise override the inline column count.
templ Grid(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Cols == 0 {
		{{ p.Cols = 12 }}
	}
	{{ p.Cols = clamp(p.Cols, 1, 24) }}
	if p.Gap == 0 {
		{{ p.Gap = 16 }}
	}
	if p.PageMargin == 0 {
		{{ p.PageMargin = 32 }}
	}
	if p.Flush {
		{{ p.PageMargin = 0 }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			utils.TwMerge(
				"w-full wf-dashgrid",
				p.Class,
			),
		}
		style={ fmt.Sprintf("display:grid;grid-template-columns:repeat(%d,1fr);gap:%dpx;padding:%dpx", p.Cols, p.Gap, p.PageMargin) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Slot renders one cell of a Grid spanning ColSpan columns and RowSpan
// rows. Below md it resets to 1x1 (the wf-dashslot rule), matching Grid's
// one-column layout.
templ Slot(props ...SlotProps) {
	{{ var p SlotProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ColSpan == 0 {
		{{ p.ColSpan = 12 }}
	}
	{{ p.ColSpan = clamp(p.ColSpan, 1, 12) }}
	if p.RowSpan == 0 {
		{{ p.RowSpan = 1 }}
	}
	{{ p.RowSpan = clamp(p.RowSpan, 1, 12) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			utils.TwMerge(
				"min-w-0 wf-dashslot",
				p.Class,
			),
		}
		style={ fmt.Sprintf("grid-column:span %d;grid-row:span %d", p.ColSpan, p.RowSpan) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}
