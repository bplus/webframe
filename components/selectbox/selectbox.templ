// templui component selectbox - version: v1.3.0 installed by templui v1.3.0
// 📚 Documentation: https://templui.io/docs/components/select-box
package selectbox

import (
	"context"
	"fmt"
	"github.com/bplus/webframe/components/button"
	"github.com/bplus/webframe/components/icon"
	"github.com/bplus/webframe/components/input"
	"github.com/bplus/webframe/components/popover"
	"github.com/bplus/webframe/utils"
	"strconv"
)

type contextKey string

var contentIDKey contextKey = "contentID"

// Props configures the SelectBox root wrapper. ID seeds the wrapper element's
// id and (as "<ID>-content") the popover content ID; empty means a random ID.
// Multi-select is enabled on TriggerProps.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// TriggerProps configures the Trigger button and its hidden form input.
// Name and Form go on the hidden <input> that carries the selected value.
// Multiple enables multi-select; ShowPills implies Multiple and renders
// selections as pills; SelectedCountText is the multi-select summary with
// "{n}" replaced by the count (default "{n} items selected"). HasError
// applies destructive styling and aria-invalid.
//
// Attributes spread onto the hidden <input> (name, value and any hx-*
// wiring). ButtonAttributes spread last onto the visible <button>, so a
// caller's aria-* attributes land on the focused element and win.
type TriggerProps struct {
	ID                string
	Class             string
	Attributes        templ.Attributes
	ButtonAttributes  templ.Attributes
	Name              string
	Form              string
	Disabled          bool
	HasError          bool
	Multiple          bool
	ShowPills         bool
	SelectedCountText string
}

// ValueProps configures the Value display span. Placeholder is shown until
// a selection is made, and again when it is cleared.
type ValueProps struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Placeholder string
}

// ContentProps configures the Content option panel. NoSearch removes the
// search input; SearchPlaceholder overrides the default "Search...".
type ContentProps struct {
	ID                string
	Class             string
	Attributes        templ.Attributes
	NoSearch          bool
	SearchPlaceholder string
}

// GroupProps configures a Group section (role="group") inside Content.
type GroupProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// LabelProps configures a non-interactive Label heading inside Content.
type LabelProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// ItemProps configures an option Item. Value is the machine value written to
// the hidden input when chosen (children are only the human-readable label).
// Selected marks the initial selection server-side; Disabled makes the option
// inert.
type ItemProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Value      string
	Selected   bool
	Disabled   bool
}

// SelectBox is the root of a custom form select. The expected structure is
// SelectBox > { Trigger > Value, Content > (Group | Label | Item) }, with
// Script rendered once per page.
//
// It passes the content ID to Trigger and Content through the render
// context. Outside a SelectBox they fall back to utils.PairedID, which
// links the n-th Trigger to the n-th Content of the same render.
templ SelectBox(props ...Props) {
	{{
		var p Props
		if len(props) > 0 {
			p = props[0]
		}
		wrapperID := p.ID
		if wrapperID == "" {
			wrapperID = utils.RandomID()
		}
		contentID := fmt.Sprintf("%s-content", wrapperID)
		ctx = context.WithValue(ctx, contentIDKey, contentID)
	}}
	<div
		id={ wrapperID }
		class={ utils.TwMerge("select-container w-full relative", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Trigger renders the button that opens the option panel, holding a hidden
// <input> for the submitted value, the children (typically a Value) and a
// chevron. The hidden input is filled by the script, including from Items
// marked Selected on load, so form submission depends on Script.
templ Trigger(props ...TriggerProps) {
	{{
		var p TriggerProps
		if len(props) > 0 {
			p = props[0]
		}
		contentID, ok := ctx.Value(contentIDKey).(string)
		if !ok {
			var err error
			if contentID, err = utils.PairedID(ctx, "wf-selectbox", "trigger"); err != nil {
				return err
			}
		}
		if p.ShowPills {
			p.Multiple = true
		}
	}}
	@popover.Trigger(popover.TriggerProps{
		For:         contentID,
		TriggerType: popover.TriggerTypeClick,
	}) {
		@button.Button(button.Props{
			ID:      p.ID,
			Type:    "button",
			Variant: button.VariantOutline,
			Class: utils.TwMerge(
				// Required class for JavaScript
				"select-trigger",
				// Base styles matching input
				"w-full h-9 px-3 py-1 text-base md:text-sm",
				"flex items-center justify-between",
				"rounded-md border border-input bg-background shadow-xs transition-[color,box-shadow] outline-none",
				// Dark mode background
				"dark:bg-input/30",
				// Selection styles
				"selection:bg-primary selection:text-primary-foreground",
				// Focus styles
				"focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]",
				// Error/Invalid styles
				"aria-invalid:ring-destructive/20 aria-invalid:border-destructive dark:aria-invalid:ring-destructive/40",
				utils.If(p.HasError, "border-destructive ring-destructive/20 dark:ring-destructive/40"),
				p.Class,
			),
			Disabled: p.Disabled,
			Attributes: triggerButtonAttrs(p, contentID),
		}) {
			<input
				type="hidden"
				if p.Name != "" {
					name={ p.Name }
				}
				if p.Form != "" {
					form={ p.Form }
				}
				data-tui-selectbox-hidden-input
				{ p.Attributes... }
			/>
			{ children... }
			<span class="pointer-events-none ml-1">
				@icon.ChevronDown(icon.Props{
					Size:  16,
					Class: "text-muted-foreground",
				})
			</span>
		}
	}
}

// triggerButtonAttrs builds the <button>'s attributes: the script's
// configuration, aria-invalid="true" only when HasError, then
// ButtonAttributes merged last so a caller's values win.
func triggerButtonAttrs(p TriggerProps, contentID string) templ.Attributes {
	attrs := templ.Attributes{
		"data-tui-selectbox-content-id":          contentID,
		"data-tui-selectbox-multiple":            strconv.FormatBool(p.Multiple),
		"data-tui-selectbox-show-pills":          strconv.FormatBool(p.ShowPills),
		"data-tui-selectbox-selected-count-text": p.SelectedCountText,
		"tabindex":                               "0",
	}
	if p.HasError {
		attrs["aria-invalid"] = "true"
	}
	return utils.MergeAttributes(attrs, p.ButtonAttributes)
}

// Value renders the span inside Trigger that displays the current
// selection, starting with Placeholder. The script finds it by its
// "select-value" class, so render exactly one per Trigger.
templ Value(props ...ValueProps) {
	{{ var p ValueProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("block truncate select-value text-muted-foreground", p.Class) }
		if p.Placeholder != "" {
			data-tui-selectbox-placeholder={ p.Placeholder }
		}
		{ p.Attributes... }
	>
		if p.Placeholder != "" {
			{ p.Placeholder }
		}
		{ children... }
	</span>
}

// Content renders the option panel (role="listbox") below the trigger and
// as wide as it, with an optional search input and a scrolling region for
// the Items, Groups and Labels. With search present, the script handles
// Escape itself (from an item it refocuses search; from search it closes).
// The element's id comes from the enclosing SelectBox; ContentProps.ID is
// not applied.
templ Content(props ...ContentProps) {
	{{
		var p ContentProps
		if len(props) > 0 {
			p = props[0]
		}
		contentID, ok := ctx.Value(contentIDKey).(string)
		if !ok {
			var err error
			if contentID, err = utils.PairedID(ctx, "wf-selectbox", "content"); err != nil {
				return err
			}
		}
	}}
	@popover.Content(popover.ContentProps{
		ID:         contentID,
		Placement:  popover.PlacementBottomStart,
		Offset:     4,
		MatchWidth: true,
		DisableESC: !p.NoSearch,
		Class: utils.TwMerge(
			"p-1 select-content z-50 overflow-hidden rounded-md border bg-popover text-popover-foreground shadow-md",
			"min-w-[var(--popover-trigger-width)] w-[var(--popover-trigger-width)]",
			p.Class,
		),
		Attributes: utils.MergeAttributes(
			templ.Attributes{
				"role":     "listbox",
				"tabindex": "-1",
			},
			p.Attributes,
		),
		Exclusive: true,
	}) {
		if !p.NoSearch {
			<div class="sticky top-0 bg-popover p-1">
				<div class="relative">
					<span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground z-10 pointer-events-none">
						@icon.Search(icon.Props{Size: 16})
					</span>
					@input.Input(input.Props{
						Type:        input.TypeSearch,
						Class:       "pl-8",
						Placeholder: utils.IfElse(p.SearchPlaceholder != "", p.SearchPlaceholder, "Search..."),
						Attributes: templ.Attributes{
							"data-tui-selectbox-search": "",
						},
					})
				</div>
			</div>
		}
		<div class="max-h-[300px] overflow-y-auto">
			{ children... }
		</div>
	}
}

// Group clusters related Items inside Content under role="group".
templ Group(props ...GroupProps) {
	{{ var p GroupProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("p-1", p.Class) }
		role="group"
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Label renders a non-interactive heading for a Group of options.
templ Label(props ...LabelProps) {
	{{ var p LabelProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("px-2 py-1.5 text-sm font-medium", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

// Item renders one option (role="option"): children as the label plus a
// check icon shown when Selected. Value must be non-empty and unique within
// the SelectBox, and must not contain a comma, because multi-select joins
// values with commas.
templ Item(props ...ItemProps) {
	{{ var p ItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			utils.TwMerge(
				"select-item relative flex w-full cursor-default select-none items-center rounded-sm py-1.5 px-2 text-sm font-light outline-none",
				"hover:bg-accent hover:text-accent-foreground",
				"focus:bg-accent focus:text-accent-foreground",
				utils.If(p.Selected, "bg-accent text-accent-foreground"),
				utils.If(p.Disabled, "pointer-events-none opacity-50"),
				p.Class,
			),
		}
		role="option"
		data-tui-selectbox-value={ p.Value }
		data-tui-selectbox-selected={ strconv.FormatBool(p.Selected) }
		data-tui-selectbox-disabled={ strconv.FormatBool(p.Disabled) }
		tabindex="0"
		{ p.Attributes... }
	>
		<span class="truncate select-item-text">
			{ children... }
		</span>
		<span
			class={
				utils.TwMerge(
					"select-check absolute right-2 flex h-3.5 w-3.5 items-center justify-center",
					utils.IfElse(p.Selected, "opacity-100", "opacity-0"),
				),
			}
		>
			@icon.Check(icon.Props{Size: 16})
		</span>
	</div>
}

// Script emits the deferred script tag for selectbox.min.js, which handles
// selection, search, keyboard navigation, pills and the hidden input, and
// also initializes selectboxes swapped in by htmx. Include it once per page
// that renders a SelectBox.
templ Script() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/static/js/selectbox.min.js") }></script>
}
