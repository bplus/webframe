package action

import "github.com/bplus/webframe/components/button"

// Button renders an Action as an <a> when it is a plain link (see
// IsLink), otherwise as a <button>, with Icon before the Label.
templ Button(a Action) {
	@button.Button(a.buttonProps()) {
		if a.Icon != nil {
			@a.Icon
		}
		<span>{ a.Label }</span>
	}
}

// Group renders actions as a wrapping inline row.
templ Group(actions []Action) {
	<div class="flex flex-wrap items-center gap-2">
		for _, a := range actions {
			@Button(a)
		}
	</div>
}
