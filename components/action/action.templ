package action

import "github.com/bplus/webframe/components/button"

// Button renders one Action as an <a> (plain link) or a <button>
// (anything with Hx* attributes, or no Href), with optional Icon
// before the Label.
templ Button(a Action) {
	@button.Button(a.buttonProps()) {
		if a.Icon != nil {
			@a.Icon
		}
		<span>{ a.Label }</span>
	}
}

// Group renders actions as an inline row with a gap-2 gap, in order.
templ Group(actions []Action) {
	<div class="flex flex-wrap items-center gap-2">
		for _, a := range actions {
			@Button(a)
		}
	</div>
}
