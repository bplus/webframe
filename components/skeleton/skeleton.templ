// Package skeleton renders loading placeholders: grey pulsing bars in the
// shape of the content they stand in for, so a region that is still loading
// holds its final size and nothing moves when the real content arrives.
//
// Every skeleton is the same height as the component it replaces: Table
// matches a non-dense datatable, Tile a stattile, Card a panel with a title
// and three-line body, and Lines a text-sm paragraph. Pick the one whose
// real counterpart will be swapped in.
//
// Every root carries aria-busy="true", the bars are aria-hidden, and one
// screen-reader-only "Loading…" text names the state.
package skeleton

import (
	"github.com/bplus/webframe/components/datatable"
	"github.com/bplus/webframe/components/table"
	"github.com/bplus/webframe/utils"
)

// Props configures a skeleton root: optional element ID, extra Tailwind
// classes merged via utils.TwMerge, and arbitrary attributes spread last.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// bar is the single decorative placeholder bar; every skeleton is built
// from it. It is aria-hidden because it carries no information.
const bar = "rounded bg-muted animate-pulse"


// loading is the one sr-only text every skeleton root contains.
templ loading() {
	<span class="sr-only">Loading…</span>
}

func first(props []Props) Props {
	if len(props) > 0 {
		return props[0]
	}
	return Props{}
}

// Lines renders n bars at the line pitch of a text-sm paragraph, the last
// one shorter. n below 1 renders one bar. Prefer Card, Table or Tile when
// the real shape is one of those.
templ Lines(n int, props ...Props) {
	{{
		p := first(props)
		if n < 1 {
			n = 1
		}
	}}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("space-y-1", p.Class) }
		aria-busy="true"
		{ p.Attributes... }
	>
		@loading()
		for i := 0; i < n; i++ {
			<div aria-hidden="true" class={ utils.TwMerge("h-4", bar, utils.If(i == n-1, "w-2/3")) }></div>
		}
	</div>
}

// Card renders a panel-shaped block the height of a panel.Panel with a
// Title and three lines of body.
templ Card(props ...Props) {
	{{ p := first(props) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("rounded-lg border border-border bg-card", p.Class) }
		aria-busy="true"
		{ p.Attributes... }
	>
		@loading()
		<div aria-hidden="true" class="px-4 py-3">
			<div class={ utils.TwMerge("h-4 w-1/3", bar) }></div>
		</div>
		<div aria-hidden="true" class="space-y-2 p-4">
			<div class={ utils.TwMerge("h-4", bar) }></div>
			<div class={ utils.TwMerge("h-4", bar) }></div>
			<div class={ utils.TwMerge("h-4 w-2/3", bar) }></div>
		</div>
	</div>
}

// Table renders a table.Table of bars with cols columns and rows body rows,
// each row the height of a non-dense datatable row. rows or cols below 1
// render as 1. The "Loading…" text is the table's caption.
templ Table(rows, cols int, props ...Props) {
	{{
		p := first(props)
		if rows < 1 {
			rows = 1
		}
		if cols < 1 {
			cols = 1
		}
		attrs := templ.Attributes{"aria-busy": "true"}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@table.Table(table.Props{ID: p.ID, Class: p.Class, Attributes: attrs}) {
		<caption class="sr-only">Loading…</caption>
		@table.Header(table.Props{Attributes: templ.Attributes{"aria-hidden": "true"}}) {
			@table.Row(table.RowProps{Class: "hover:bg-transparent"}) {
				for c := 0; c < cols; c++ {
					@table.Head(table.CellProps{Class: datatable.PhoneCellPad}) {
						<div class={ utils.TwMerge("h-4 w-20 max-w-full", bar) }></div>
					}
				}
			}
		}
		@table.Body(table.Props{Attributes: templ.Attributes{"aria-hidden": "true"}}) {
			for r := 0; r < rows; r++ {
				@table.Row(table.RowProps{Class: "hover:bg-transparent"}) {
					for c := 0; c < cols; c++ {
						@table.Cell(table.CellProps{Class: datatable.PhoneCellPad}) {
							<div class={ utils.TwMerge("h-5", bar, utils.IfElse(c == 0, "w-3/4", "w-1/2")) }></div>
						}
					}
				}
			}
		}
	}
}

// Tile renders the shape of a stattile.StatTile with Label, Value, Delta
// and Sub set and no Spark or Ring.
templ Tile(props ...Props) {
	{{ p := first(props) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("block rounded-lg border border-border bg-card p-4 min-h-24", p.Class) }
		aria-busy="true"
		{ p.Attributes... }
	>
		@loading()
		<div aria-hidden="true">
			<div class={ utils.TwMerge("mb-1.5 h-4 w-16", bar) }></div>
			<div class="flex items-end gap-2">
				<div class={ utils.TwMerge("h-7 w-24", bar) }></div>
				<div class={ utils.TwMerge("h-4 w-10", bar) }></div>
			</div>
			<div class={ utils.TwMerge("mt-1.5 h-4 w-32 max-w-full", bar) }></div>
		</div>
	</div>
}
