package hovercard

import (
	"strings"

	"github.com/bplus/webframe/components/popover"
)

// MetaRow is a key-value pair displayed in the hover card metadata section.
type MetaRow struct {
	Label string
	Value string
}

// Props configures Hover. ID is required and must be unique on the page:
// it is the only thing binding the trigger to the card.
type Props struct {
	ID          string            // unique ID for popover binding
	Title       string            // main heading
	Category    string            // small kicker text above title (e.g. "Product", "User", "Article")
	Description string            // body text
	Meta        []MetaRow         // key-value metadata rows
	Icon        templ.Component   // optional art beside the copy (e.g. a components/icon icon); nil means no icon panel
	Link        string            // optional link URL at bottom
	LinkText    string            // link label (default: "View details →")
	Placement   popover.Placement // card placement; zero value means popover.PlacementBottomStart
}

// Hover renders a preview card (kicker, title, description, meta rows,
// optional link and icon panel) shown while the user hovers its children.
// It is a popover.Trigger plus popover.Content, so it needs popover.Script
// on the page; the card is exclusive, closing other open popovers. Empty
// Title, Description and LinkText render placeholder text. Link is
// URL-sanitized.
//
// The default placement is below the trigger: the trigger is full width,
// so a sideways placement has no room to flip into. The card's height is
// capped to the space popover.min.js reports and scrolls inside, so it
// never extends past a phone viewport.
templ Hover(props Props) {
	{{ placement := props.Placement }}
	if placement == "" {
		{{ placement = popover.PlacementBottomStart }}
	}
	@popover.Trigger(popover.TriggerProps{For: props.ID, TriggerType: popover.TriggerTypeHover, Class: "block w-full"}) {
		{ children... }
	}
	@popover.Content(popover.ContentProps{
		ID:        props.ID,
		Placement: placement,
		ShowArrow: true,
		// 120ms grace period on both edges: enough time for the pointer to
		// cross the gap between trigger and card without the hover closing,
		// but short enough that intent to leave still feels immediate.
		HoverDelay:    120,
		HoverOutDelay: 120,
		Exclusive:     true,
		Class:         "wf-hover-pop",
	}) {
		// popover.min.js writes the height available on the final side to
		// --wf-pop-max; the shell is capped to that (minus the 1px borders)
		// and scrolls inside. 70vh applies before the script has run.
		<div
			class={ "wf-hover-shell", templ.KV("wf-hover-shell--with-art", props.Icon != nil) }
			style="max-height:calc(min(var(--wf-pop-max, 70vh), 100vh - 20px) - 2px);overflow-y:auto"
		>
			<div class="wf-hover-copy">
				if strings.TrimSpace(props.Category) != "" {
					<div class="wf-hover-kicker">{ props.Category }</div>
				}
				<h3 class="wf-hover-title">{ safe(props.Title, "Untitled") }</h3>
				<p class="wf-hover-description">{ safe(props.Description, "No description.") }</p>
				if len(props.Meta) > 0 {
					<div class="wf-hover-meta">
						for _, row := range props.Meta {
							<div class="wf-hover-row">
								<span>{ row.Label }</span>
								<strong>{ row.Value }</strong>
							</div>
						}
					</div>
				}
				if strings.TrimSpace(props.Link) != "" {
					<a href={ props.Link } class="wf-hover-link">
						{ safe(props.LinkText, "View details →") }
					</a>
				}
			</div>
			if props.Icon != nil {
				<div class="wf-hover-art">
					<div class="wf-hover-icon">
						@props.Icon
					</div>
				</div>
			}
		</div>
	}
}

func safe(value, fallback string) string {
	if strings.TrimSpace(value) == "" {
		return fallback
	}
	return value
}
