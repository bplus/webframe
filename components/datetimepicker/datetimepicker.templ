package datetimepicker

import (
	"github.com/bplus/webframe/components/input"
	"github.com/bplus/webframe/utils"
)

// schemeClass sets color-scheme so the native picker icon follows the
// theme. The theme switches on [data-theme=dark], not prefers-color-scheme,
// so the input component's dark: utilities do not reach it.
const schemeClass = "scheme-light [[data-theme=dark]_&]:scheme-dark"

// DateTimePicker renders the native date, datetime-local or time input for
// p.Kind. It needs no script.
templ DateTimePicker(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	@input.Input(input.Props{
		ID:         p.ControlID(),
		Class:      utils.TwMerge(schemeClass, p.Class),
		Attributes: p.attributes(),
		Name:       p.Name,
		Type:       p.inputType(),
		Value:      p.value(),
		Disabled:   p.Disabled,
	})
}
