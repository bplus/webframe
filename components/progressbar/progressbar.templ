package progressbar

import (
	"fmt"
	"github.com/bplus/webframe/utils"
)

// Props configures a ProgressBar. The fill is Value*100/Max, truncated and
// clamped to [0, 100], with Max <= 0 treated as 100. Color is a Tailwind
// background class ("bg-primary" when empty), not a CSS color.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Value      int    // 0-100
	Max        int    // default 100
	Color      string // Tailwind bg class, e.g. "bg-primary"
	Label      string // optional text label
	ShowValue  bool   // show percentage text
}

// ProgressBar renders a horizontal progress track with a colored fill and
// an optional label and percentage row. The shown percentage always matches
// the fill.
templ ProgressBar(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("w-full", p.Class) }
		{ p.Attributes... }
	>
		if p.Label != "" || p.ShowValue {
			<div class="flex justify-between items-center mb-1">
				if p.Label != "" {
					<span class="text-sm text-muted-foreground">{ p.Label }</span>
				}
				if p.ShowValue {
					<span class="text-sm font-medium text-foreground">{ fmt.Sprintf("%d%%", clampPercent(p.Value, p.Max)) }</span>
				}
			</div>
		}
		<div class="w-full bg-muted rounded-full h-2.5 overflow-hidden">
			<div
				class={ utils.TwMerge("h-full rounded-full transition-all", utils.IfElse(p.Color != "", p.Color, "bg-primary")) }
				style={ fmt.Sprintf("width: %d%%", clampPercent(p.Value, p.Max)) }
			></div>
		</div>
	</div>
}
