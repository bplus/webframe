package emptystate

import "github.com/bplus/webframe/utils"

type Props struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Icon        string // Optional: icon name or emoji to display
	Title       string // Required: e.g., "No nodes found"
	Description string // Optional: e.g., "Try adjusting your search filters"
}

templ EmptyState(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			utils.TwMerge(
				"flex flex-col items-center justify-center py-12 px-4 text-center",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		if p.Icon != "" {
			<div class="mb-3 text-4xl text-muted-foreground">
				{ p.Icon }
			</div>
		}
		if p.Title != "" {
			<h3 class="text-lg font-semibold text-foreground">
				{ p.Title }
			</h3>
		}
		if p.Description != "" {
			<p class="mt-1 text-sm text-muted-foreground max-w-sm">
				{ p.Description }
			</p>
		}
		<div class="mt-4">
			{ children... }
		</div>
	</div>
}
