package emptystate

import (
	"github.com/bplus/webframe/components/action"
	"github.com/bplus/webframe/utils"
)

// Props configures EmptyState. Icon, Title and Description each render
// only when non-empty. Icon is text (an emoji or glyph), not an icon
// component.
type Props struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	Icon        string
	Title       string // e.g. "No results"
	Description string // e.g. "Try adjusting your search filters"
	// Action, when non-nil, renders as an action.Button before any
	// children, e.g. "Clear filters" or "Create item".
	Action *action.Action
}

// EmptyState renders a centered placeholder for empty lists, search
// results or panels: icon over title over description, then Action and any
// children. The wrapper below the text is always emitted, so it leaves a
// small gap even when empty.
templ EmptyState(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			utils.TwMerge(
				"flex flex-col items-center justify-center py-12 px-4 text-center",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		if p.Icon != "" {
			<div class="mb-3 text-4xl text-muted-foreground">
				{ p.Icon }
			</div>
		}
		if p.Title != "" {
			<h3 class="text-lg font-semibold text-foreground">
				{ p.Title }
			</h3>
		}
		if p.Description != "" {
			<p class="mt-1 text-sm text-muted-foreground max-w-sm">
				{ p.Description }
			</p>
		}
		<div class="mt-4">
			if p.Action != nil {
				@action.Button(*p.Action)
			}
			{ children... }
		</div>
	</div>
}
