// Package lifecyclestepper renders a generic horizontal wizard-dot
// progress bar: an ordered row of stage nodes joined by connector
// lines. It carries no domain-specific naming or assumptions beyond
// "ordered stages with states" — callers decide what the stages mean
// (a task lifecycle, a checkout flow, an approval chain, etc).
package lifecyclestepper

import (
	"fmt"

	"github.com/bplus/webframe/utils"
)

// State is the status of one LifecycleStepper node. The empty value and
// any unrecognized State render like StateFuture.
type State string

const (
	// StateDone marks a stage that completed successfully: a filled
	// success-green circle with a check mark in the success foreground.
	StateDone State = "done"
	// StateActive marks the stage currently in progress: a filled
	// primary circle with a center dot in the primary foreground.
	StateActive State = "active"
	// StateAttn marks a stage waiting on the operator: a filled amber
	// circle with an exclamation mark in the warning foreground.
	StateAttn State = "attn"
	// StateFailed marks a stage that errored: a filled red circle
	// with an X in the destructive foreground.
	StateFailed State = "failed"
	// StateFuture marks a stage not yet reached: a card-colored circle with
	// a grey border showing the stage's 1-based index.
	StateFuture State = "future"
	// StateSkipped marks a stage that was deliberately bypassed: a
	// card-colored circle with a dashed grey border showing an en dash.
	// Connectors touching a skipped node are grey, so a fully green bar
	// means every stage actually ran.
	StateSkipped State = "skipped"
)

// Theme-token colors for the state palette, so the stepper follows the
// active theme.
const (
	colorDoneGreen  = "var(--color-success)"          // done circle fill, done->done connectors
	colorAttnAmber  = "var(--color-warning)"          // attn circle fill
	colorNodeBorder = "var(--color-border)"           // future/skipped circle border
	colorMutedIcon  = "var(--color-muted-foreground)" // future index digit / skipped en dash
	colorMutedLabel = "var(--color-muted-foreground)" // future/skipped label text
)

const (
	colorActivePurple = "var(--color-primary)"
	colorFailedRed     = "var(--color-destructive)"
	colorConnectorOff  = "var(--color-border)"
)

// Step is one node in a LifecycleStepper row. When PopoverURL is set the
// node is a button with hx-get=PopoverURL, hx-target=PopoverTarget (when
// set) and hx-swap="innerHTML", for example to load a per-stage detail
// popover; otherwise it is a plain <div>. Title, when set, is the node's
// title attribute.
type Step struct {
	Label         string
	State         State
	PopoverURL    string
	PopoverTarget string
	Title         string
}

// circleStyle returns the inline CSS for the node's circle: a filled
// background for done/active/attn/failed, or a bordered card-colored circle
// (dashed for skipped, solid otherwise) for future/skipped/unknown.
func (s Step) circleStyle() string {
	switch s.State {
	case StateDone:
		return fmt.Sprintf("background-color:%s;border:none", colorDoneGreen)
	case StateActive:
		return fmt.Sprintf("background-color:%s;border:none", colorActivePurple)
	case StateAttn:
		return fmt.Sprintf("background-color:%s;border:none", colorAttnAmber)
	case StateFailed:
		return fmt.Sprintf("background-color:%s;border:none", colorFailedRed)
	case StateSkipped:
		return fmt.Sprintf("background-color:var(--color-card);border:1.5px dashed %s", colorNodeBorder)
	default: // StateFuture and any unrecognized State
		return fmt.Sprintf("background-color:var(--color-card);border:1.5px solid %s", colorNodeBorder)
	}
}

// labelStyle returns the inline CSS for the node's label text:
// semibold for active, attn and failed, medium otherwise.
func (s Step) labelStyle() string {
	switch s.State {
	case StateDone:
		return fmt.Sprintf("color:%s;font-weight:500", colorDoneGreen)
	case StateActive:
		return fmt.Sprintf("color:%s;font-weight:600", colorActivePurple)
	case StateAttn:
		return fmt.Sprintf("color:%s;font-weight:600", colorAttnAmber)
	case StateFailed:
		return fmt.Sprintf("color:%s;font-weight:600", colorFailedRed)
	default: // StateFuture, StateSkipped, and any unrecognized State
		return fmt.Sprintf("color:%s;font-weight:500", colorMutedLabel)
	}
}

// connectorColor returns the connector line color between two adjacent
// nodes: green only when both are StateDone, grey otherwise.
func connectorColor(a, b State) string {
	if a == StateDone && b == StateDone {
		return colorDoneGreen
	}
	return colorConnectorOff
}

// sizeConfig holds the dimensions that differ between the compact and
// large stepper variants.
type sizeConfig struct {
	dot       int    // circle diameter, px
	labelFont string // label font-size, CSS length
	connector int    // connector line width, px
	gap       int    // dot-to-label gap, px
}

var (
	compactSize = sizeConfig{dot: 22, labelFont: "12.5px", connector: 26, gap: 7}
	largeSize   = sizeConfig{dot: 26, labelFont: "13.5px", connector: 34, gap: 8}
)

// nodeIcon renders the fixed 12x12 glyph inside a node's circle: a
// check for done, a center dot for active, an exclamation mark for
// attn, an X for failed, and mono-font text (the 1-based index, or an
// en dash for skipped) for future/skipped/unknown. The glyph is a
// fixed real-pixel size regardless of Props.Large; only the
// surrounding circle grows.
templ nodeIcon(s State, index int) {
	switch s {
		case StateDone:
			<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M2.5 6.5L5 9L9.5 3.5" class="stroke-success-foreground" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		case StateActive:
			<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
				<circle cx="6" cy="6" r="2.4" class="fill-primary-foreground"></circle>
			</svg>
		case StateAttn:
			<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M6 3v3.6" class="stroke-warning-foreground" stroke-width="1.8" stroke-linecap="round"></path>
				<circle cx="6" cy="9" r="1" class="fill-warning-foreground"></circle>
			</svg>
		case StateFailed:
			<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M3.5 3.5L8.5 8.5" class="stroke-destructive-foreground" stroke-width="1.8" stroke-linecap="round"></path>
				<path d="M8.5 3.5L3.5 8.5" class="stroke-destructive-foreground" stroke-width="1.8" stroke-linecap="round"></path>
			</svg>
		case StateSkipped:
			<span style={ fmt.Sprintf("font-family:var(--font-mono);font-size:11px;line-height:1;color:%s", colorMutedIcon) }>&ndash;</span>
		default: // StateFuture and any unrecognized State
			<span style={ fmt.Sprintf("font-family:var(--font-mono);font-size:11px;line-height:1;color:%s", colorMutedIcon) }>{ fmt.Sprintf("%d", index) }</span>
	}
}

// stepperNode renders one step: a circle holding nodeIcon with the label
// inline to its right, as a button or a <div> (see Step).
templ stepperNode(step Step, index int, sz sizeConfig) {
	{{ circle := fmt.Sprintf("width:%dpx;height:%dpx;border-radius:9999px;display:flex;align-items:center;justify-content:center;flex-shrink:0;%s", sz.dot, sz.dot, step.circleStyle()) }}
	{{ label := fmt.Sprintf("font-size:%s;letter-spacing:0.01em;white-space:nowrap;%s", sz.labelFont, step.labelStyle()) }}
	{{ node := fmt.Sprintf("display:flex;align-items:center;gap:%dpx;flex-shrink:0", sz.gap) }}
	if step.PopoverURL != "" {
		<button
			type="button"
			if step.Title != "" {
				title={ step.Title }
			}
			hx-get={ step.PopoverURL }
			if step.PopoverTarget != "" {
				hx-target={ step.PopoverTarget }
			}
			hx-swap="innerHTML"
			style={ node }
			class="bg-transparent border-0 p-0 m-0 cursor-pointer"
		>
			<span style={ circle }>
				@nodeIcon(step.State, index)
			</span>
			<span style={ label }>{ step.Label }</span>
		</button>
	} else {
		<div
			if step.Title != "" {
				title={ step.Title }
			}
			style={ node }
		>
			<span style={ circle }>
				@nodeIcon(step.State, index)
			</span>
			<span style={ label }>{ step.Label }</span>
		</div>
	}
}

// stepperConnector renders one connector segment: a horizontal 1.5px
// line of the given width and color. The row is align-items:center, so
// it sits on the dots' midline with no extra wrapper.
templ stepperConnector(color string, width int) {
	<span style={ fmt.Sprintf("width:%dpx;height:1.5px;background-color:%s;display:block;flex-shrink:0", width, color) }></span>
}

// columnGap is the space in px between a connector and the nodes beside it.
const columnGap = 8

// stepper renders the shared markup for both size variants. Each step is one
// unit, the connector from the previous step followed by the node, so a
// connector always wraps together with the node it leads to. The row is
// shifted left by one connector plus its gap and the root clips that
// margin: the connector that would start a wrapped row is hidden there, and
// the first step carries an empty placeholder of the same width so the
// first row lines up with the others. The root's 3px padding keeps a
// focused node's ring visible.
templ stepper(p Props, sz sizeConfig) {
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("inline-block max-w-full", p.Class) }
		style="overflow:hidden;padding:3px"
		{ p.Attributes... }
	>
		<div style={ fmt.Sprintf("display:flex;flex-wrap:wrap;align-items:center;gap:12px %dpx;margin-left:-%dpx", columnGap, sz.connector+columnGap) }>
			for i, step := range p.Steps {
				<div data-wf-step style={ fmt.Sprintf("display:flex;align-items:center;gap:%dpx;flex-shrink:0", columnGap) }>
					if i == 0 {
						<span aria-hidden="true" style={ fmt.Sprintf("width:%dpx;flex-shrink:0", sz.connector) }></span>
					} else {
						@stepperConnector(connectorColor(p.Steps[i-1].State, step.State), sz.connector)
					}
					@stepperNode(step, i+1, sz)
				</div>
			}
		</div>
	</div>
}

// Props configures a LifecycleStepper. Steps render in order with a
// connector between each pair; an empty Steps renders an empty row. Large
// selects the larger size variant.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Steps      []Step
	Large      bool // expanded size variant; default is compact
}

// LifecycleStepper renders a horizontal row of stage nodes joined by
// connector lines. On a narrow screen the row wraps between steps, and a
// wrapped row starts with a node, never with a connector. It takes no
// children and emits no script.
templ LifecycleStepper(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Large {
		@stepper(p, largeSize)
	} else {
		@stepper(p, compactSize)
	}
}
