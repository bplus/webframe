package metricring

import (
	"fmt"
	"github.com/bplus/webframe/utils"
	"math"
)

// Props configures MetricRing; pass it as the single optional argument. The
// zero value renders an 80px ring at 0% labeled "0%": Size defaults to 80 when
// <= 0, Value is clamped to [0, 100] before any use, Label defaults to the
// clamped value formatted as "N%", Color defaults to "var(--color-primary)",
// and TrackColor to "var(--color-muted)". Custom Color/TrackColor values pass
// through utils.SanitizeColor.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Value      int    // 0-100 percentage
	Label      string // Center label text (e.g. "75%")
	Size       int    // Diameter in px (default 80)
	Color      string // Ring color (Tailwind-compatible, default "var(--color-primary)")
	TrackColor string // Background track color (default "var(--color-muted)")
}

func (p Props) resolveSize() int {
	if p.Size > 0 {
		return p.Size
	}
	return 80
}

func (p Props) resolveColor() string {
	if p.Color != "" {
		return utils.SanitizeColor(p.Color)
	}
	return "var(--color-primary)"
}

func (p Props) resolveTrackColor() string {
	if p.TrackColor != "" {
		return utils.SanitizeColor(p.TrackColor)
	}
	return "var(--color-muted)"
}

func clamp(v, lo, hi int) int {
	if v < lo {
		return lo
	}
	if v > hi {
		return hi
	}
	return v
}

func circumference(radius int) int {
	return int(math.Round(2 * math.Pi * float64(radius)))
}

// MetricRing renders a circular progress gauge as an inline SVG — a fixed
// 6px-wide track circle with a partial colored arc over it and a centered text
// label — for at-a-glance percentage KPIs (disk usage, completion, scores).
//
// Accepts zero or one Props: called with no arguments it uses the zero value,
// and any Props beyond the first are ignored. Value is clamped to [0, 100]
// before both the arc and the default label are computed, so out-of-range
// input renders as an empty or full ring rather than overflowing. The arc
// starts at twelve o'clock (a -90deg CSS rotation on the SVG) and sweeps
// clockwise via stroke-dasharray. An explicit Label replaces the default "N%"
// text verbatim and is not derived from Value.
//
// Returns a templ.Component that renders a fixed-size <div> wrapping the
// <svg> and an absolutely positioned label span.
//
// @pure
// @complexity O(1)
// @invariant the rendered arc covers clamp(Value, 0, 100) percent of the ring
// circumference regardless of the raw Value passed in
templ MetricRing(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ size := p.resolveSize() }}
	{{ pct := clamp(p.Value, 0, 100) }}
	{{ color := p.resolveColor() }}
	{{ track := p.resolveTrackColor() }}
	{{ labelText := p.Label }}
	if labelText == "" {
		{{ labelText = fmt.Sprintf("%d%%", pct) }}
	}
	{{ radius := size/2 - 6 }}
	{{ circ := circumference(radius) }}
	{{ dashLen := circ * pct / 100 }}
	{{ gapLen := circ - dashLen }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("relative inline-flex items-center justify-center", p.Class) }
		style={ fmt.Sprintf("width: %dpx; height: %dpx", size, size) }
		{ p.Attributes... }
	>
		<svg
			width={ fmt.Sprintf("%d", size) }
			height={ fmt.Sprintf("%d", size) }
			viewBox={ fmt.Sprintf("0 0 %d %d", size, size) }
			class="transform -rotate-90"
		>
			<circle
				cx={ fmt.Sprintf("%d", size/2) }
				cy={ fmt.Sprintf("%d", size/2) }
				r={ fmt.Sprintf("%d", radius) }
				fill="none"
				stroke={ track }
				stroke-width="6"
			/>
			<circle
				cx={ fmt.Sprintf("%d", size/2) }
				cy={ fmt.Sprintf("%d", size/2) }
				r={ fmt.Sprintf("%d", radius) }
				fill="none"
				stroke={ color }
				stroke-width="6"
				stroke-dasharray={ fmt.Sprintf("%d %d", dashLen, gapLen) }
				stroke-linecap="round"
			/>
		</svg>
		<span class="absolute text-sm font-bold text-foreground">{ labelText }</span>
	</div>
}
