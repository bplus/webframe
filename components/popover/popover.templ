// templui component popover - version: v1.3.0 installed by templui v1.3.0
// 📚 Documentation: https://templui.io/docs/components/popover
package popover

import (
	"github.com/bplus/webframe/utils"
	"strconv"
)

// Placement selects which side of the trigger the popover content is
// positioned on, with optional -start/-end alignment along that side. The
// zero value ("") is treated as PlacementBottom by Content.
type Placement string

// Placement values accepted by ContentProps.Placement.
const (
	PlacementTop         Placement = "top"
	PlacementTopStart    Placement = "top-start"
	PlacementTopEnd      Placement = "top-end"
	PlacementRight       Placement = "right"
	PlacementRightStart  Placement = "right-start"
	PlacementRightEnd    Placement = "right-end"
	PlacementBottom      Placement = "bottom"
	PlacementBottomStart Placement = "bottom-start"
	PlacementBottomEnd   Placement = "bottom-end"
	PlacementLeft        Placement = "left"
	PlacementLeftStart   Placement = "left-start"
	PlacementLeftEnd     Placement = "left-end"
)

// TriggerType selects how the popover opens: on click (toggle) or on hover.
// The zero value ("") is treated as TriggerTypeClick by Trigger.
type TriggerType string

// TriggerType values accepted by TriggerProps.TriggerType.
const (
	TriggerTypeHover TriggerType = "hover"
	TriggerTypeClick TriggerType = "click"
)

// TriggerProps configures a popover Trigger. Unlike dialog/slideover, there
// is no root wrapper or context inheritance: For is the only link to the
// Content and should always be set to the matching ContentProps.ID (a
// zero-value TriggerProps renders a trigger bound to nothing).
type TriggerProps struct {
	ID          string
	Class       string
	Attributes  templ.Attributes
	For         string      // ID of the Content this trigger opens (required for wiring)
	TriggerType TriggerType // "" = TriggerTypeClick
}

// ContentProps configures the popover Content panel. ID is the binding key
// that Trigger.For must reference; all other fields tune positioning and
// dismissal behavior and are serialized into data-tui-popover-* attributes
// consumed by popover.min.js.
type ContentProps struct {
	ID               string // binding key; must match the Trigger's For and be page-unique
	Class            string
	Attributes       templ.Attributes
	Placement        Placement // "" = PlacementBottom
	Offset           int       // px gap from trigger; 0 = default (8 with arrow, 4 without)
	DisableClickAway bool
	DisableESC       bool
	ShowArrow        bool // render a rotated-square arrow pointing at the trigger
	HoverDelay       int  // ms before opening on hover (hover triggers)
	HoverOutDelay    int  // ms before closing after hover leaves (hover triggers)
	MatchWidth       bool // expose the trigger's width as --popover-trigger-width for sizing
	Exclusive        bool // auto-close this popover whenever another popover opens
}

// Trigger wraps children so hovering or clicking them opens the Content
// whose ID equals For. There is no root wrapper in this package: the ID
// link is the only connection, and a Trigger with an empty For opens
// nothing.
templ Trigger(props ...TriggerProps) {
	{{ var p TriggerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.TriggerType == "" {
		{{ p.TriggerType = TriggerTypeClick }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("group cursor-pointer", p.Class) }
		if p.For != "" {
			data-tui-popover-trigger={ p.For }
		}
		data-tui-popover-open="false"
		data-tui-popover-type={ string(p.TriggerType) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

// Content renders the floating panel a Trigger opens, initially hidden and
// positioned relative to the trigger by the script. While open, the script
// sets --wf-pop-max to the height available on the chosen side, so children
// that must stay in the viewport can cap themselves with it.
//
// ID must be non-empty, unique on the page and referenced by a Trigger's
// For; there is no generated fallback.
templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Placement == "" {
		{{ p.Placement = PlacementBottom }}
	}
	if p.Offset == 0 {
		if p.ShowArrow {
			{{ p.Offset = 8 }}
		} else {
			{{ p.Offset = 4 }}
		}
	}
	<div
		id={ p.ID }
		data-tui-popover-id={ p.ID }
		data-tui-popover-open="false"
		data-tui-popover-placement={ string(p.Placement) }
		data-tui-popover-offset={ strconv.Itoa(p.Offset) }
		data-tui-popover-disable-clickaway={ strconv.FormatBool(p.DisableClickAway) }
		data-tui-popover-disable-esc={ strconv.FormatBool(p.DisableESC) }
		data-tui-popover-show-arrow={ strconv.FormatBool(p.ShowArrow) }
		data-tui-popover-hover-delay={ strconv.Itoa(p.HoverDelay) }
		data-tui-popover-hover-out-delay={ strconv.Itoa(p.HoverOutDelay) }
		data-tui-popover-exclusive={ strconv.FormatBool(p.Exclusive) }
		if p.MatchWidth {
			data-tui-popover-match-width="true"
		}
		class={ utils.TwMerge(
			"bg-popover rounded-lg border text-popover-foreground text-sm shadow-lg pointer-events-auto absolute z-[9999] hidden top-0 left-0",
			p.Class,
		) }
		{ p.Attributes... }
	>
		<div class="w-full overflow-hidden">
			{ children... }
		</div>
		if p.ShowArrow {
			<div
				data-tui-popover-arrow
				class="absolute h-2.5 w-2.5 rotate-45 bg-popover border border-border
					data-[tui-popover-placement^=top]:-bottom-[5px] data-[tui-popover-placement^=top]:border-t-transparent data-[tui-popover-placement^=top]:border-l-transparent
					data-[tui-popover-placement^=bottom]:-top-[5px] data-[tui-popover-placement^=bottom]:border-b-transparent data-[tui-popover-placement^=bottom]:border-r-transparent
					data-[tui-popover-placement^=left]:-right-[5px] data-[tui-popover-placement^=left]:border-l-transparent data-[tui-popover-placement^=left]:border-b-transparent
					data-[tui-popover-placement^=right]:-left-[5px] data-[tui-popover-placement^=right]:border-r-transparent data-[tui-popover-placement^=right]:border-t-transparent"
			></div>
		}
	</div>
}

// Script emits the deferred script tag that activates every popover on the
// page: click and hover triggers, positioning, click-away and Escape
// dismissal. Include it once per page that uses popovers, including
// indirectly through components such as hovercard.
templ Script() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/static/js/popover.min.js") }></script>
}
