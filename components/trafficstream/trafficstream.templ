package trafficstream

import (
    "fmt"
    "strconv"
    "strings"
    "github.com/bplus/webframe/utils"
)

type Row struct {
    Time      string
    Provider  string
    Direction string
    Event     string
    Status    string
    TraceID   string
    Summary   string
    Error     bool
}

type Props struct {
    ID                string
    Class             string
    Attributes        templ.Attributes
    StreamURL         string
    Height            int
    MaxItems          int
    SearchPlaceholder string
    ProviderOptions   []string
    EventOptions      []string
    EmptyTitle        string
    EmptyDescription  string
    InitialRows       []Row
}

func dimensionStr(v int) string {
    if v <= 0 {
        return "420px"
    }
    return fmt.Sprintf("%dpx", v)
}

func maxItems(v int) int {
    if v <= 0 {
        return 250
    }
    return v
}

func placeholder(v string) string {
    if strings.TrimSpace(v) == "" {
        return "Search summary, trace, provider, or event"
    }
    return v
}

func emptyTitle(v string) string {
    if strings.TrimSpace(v) == "" {
        return "No traffic yet"
    }
    return v
}

func emptyDescription(v string) string {
    if strings.TrimSpace(v) == "" {
        return "Waiting for request and response events to arrive."
    }
    return v
}

templ TrafficStream(props ...Props) {
    {{ var p Props }}
    if len(props) > 0 {
        {{ p = props[0] }}
    }
    {{ id := p.ID }}
    if id == "" {
        {{ id = utils.RandomID() }}
    }
    <section
        if p.ID != "" {
            id={ p.ID }
        }
        data-tui-trafficstream
        if p.StreamURL != "" {
            data-tui-trafficstream-url={ p.StreamURL }
        }
        data-tui-trafficstream-max-items={ strconv.Itoa(maxItems(p.MaxItems)) }
        class={ utils.TwMerge("rounded-xl border border-border bg-card text-card-foreground shadow-xs", p.Class) }
        { p.Attributes... }
    >
        <div class="flex flex-col gap-4 border-b border-border p-4 md:flex-row md:items-end md:justify-between">
            <div>
                <h3 class="text-lg font-semibold tracking-tight">Traffic Stream</h3>
                <p class="text-sm text-muted-foreground">Live request and response activity with client-side filters and pause control.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <span data-tui-trafficstream-connection class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-2.5 py-1 text-xs text-muted-foreground">
                    <span class="size-2 rounded-full bg-amber-500"></span>
                    Connecting
                </span>
                <button type="button" data-tui-trafficstream-toggle class="inline-flex items-center rounded-md border border-border bg-background px-3 py-2 text-sm hover:bg-accent hover:text-accent-foreground transition-colors">Pause</button>
                <button type="button" data-tui-trafficstream-clear class="inline-flex items-center rounded-md border border-border bg-background px-3 py-2 text-sm hover:bg-accent hover:text-accent-foreground transition-colors">Clear</button>
            </div>
        </div>
        <div class="grid gap-3 border-b border-border p-4 md:grid-cols-[minmax(0,1fr)_180px_180px_140px]">
            <input type="search" data-tui-trafficstream-search placeholder={ placeholder(p.SearchPlaceholder) } class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring"/>
            <select data-tui-trafficstream-provider class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-ring">
                <option value="">All providers</option>
                for _, providerName := range p.ProviderOptions {
                    <option value={ providerName }>{ providerName }</option>
                }
            </select>
            <select data-tui-trafficstream-event class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-ring">
                <option value="">All events</option>
                for _, eventName := range p.EventOptions {
                    <option value={ eventName }>{ eventName }</option>
                }
            </select>
            <select data-tui-trafficstream-direction class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-ring">
                <option value="">All directions</option>
                <option value="request">Request</option>
                <option value="response">Response</option>
                <option value="local">Local</option>
                <option value="event">Event</option>
            </select>
        </div>
        <div class="overflow-auto" style={ "height:" + dimensionStr(p.Height) }>
            <table class="w-full text-sm">
                <thead class="sticky top-0 z-10 border-b border-border bg-card/95 backdrop-blur-sm">
                    <tr>
                        <th class="px-4 py-3 text-left font-medium text-muted-foreground">Time</th>
                        <th class="px-4 py-3 text-left font-medium text-muted-foreground">Provider</th>
                        <th class="px-4 py-3 text-left font-medium text-muted-foreground">Direction</th>
                        <th class="px-4 py-3 text-left font-medium text-muted-foreground">Event</th>
                        <th class="px-4 py-3 text-left font-medium text-muted-foreground">Status</th>
                        <th class="px-4 py-3 text-left font-medium text-muted-foreground">Trace</th>
                        <th class="px-4 py-3 text-left font-medium text-muted-foreground">Summary</th>
                    </tr>
                </thead>
                <tbody data-tui-trafficstream-rows>
                    for _, row := range p.InitialRows {
                        <tr
                            data-provider={ row.Provider }
                            data-event={ row.Event }
                            data-direction={ row.Direction }
                            data-search={ strings.ToLower(strings.Join([]string{row.Provider, row.Direction, row.Event, row.TraceID, row.Summary}, " ")) }
                            class={ utils.TwMerge("border-b border-border align-top hover:bg-muted/40", utils.If(row.Error, "bg-destructive/5")) }
                        >
                            <td class="whitespace-nowrap px-4 py-3 text-xs text-muted-foreground">{ row.Time }</td>
                            <td class="px-4 py-3">{ row.Provider }</td>
                            <td class="px-4 py-3"><span class="inline-flex rounded-full border border-border bg-background px-2 py-0.5 text-xs">{ row.Direction }</span></td>
                            <td class="px-4 py-3">{ row.Event }</td>
                            <td class="px-4 py-3">{ row.Status }</td>
                            <td class="px-4 py-3 font-mono text-xs text-muted-foreground">{ row.TraceID }</td>
                            <td class="px-4 py-3 text-sm">{ row.Summary }</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div data-tui-trafficstream-empty class={ utils.TwMerge("flex h-full min-h-56 flex-col items-center justify-center gap-2 p-8 text-center", utils.If(len(p.InitialRows) > 0, "hidden")) }>
                <p class="text-base font-medium">{ emptyTitle(p.EmptyTitle) }</p>
                <p class="max-w-md text-sm text-muted-foreground">{ emptyDescription(p.EmptyDescription) }</p>
            </div>
        </div>
    </section>
}

templ Script() {
    <script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/static/js/trafficstream.min.js") }></script>
}
