package trafficstream

import (
	"fmt"
	"github.com/bplus/webframe/utils"
	"strconv"
	"strings"
)

// Row is one server-rendered entry for the traffic table, used via
// Props.InitialRows to populate the table before the SSE stream connects.
// Fields map one-to-one onto the table columns; Error tints the row with the
// destructive background. Each row also gets a lowercase data-search
// attribute built from Provider, Direction, Event, TraceID, and Summary,
// plus data-provider/data-event/data-direction attributes — these are what
// the client-side search box and filter dropdowns match against.
type Row struct {
	Time      string
	Provider  string
	Direction string
	Event     string
	Status    string
	TraceID   string
	Summary   string
	Error     bool
}

// Props configures a TrafficStream panel. StreamURL is the Server-Sent
// Events endpoint the companion script (see Script) connects to, e.g.
// "/api/traffic/stream"; when empty, no data-tui-trafficstream-url attribute
// is emitted and the script never opens a connection, leaving only the
// InitialRows and client-side filters. Defaults applied at render time:
// Height <= 0 becomes a 420px scroll area, MaxItems <= 0 becomes 250
// retained rows, and blank SearchPlaceholder / EmptyTitle / EmptyDescription
// fall back to built-in copy. ProviderOptions and EventOptions populate the
// filter <select>s; all filtering happens client-side against row data
// attributes, so options should match the values events actually carry.
type Props struct {
	ID                string
	Class             string
	Attributes        templ.Attributes
	StreamURL         string
	Height            int
	MaxItems          int
	SearchPlaceholder string
	ProviderOptions   []string
	EventOptions      []string
	EmptyTitle        string
	EmptyDescription  string
	InitialRows       []Row
}

func dimensionStr(v int) string {
	if v <= 0 {
		return "420px"
	}
	return fmt.Sprintf("%dpx", v)
}

// maxItems returns the retention cap for stream rows: MaxItems if positive,
// otherwise a default of 250 — a memory vs. scrollback tradeoff: enough rows
// to review recent traffic without letting memory grow unbounded on a
// long-running demo session.
func maxItems(v int) int {
	if v <= 0 {
		return 250
	}
	return v
}

func placeholder(v string) string {
	if strings.TrimSpace(v) == "" {
		return "Search summary, trace, provider, or event"
	}
	return v
}

func emptyTitle(v string) string {
	if strings.TrimSpace(v) == "" {
		return "No traffic yet"
	}
	return v
}

func emptyDescription(v string) string {
	if strings.TrimSpace(v) == "" {
		return "Waiting for request and response events to arrive."
	}
	return v
}

// TrafficStream renders a live traffic monitoring panel: a filterable,
// pausable table of request/response events fed over Server-Sent Events by
// the companion script. Use it as the operator view for any endpoint that
// emits a JSON event stream.
//
// It accepts zero or one Props (extras ignored); zero values take the
// defaults documented on Props. InitialRows render server-side so the table
// has content before the stream connects; live rows are prepended by the
// script, which trims the table to MaxItems.
//
// Returns a templ.Component rooted at a <section data-tui-trafficstream>
// carrying data-tui-trafficstream-url and -max-items attributes; it takes no
// children. Every interactive part — connection badge, Pause/Clear buttons,
// search input, provider/event/direction selects, rows tbody, empty state —
// is tagged with a data-tui-trafficstream-* attribute for the script to find.
//
// The component emits no inline JS itself: behavior requires Script() (or
// /static/js/trafficstream.min.js loaded another way), which scans for
// panels on DOMContentLoaded and again after htmx:afterSwap, opening one
// native EventSource per panel that has a stream URL.
//
// @boundary HTTP — the browser opens an SSE (EventSource) connection to Props.StreamURL
// @temporal-coupling inert without Script(); pair them on the same page
//
// SSE drop/reconnect behavior (verified against static/js/trafficstream.min.js,
// which is unminified/readable despite the extension): the native EventSource
// reconnects on its own browser-controlled schedule after a drop — there is
// no manual retry loop here. source.onerror sets the connection badge to
// amber "Reconnecting", but there is no onopen handler, so the badge stays
// on "Reconnecting" even after the browser silently reconnects and events
// resume flowing — a real display bug, not just an undocumented state. Rows
// rendered before the drop are untouched and survive. The Pause button
// (data-tui-trafficstream-toggle) sets the badge to amber "Paused" and back
// to green "Live" on resume, and stops appending incoming rows to the DOM
// while paused — but it does not close the EventSource: only the underlying
// connection is unaffected by pause, the socket keeps receiving events in
// the background and they are simply dropped instead of rendered.
// The <section> emits an id attribute only when Props.ID is non-empty, so a
// stream without an explicit ID renders no id attribute at all (contrast
// graphwidget, which renders id={ id } unconditionally).
templ TrafficStream(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<section
		if p.ID != "" {
			id={ p.ID }
		}
		data-tui-trafficstream
		if p.StreamURL != "" {
			data-tui-trafficstream-url={ p.StreamURL }
		}
		data-tui-trafficstream-max-items={ strconv.Itoa(maxItems(p.MaxItems)) }
		class={ utils.TwMerge("rounded-xl border border-border bg-card text-card-foreground shadow-xs", p.Class) }
		{ p.Attributes... }
	>
		<div class="flex flex-col gap-4 border-b border-border p-4 md:flex-row md:items-end md:justify-between">
			<div>
				<h3 class="text-lg font-semibold tracking-tight">Traffic Stream</h3>
				<p class="text-sm text-muted-foreground">Live request and response activity with client-side filters and pause control.</p>
			</div>
			<div class="flex flex-wrap items-center gap-2">
				<span data-tui-trafficstream-connection class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-2.5 py-1 text-xs text-muted-foreground">
					<span class="size-2 rounded-full bg-amber-500"></span>
					Connecting
				</span>
				<button type="button" data-tui-trafficstream-toggle class="inline-flex items-center rounded-md border border-border bg-background px-3 py-2 text-sm hover:bg-accent hover:text-accent-foreground transition-colors">Pause</button>
				<button type="button" data-tui-trafficstream-clear class="inline-flex items-center rounded-md border border-border bg-background px-3 py-2 text-sm hover:bg-accent hover:text-accent-foreground transition-colors">Clear</button>
			</div>
		</div>
		<div class="grid gap-3 border-b border-border p-4 md:grid-cols-[minmax(0,1fr)_180px_180px_140px]">
			<input type="search" data-tui-trafficstream-search placeholder={ placeholder(p.SearchPlaceholder) } class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring"/>
			<select data-tui-trafficstream-provider class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-ring">
				<option value="">All providers</option>
				for _, providerName := range p.ProviderOptions {
					<option value={ providerName }>{ providerName }</option>
				}
			</select>
			<select data-tui-trafficstream-event class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-ring">
				<option value="">All events</option>
				for _, eventName := range p.EventOptions {
					<option value={ eventName }>{ eventName }</option>
				}
			</select>
			<select data-tui-trafficstream-direction class="h-9 rounded-md border border-input bg-background px-3 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-ring">
				<option value="">All directions</option>
				<option value="request">Request</option>
				<option value="response">Response</option>
				<option value="local">Local</option>
				<option value="event">Event</option>
			</select>
		</div>
		<div class="overflow-auto" style={ "height:" + dimensionStr(p.Height) }>
			<table class="w-full text-sm">
				<thead class="sticky top-0 z-10 border-b border-border bg-card/95 backdrop-blur-sm">
					<tr>
						<th class="px-4 py-3 text-left font-medium text-muted-foreground">Time</th>
						<th class="px-4 py-3 text-left font-medium text-muted-foreground">Provider</th>
						<th class="px-4 py-3 text-left font-medium text-muted-foreground">Direction</th>
						<th class="px-4 py-3 text-left font-medium text-muted-foreground">Event</th>
						<th class="px-4 py-3 text-left font-medium text-muted-foreground">Status</th>
						<th class="px-4 py-3 text-left font-medium text-muted-foreground">Trace</th>
						<th class="px-4 py-3 text-left font-medium text-muted-foreground">Summary</th>
					</tr>
				</thead>
				<tbody data-tui-trafficstream-rows>
					for _, row := range p.InitialRows {
						<tr
							data-provider={ row.Provider }
							data-event={ row.Event }
							data-direction={ row.Direction }
							data-search={ strings.ToLower(strings.Join([]string{row.Provider, row.Direction, row.Event, row.TraceID, row.Summary}, " ")) }
							class={ utils.TwMerge("border-b border-border align-top hover:bg-muted/40", utils.If(row.Error, "bg-destructive/5")) }
						>
							<td class="whitespace-nowrap px-4 py-3 text-xs text-muted-foreground">{ row.Time }</td>
							<td class="px-4 py-3">{ row.Provider }</td>
							<td class="px-4 py-3"><span class="inline-flex rounded-full border border-border bg-background px-2 py-0.5 text-xs">{ row.Direction }</span></td>
							<td class="px-4 py-3">{ row.Event }</td>
							<td class="px-4 py-3">{ row.Status }</td>
							<td class="px-4 py-3 font-mono text-xs text-muted-foreground">{ row.TraceID }</td>
							<td class="px-4 py-3 text-sm">{ row.Summary }</td>
						</tr>
					}
				</tbody>
			</table>
			<div data-tui-trafficstream-empty class={ utils.TwMerge("flex h-full min-h-56 flex-col items-center justify-center gap-2 p-8 text-center", utils.If(len(p.InitialRows) > 0, "hidden")) }>
				<p class="text-base font-medium">{ emptyTitle(p.EmptyTitle) }</p>
				<p class="max-w-md text-sm text-muted-foreground">{ emptyDescription(p.EmptyDescription) }</p>
			</div>
		</div>
	</section>
}

// Script emits the <script> tag that activates every TrafficStream panel on
// the page. Include it once per page, anywhere in the body; the script
// initializes panels on DOMContentLoaded and re-scans after htmx:afterSwap,
// so panels swapped in later are picked up too.
//
// It takes no parameters and no children; returns a templ.Component
// rendering a single deferred <script> for /static/js/trafficstream.min.js,
// stamped with the current templ CSP nonce (templ.GetNonce) and a
// utils.ScriptURL cache-busting ?v= query.
//
// @side-effects loads and runs the trafficstream script in the browser,
// which opens an EventSource per configured panel and mutates the table DOM
// @temporal-coupling TrafficStream panels do nothing without this script
templ Script() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/static/js/trafficstream.min.js") }></script>
}
