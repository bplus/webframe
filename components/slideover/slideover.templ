package slideover

import (
	"context"
	"github.com/bplus/webframe/components/icon"
	"github.com/bplus/webframe/utils"
)

type contextKey string

const (
	instanceKey contextKey = "slideoverInstance"
	openKey     contextKey = "slideoverOpen"
)

// Side selects which screen edge the panel is anchored to and slides in
// from. The zero value ("") is treated as SideRight by Panel.
//
// SideRight and SideLeft give a full-height column; SideBottom gives a
// bottom sheet: a full-width panel that rises from the bottom edge, capped
// at a Height tier and scrolling inside.
type Side string

// Side values accepted by PanelProps.Side.
const (
	SideRight  Side = "right"
	SideLeft   Side = "left"
	SideBottom Side = "bottom"
)

// Width selects the panel's fixed width tier for SideRight and SideLeft.
// The zero value ("") is treated as WidthMd by Panel; unknown values also
// fall back to the 480px width. From the sm breakpoint up every tier is
// capped at calc(100%-2rem); below sm the panel is full width whatever the
// tier. Width is ignored for SideBottom, which is always full width.
type Width string

// Width values accepted by PanelProps.Width.
const (
	WidthSm   Width = "sm"   // 320px
	WidthMd   Width = "md"   // 480px
	WidthLg   Width = "lg"   // 640px
	WidthXl   Width = "xl"   // 800px
	WidthFull Width = "full" // 100%
)

// Height selects the bottom sheet's maximum height as a share of the
// viewport. The zero value ("") is treated as HeightMd by Panel; unknown
// values also fall back to 60vh. The sheet is only as tall as its content up
// to that cap; past it the Body scrolls while the header stays put. Height is
// ignored for SideRight and SideLeft, which are always full height.
type Height string

// Height values accepted by PanelProps.Height (SideBottom only).
const (
	HeightSm Height = "sm" // max 40vh
	HeightMd Height = "md" // max 60vh
	HeightLg Height = "lg" // max 85vh
)

// Props configures the SlideOver root wrapper. The zero value is usable: an
// instance ID is generated automatically and the panel starts closed with
// click-away and ESC dismissal enabled.
//
// ID doubles as the slide-over's instance ID, linking the root to its
// Trigger/Panel/Close descendants (and to external Trigger/Close elements
// via their For field). Leave it empty unless something outside the
// SlideOver subtree needs to reference this instance.
type Props struct {
	ID               string
	Class            string
	Attributes       templ.Attributes
	Open             bool // initial open state, propagated to Panel via render context
	DisableESC       bool // when true, the Escape key does not close the panel
	DisableClickAway bool // when true, clicking the backdrop does not close the panel
}

// PanelProps configures the Panel (backdrop + sliding drawer). Zero values
// give a right-anchored, 480px-wide panel with a close button and no title.
// When Panel renders inside a SlideOver, its instance ID and open state come
// from the wrapper's render context, overriding ID here.
type PanelProps struct {
	ID               string
	Class            string
	Attributes       templ.Attributes
	Title            string // header text; empty leaves the header's title slot blank
	Side             Side   // edge to slide from; "" = SideRight
	Width            Width  // width tier for left/right; "" = WidthMd (480px); ignored for SideBottom
	Height           Height // max-height tier for SideBottom; "" = HeightMd (60vh); ignored for left/right
	HideCloseButton  bool   // suppress the default header X close button
	DisableAutoFocus bool   // when true, focus is not moved into the panel on open
}

// TriggerProps configures a Trigger element. The zero value works when the
// Trigger is nested inside a SlideOver: the instance ID is inherited from
// the wrapper's render context. Set For only for triggers placed outside the
// SlideOver subtree.
type TriggerProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	For        string // ID of the slide-over to open (overrides inherited context)
}

// CloseProps configures a Close element. The zero value closes the nearest
// enclosing slide-over; set For to target a specific instance by ID from
// anywhere on the page.
type CloseProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	For        string // ID of the slide-over to close (optional, defaults to closest)
}

// PinnedProps configures Pinned. All fields are optional pass-throughs to
// the rendered div.
type PinnedProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// BodyProps configures the Body scroll region. All fields are optional
// pass-throughs to the rendered div.
type BodyProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// FooterProps configures the Footer action row. All fields are optional
// pass-throughs to the rendered div.
type FooterProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

func widthClass(w Width) string {
	switch w {
	case WidthSm:
		return "w-80"
	case WidthMd:
		return "w-[480px]"
	case WidthLg:
		return "w-[640px]"
	case WidthXl:
		return "w-[800px]"
	case WidthFull:
		return "w-full"
	default:
		return "w-[480px]"
	}
}

func heightClass(h Height) string {
	switch h {
	case HeightSm:
		return "max-h-[40dvh]"
	case HeightLg:
		return "max-h-[85dvh]"
	default:
		return "max-h-[60dvh]"
	}
}

// sideClasses returns the edge anchor, the closed-state transform and the
// open-state transform for a side. The transforms are what slideover.min.js
// animates between by toggling data-tui-slideover-open; the script itself
// knows no axis.
func sideClasses(s Side) (position string, closedTranslate string, openTranslate string) {
	switch s {
	case SideLeft:
		return "left-0", "-translate-x-full", "translate-x-0"
	case SideBottom:
		return "bottom-0", "translate-y-full", "translate-y-0"
	default:
		return "right-0", "translate-x-full", "translate-x-0"
	}
}

// SlideOver is the root wrapper that binds a drawer's Trigger and Panel into
// one unit, for edge-anchored panels (settings, detail views) where a
// centered dialog would be wrong. The expected structure is
// SlideOver > { Trigger, Panel > { Pinned, Body, Footer, Close } }.
//
// Nested parts inherit the instance ID (generated when Props.ID is empty)
// and Props.Open through the render context. Parts placed outside the
// subtree link by setting For to Props.ID. Open and close are driven by
// data-tui-slideover-* attributes toggled by the script from Script(), which
// must be on the page.
templ SlideOver(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ instanceID := p.ID }}
	if instanceID == "" {
		{{ instanceID = utils.RandomID() }}
	}
	{{ ctx = context.WithValue(ctx, instanceKey, instanceID) }}
	{{ ctx = context.WithValue(ctx, openKey, p.Open) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-tui-slideover
		data-slideover-instance={ instanceID }
		if p.DisableClickAway {
			data-tui-slideover-disable-click-away="true"
		}
		if p.DisableESC {
			data-tui-slideover-disable-esc="true"
		}
		class={ utils.TwMerge("", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Trigger wraps children (typically a button) so that clicking them opens
// the slide-over. It targets For when set, otherwise the enclosing
// SlideOver; with neither, it is bound to nothing. It renders a
// layout-neutral span (class "contents").
templ Trigger(props ...TriggerProps) {
	{{ var p TriggerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ instanceID := "" }}
	// Explicit For prop takes priority over inherited context
	if p.For != "" {
		{{ instanceID = p.For }}
	} else if val := ctx.Value(instanceKey); val != nil {
		{{ instanceID = val.(string) }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		data-tui-slideover-trigger={ instanceID }
		data-slideover-instance={ instanceID }
		data-tui-slideover-trigger-open="false"
		class={ utils.TwMerge("contents", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

// Panel renders the drawer: a fixed backdrop (z-index 55) and a panel
// (z-index 60, below the toast container) that slides in from Side. Left
// and right panels are full-height columns of the Width tier, full width
// below sm. A bottom sheet is full width with a decorative drag handle,
// capped at the Height tier. The header (Title and, unless HideCloseButton,
// a close button) stays pinned; children are expected to be Pinned
// (optional), Body and Footer, in that order.
//
// An enclosing SlideOver's context overrides PanelProps.ID and supplies the
// initial open state. A standalone Panel always starts closed and its ID
// must match the external Trigger's For.
templ Panel(props ...PanelProps) {
	{{ var p PanelProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	// Start with prop values as defaults
	{{ instanceID := p.ID }}
	{{ open := false }}
	// Override with context values if available
	if val := ctx.Value(instanceKey); val != nil {
		{{ instanceID = val.(string) }}
	}
	if val := ctx.Value(openKey); val != nil {
		{{ open = val.(bool) }}
	}
	// Apply defaults if still empty
	if instanceID == "" {
		{{ instanceID = utils.RandomID() }}
	}
	// Resolve side and width
	{{ s := p.Side }}
	if s == "" {
		{{ s = SideRight }}
	}
	{{ w := p.Width }}
	if w == "" {
		{{ w = WidthMd }}
	}
	{{ bottom := s == SideBottom }}
	{{ position, closedTranslate, openTranslate := sideClasses(s) }}
	// Geometry: left/right are full-height columns of the Width tier (full
	// width below sm); bottom is a full-width sheet capped at the Height tier.
	{{ var geometry string }}
	if bottom {
		{{ geometry = utils.TwMerge("inset-x-0 w-full rounded-t-xl border-t pb-[env(safe-area-inset-bottom,0px)]", heightClass(p.Height)) }}
	} else {
		{{ geometry = utils.TwMerge("top-0 h-full", widthClass(w), "max-w-[calc(100%-2rem)] max-sm:w-full max-sm:max-w-full", utils.IfElse(s == SideLeft, "border-r", "border-l")) }}
	}
	<!-- Backdrop -->
	<div
		class={ utils.TwMerge(
			// A scrim darkens in both themes (a shadow, not a surface color);
			// bg-foreground/40 lightened the page in dark mode.
			"fixed inset-0 z-[55] bg-black/50",
			"transition-opacity duration-300",
			"data-[tui-slideover-open=false]:opacity-0",
			"data-[tui-slideover-open=true]:opacity-100",
			"data-[tui-slideover-open=false]:pointer-events-none",
			"data-[tui-slideover-open=true]:pointer-events-auto",
			"data-[tui-slideover-hidden=true]:!hidden",
		) }
		data-tui-slideover-backdrop
		data-slideover-instance={ instanceID }
		if open {
			data-tui-slideover-open="true"
		} else {
			data-tui-slideover-open="false"
			data-tui-slideover-hidden="true"
		}
	></div>
	<!-- Panel -->
	<div
		class={
			utils.TwMerge(
				// Base positioning (above page content; below the toast
				// container's z-70)
				"fixed z-[60]",
				position,
				geometry,
				// Style
				"bg-background shadow-xl",
				"border-border",
				// Layout
				"flex flex-col",
				// Transitions
				"transition-transform duration-300 ease-in-out",
				// Slide animation
				"data-[tui-slideover-open=false]:"+closedTranslate,
				"data-[tui-slideover-open=true]:"+openTranslate,
				// Hidden state
				"data-[tui-slideover-hidden=true]:!hidden",
				p.Class,
			),
		}
		data-tui-slideover-panel
		data-slideover-instance={ instanceID }
		if p.DisableAutoFocus {
			data-tui-slideover-disable-autofocus="true"
		}
		if open {
			data-tui-slideover-open="true"
		} else {
			data-tui-slideover-open="false"
			data-tui-slideover-hidden="true"
		}
		{ p.Attributes... }
	>
		if bottom {
			<!-- Drag handle (decorative: the sheet is closed by the X, the backdrop or Escape) -->
			<div class="mx-auto mt-2 h-1.5 w-10 shrink-0 rounded-full bg-muted-foreground/30" aria-hidden="true" data-tui-slideover-handle></div>
		}
		<!-- Header -->
		<div class="flex items-center justify-between border-b border-border px-4 sm:px-6 py-4 shrink-0">
			if p.Title != "" {
				<h2 class="text-lg font-semibold leading-none">{ p.Title }</h2>
			} else {
				<div></div>
			}
			if !p.HideCloseButton {
				<button
					class={ utils.TwMerge(
						"rounded-xs opacity-70",
						"transition-opacity hover:opacity-100",
						"focus:outline-none focus:ring-2",
						"focus:ring-ring focus:ring-offset-2",
						"ring-offset-background",
						"disabled:pointer-events-none",
						"[&_svg]:pointer-events-none",
						"[&_svg]:shrink-0",
						"[&_svg:not([class*='size-'])]:size-4",
					) }
					data-tui-slideover-close={ instanceID }
					aria-label="Close"
					type="button"
				>
					@icon.X()
					<span class="sr-only">Close</span>
				</button>
			}
		</div>
		{ children... }
	</div>
}

// Pinned holds content that is pinned between the Panel's header and its
// Body, which means it stays in view while the Body scrolls: filters, a
// count, a notice. Place it directly inside Panel, before Body. It has the
// header's horizontal padding and a rule under it, on every Side.
templ Pinned(props ...PinnedProps) {
	{{ var p PinnedProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("shrink-0 border-b border-border px-4 sm:px-6 py-3", p.Class) }
		data-tui-slideover-pinned
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Body is the scrollable main region of a Panel: it takes the remaining
// height and scrolls, keeping the header and Footer pinned. Place it
// directly inside Panel.
templ Body(props ...BodyProps) {
	{{ var p BodyProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("flex-1 overflow-y-auto p-6", p.Class) }
		data-tui-slideover-body
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Footer holds a Panel's action row, pinned below the Body, with
// right-aligned buttons. Wrap a button in Close to make it dismiss the
// panel.
templ Footer(props ...FooterProps) {
	{{ var p FooterProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("border-t border-border p-4 flex justify-end gap-2", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Close wraps children (e.g. a Cancel button) so that clicking them closes
// a slide-over: the instance named by For, or else the closest enclosing
// panel. It renders a layout-neutral span.
templ Close(props ...CloseProps) {
	{{ var p CloseProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		if p.For != "" {
			data-tui-slideover-close={ p.For }
		} else {
			data-tui-slideover-close
		}
		class={ utils.TwMerge("contents cursor-pointer", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

// Script emits the deferred script tag that activates every slide-over on
// the page: trigger clicks, backdrop and Escape dismissal, focus handling
// and the slide transitions. Include it once per page that uses SlideOver;
// without it the markup is inert.
templ Script() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/static/js/slideover.min.js") }></script>
}
