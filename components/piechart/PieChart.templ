package piechart

import (
	"fmt"
	"github.com/bplus/webframe/utils"
	"math"
)

// Slice is one wedge of a PieChart. Slices with Value <= 0 contribute nothing
// to the total and draw no arc, but still occupy a legend row. Despite the
// field comment below, an empty Color is tolerated: it falls back to a
// built-in ten-color palette keyed by slice index. All colors (explicit or
// palette) pass through utils.SanitizeColor before rendering.
type Slice struct {
	Label string
	Value float64
	Color string // required — hex or CSS color (empty falls back to the default palette)
}

// Props configures PieChart; pass it as the single optional argument. The zero
// value renders an empty 160px donut frame: Size defaults to 160 when <= 0,
// and a nil InnerSize means a donut with a 50px inner radius — pass a pointer
// to 0 for a full pie. Setting MaxSlices > 0 keeps the MaxSlices largest
// slices (re-sorted descending, so input order is lost when the cap applies)
// and folds the rest into a palette-colored "Other (K)" slice; 0 leaves the
// input untouched.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Slices     []Slice
	Size       int  // Diameter in px (default 160)
	InnerSize  *int // Inner radius for donut (nil = default 50 donut, 0 = full pie)
	ShowLegend bool // Show legend below chart
	MaxSlices  int  // cap slice count; extra slices fold into "Other (K)" (0 = unlimited)
}

func (p Props) resolveSize() int {
	if p.Size > 0 {
		return p.Size
	}
	return 160
}

func (p Props) resolveInnerSize() int {
	if p.InnerSize == nil {
		return 50 // default donut
	}
	return *p.InnerSize
}

func total(slices []Slice) float64 {
	t := 0.0
	for _, s := range slices {
		if s.Value > 0 {
			t += s.Value
		}
	}
	if t == 0 {
		return 1
	}
	return t
}

// defaultColors provides fallback colors for slices without explicit color.
var defaultColors = []string{
	"#3b82f6", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6",
	"#ec4899", "#06b6d4", "#84cc16", "#f97316", "#6366f1",
}

type arcData struct {
	startAngle float64
	endAngle   float64
	color      string
}

func computeArcs(slices []Slice) []arcData {
	t := total(slices)
	arcs := make([]arcData, len(slices))
	angle := -math.Pi / 2 // start at top
	for i, s := range slices {
		color := s.Color
		if color == "" {
			color = defaultColors[i%len(defaultColors)]
		}
		if s.Value <= 0 {
			// Negative/zero slices get zero-width arcs (no visual)
			arcs[i] = arcData{
				startAngle: angle,
				endAngle:   angle,
				color:      utils.SanitizeColor(color),
			}
			continue
		}
		pct := s.Value / t
		sweep := pct * 2 * math.Pi
		arcs[i] = arcData{
			startAngle: angle,
			endAngle:   angle + sweep,
			color:      utils.SanitizeColor(color),
		}
		angle += sweep
	}
	return arcs
}

func arcPath(cx, cy, outerR, innerR int, startAngle, endAngle float64) string {
	if endAngle-startAngle >= 2*math.Pi-0.001 {
		// Full circle — use two arcs to avoid SVG rendering issues
		mid := startAngle + math.Pi
		return arcPath(cx, cy, outerR, innerR, startAngle, mid) + " " + arcPath(cx, cy, outerR, innerR, mid, endAngle)
	}
	outerStart := polarToCart(cx, cy, outerR, startAngle)
	outerEnd := polarToCart(cx, cy, outerR, endAngle)
	largeArc := 0
	if endAngle-startAngle > math.Pi {
		largeArc = 1
	}
	if innerR <= 0 {
		return fmt.Sprintf("M %d %d A %d %d 0 %d 1 %d %d L %d %d Z",
			outerStart[0], outerStart[1],
			outerR, outerR, largeArc,
			outerEnd[0], outerEnd[1],
			cx, cy)
	}
	innerStart := polarToCart(cx, cy, innerR, startAngle)
	innerEnd := polarToCart(cx, cy, innerR, endAngle)
	return fmt.Sprintf("M %d %d A %d %d 0 %d 1 %d %d L %d %d A %d %d 0 %d 0 %d %d Z",
		outerStart[0], outerStart[1],
		outerR, outerR, largeArc,
		outerEnd[0], outerEnd[1],
		innerEnd[0], innerEnd[1],
		innerR, innerR, largeArc,
		innerStart[0], innerStart[1])
}

func polarToCart(cx, cy, r int, angle float64) [2]int {
	return [2]int{
		cx + int(math.Round(float64(r)*math.Cos(angle))),
		cy + int(math.Round(float64(r)*math.Sin(angle))),
	}
}

// PieChart renders a donut (the default) or full pie as an inline SVG,
// starting at twelve o'clock and sweeping clockwise, with an optional legend
// showing whole-number percentages.
//
// Accepts zero or one Props: called with no arguments it uses the zero value,
// and any Props beyond the first are ignored. Slices with Value <= 0 draw no
// arc but still appear in the legend; if Slices is empty or every value is
// <= 0, an empty SVG frame renders at the resolved size. A single positive
// slice covers the full circle, drawn as two half-arcs to avoid SVG
// full-circle path artifacts. With MaxSlices > 0 and more slices than the cap,
// the slices are re-sorted descending and the remainder folds into an
// "Other (K)" slice; an input that already fits the cap is left untouched in
// its original order. All colors pass through utils.SanitizeColor.
//
// Returns a templ.Component that renders a <div> containing the <svg> and
// optional legend.
//
// @pure
// @complexity O(n log n) when MaxSlices caps the input, O(n) otherwise
// @invariant when at least one slice has Value > 0, the arc sweeps of
// positive-value slices sum to a full circle (percentages are of the
// positive-value total only); with no positive slices there are no arcs
// @ai-context legend rows for zero/negative slices still render, showing 0%
// or a negative percentage — only the arc drawing skips them.
templ PieChart(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ size := p.resolveSize() }}
	{{ innerR := p.resolveInnerSize() }}
	{{ outerR := size/2 - 4 }}
	{{ cx := size / 2 }}
	{{ cy := size / 2 }}
	{{ slices := capSlices(p.Slices, p.MaxSlices) }}
	{{ arcs := computeArcs(slices) }}
	{{ t := total(slices) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("inline-flex flex-col items-center gap-3", p.Class) }
		{ p.Attributes... }
	>
		<svg
			width={ fmt.Sprintf("%d", size) }
			height={ fmt.Sprintf("%d", size) }
			viewBox={ fmt.Sprintf("0 0 %d %d", size, size) }
			xmlns="http://www.w3.org/2000/svg"
		>
			for i, arc := range arcs {
				if slices[i].Value > 0 {
					<path
						d={ arcPath(cx, cy, outerR, innerR, arc.startAngle, arc.endAngle) }
						fill={ arc.color }
					/>
				}
			}
		</svg>
		if p.ShowLegend {
			<div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted-foreground">
				for i, s := range slices {
					{{ color := s.Color }}
					if color == "" {
						{{ color = defaultColors[i%len(defaultColors)] }}
					}
					{{ color = utils.SanitizeColor(color) }}
					{{ pct := s.Value * 100 / t }}
					<div class="flex items-center gap-1.5">
						<span class="inline-block w-2.5 h-2.5 rounded-sm shrink-0" style={ fmt.Sprintf("background-color: %s", color) }></span>
						<span>{ s.Label } ({ fmt.Sprintf("%.0f%%", pct) })</span>
					</div>
				}
			</div>
		}
	</div>
}
