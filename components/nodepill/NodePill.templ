package nodepill

import (
	"unicode/utf8"

	"github.com/bplus/webframe/utils"
)

// Props configures a NodePill. NodeType selects the colored dot from a
// fixed set of known types (concept, tool, decision, error, service,
// person, incident, code_path, reference); unknown or empty types get a
// neutral muted dot. A non-empty Href switches the root element from
// <span> to <a>. Truncate is a rune-length cap on the displayed title
// (0 means the default of 30); titles longer than the cap are cut to
// limit-1 runes and suffixed with an ellipsis. A negative Truncate is
// clamped to 0 (the default).
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Title      string // Node title to display
	NodeType   string // Node type (concept, tool, decision, error, etc.) — controls dot color
	Href       string // Optional: makes the pill a link
	Truncate   int    // Max chars before truncation (default 30)
}

func (p Props) dotColor() string {
	switch p.NodeType {
	case "concept":
		return "bg-blue-500"
	case "tool":
		return "bg-green-500"
	case "decision":
		return "bg-amber-500"
	case "error":
		return "bg-red-500"
	case "service":
		return "bg-purple-500"
	case "person":
		return "bg-cyan-500"
	case "incident":
		return "bg-orange-500"
	case "code_path":
		return "bg-emerald-500"
	case "reference":
		return "bg-slate-500"
	default:
		return "bg-muted-foreground"
	}
}

func (p Props) displayTitle() string {
	limit := p.Truncate
	if limit <= 0 {
		limit = 30
	}
	if utf8.RuneCountInString(p.Title) > limit {
		runes := []rune(p.Title)
		return string(runes[:limit-1]) + "\u2026"
	}
	return p.Title
}

// NodePill renders a compact rounded pill identifying a graph
// node: a type-colored dot plus a truncated title, optionally acting as
// a link. Use it for dense node lists where type must be scannable at a
// glance. Zero-value / omitted props render an empty non-link pill with
// a muted dot; only the first Props is used and extras are silently
// ignored. Returns a templ.Component rendering an <a> when Href is set
// (the URL is emitted as a plain string so templ sanitizes unsafe schemes) or a <span> otherwise; it takes no
// children — content comes from Props.
//
// @pure
// @ai-context Truncation in displayTitle() counts runes
// (utf8.RuneCountInString / []rune), so multi-byte UTF-8 titles are cut
// on rune boundaries and never split a character. Hover/cursor
// affordances are only applied in the link branch. A negative Truncate
// is clamped to the default (30) rather than panicking.
templ NodePill(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Href != "" {
		<a
			href={ p.Href }
			if p.ID != "" {
				id={ p.ID }
			}
			class={
				utils.TwMerge(
					"inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium",
					"bg-muted/50 text-foreground hover:bg-muted transition-colors cursor-pointer",
					p.Class,
				),
			}
			{ p.Attributes... }
		>
			<span class={ utils.TwMerge("size-2 rounded-full shrink-0", p.dotColor()) }></span>
			<span class="truncate">{ p.displayTitle() }</span>
		</a>
	} else {
		<span
			if p.ID != "" {
				id={ p.ID }
			}
			class={
				utils.TwMerge(
					"inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium",
					"bg-muted/50 text-foreground",
					p.Class,
				),
			}
			{ p.Attributes... }
		>
			<span class={ utils.TwMerge("size-2 rounded-full shrink-0", p.dotColor()) }></span>
			<span class="truncate">{ p.displayTitle() }</span>
		</span>
	}
}
