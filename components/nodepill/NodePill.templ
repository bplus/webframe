// Package nodepill renders a label with a colored dot: a compact pill for
// naming a thing whose kind should be scannable at a glance, such as an
// entry in a list or a reference in a table cell.
package nodepill

import (
	"github.com/bplus/webframe/components/badge"
	"github.com/bplus/webframe/utils"
)

// Props configures a NodePill.
//
// Variant picks the dot color from the badge variants, with the same
// tokens a timeline dot of that variant uses: success, warning, info and
// destructive dots in their tokens, secondary a muted dot, outline a
// hollow one, and the zero value the primary dot. An app with its own
// kinds maps them to variants once:
//
//	var kindVariant = map[string]badge.Variant{
//		"service": badge.VariantInfo,
//		"error":   badge.VariantDestructive,
//	}
//	nodepill.NodePill(nodepill.Props{Title: n.Name, Variant: kindVariant[n.Kind]})
//
// badge.Status(word).Variant does the same for status words.
//
// The title wraps by default, breaking long unspaced words if it must, so
// it never clips or overflows a table cell; the dot stays beside the first
// line. Truncate keeps it on one line instead, cut with an ellipsis at the
// narrower of its container and 15rem, with the full title as a tooltip.
// A non-empty Href makes the pill a link.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Title      string
	Variant    badge.Variant
	Href       string
	Truncate   bool
}

// rootClass is the pill's class list; link adds the hover affordance.
func (p Props) rootClass(link bool) string {
	return utils.TwMerge(
		"inline-flex max-w-full items-start gap-1.5 rounded-xl border border-border px-2.5 py-0.5 align-middle text-xs font-medium",
		"bg-muted/50 text-foreground",
		utils.If(p.Truncate, "max-w-[min(100%,15rem)]"),
		utils.If(link, "hover:bg-muted transition-colors cursor-pointer"),
		p.Class,
	)
}

// dotClass sizes the dot and drops it by half the line box minus half the
// dot (1rem line, 0.5rem dot) so it centers on the first line of text.
func (p Props) dotClass() string {
	return utils.TwMerge("mt-1 size-2 shrink-0 rounded-full", badge.DotClass(p.Variant))
}

func (p Props) titleClass() string {
	if p.Truncate {
		return "min-w-0 truncate"
	}
	return "min-w-0 wrap-anywhere"
}

// NodePill renders Props as a <span>, or an <a> when Href is set (templ
// sanitizes unsafe schemes). It takes no children; only the first Props is
// used.
templ NodePill(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Href != "" {
		<a
			href={ p.Href }
			if p.ID != "" {
				id={ p.ID }
			}
			class={ p.rootClass(true) }
			{ p.Attributes... }
		>
			@content(p)
		</a>
	} else {
		<span
			if p.ID != "" {
				id={ p.ID }
			}
			class={ p.rootClass(false) }
			{ p.Attributes... }
		>
			@content(p)
		</span>
	}
}

templ content(p Props) {
	<span aria-hidden="true" data-nodepill-dot class={ p.dotClass() }></span>
	<span
		data-nodepill-title
		class={ p.titleClass() }
		if p.Truncate {
			title={ p.Title }
		}
	>{ p.Title }</span>
}
