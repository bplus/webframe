// Package banner renders an inline notice: a left-bordered, softly tinted
// block with a title, body, optional details (e.g. a list of field errors),
// actions and a dismiss button. Use it for a form page's error summary and
// for any notice that is not a one-shot flash (see package flash).
package banner

import (
	"github.com/bplus/webframe/components/action"
	"github.com/bplus/webframe/components/icon"
	"github.com/bplus/webframe/utils"
)

// Variant selects the color and the ARIA role. The zero value is Info.
type Variant string

const (
	VariantInfo    Variant = ""
	VariantSuccess Variant = "success"
	VariantWarning Variant = "warning"
	// VariantError renders with role="alert"; the others use role="status".
	VariantError Variant = "error"
)

// Props configures Banner.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes

	Variant Variant
	// Title is the bold first line; Body the plain text under it.
	Title, Body string
	// Details renders after the body, e.g. a <ul> of field errors.
	Details templ.Component
	// Dismissible adds a close button that hides the banner with Alpine.
	// The dismissal is not remembered across page loads.
	Dismissible bool
	// Actions render as a button row under the text.
	Actions []action.Action
}

// hasContent reports whether there is anything to show. Variant, Actions and
// Dismissible alone do not make a banner.
func (p Props) hasContent() bool {
	return p.Title != "" || p.Body != "" || p.Details != nil
}

// Role returns the ARIA live-region role for v: alert for VariantError,
// status otherwise. Package toast uses it too.
func Role(v Variant) string {
	if v == VariantError {
		return "alert"
	}
	return "status"
}

// Tone returns the color classes for v: a left border, a soft tint and a
// text color from one token (destructive for VariantError). Package toast
// uses it too.
func Tone(v Variant) string {
	switch v {
	case VariantError:
		return "border-destructive bg-destructive/10 text-destructive"
	case VariantSuccess:
		return "border-success bg-success/10 text-success"
	case VariantWarning:
		return "border-warning bg-warning/10 text-warning"
	default:
		return "border-info bg-info/10 text-info"
	}
}

func (p Props) role() string { return Role(p.Variant) }

func (p Props) tone() string { return Tone(p.Variant) }

func (p Props) rootClass() string {
	return utils.TwMerge(
		"flex items-start gap-3 rounded-md border-l-4 px-4 py-3",
		p.tone(),
		p.Class,
	)
}

// variantIcon picks the leading icon for the variant.
templ variantIcon(v Variant) {
	switch v {
		case VariantError:
			@icon.CircleAlert(icon.Props{Size: 20, Class: "shrink-0 mt-0.5"})
		case VariantSuccess:
			@icon.CircleCheck(icon.Props{Size: 20, Class: "shrink-0 mt-0.5"})
		case VariantWarning:
			@icon.TriangleAlert(icon.Props{Size: 20, Class: "shrink-0 mt-0.5"})
		default:
			@icon.Info(icon.Props{Size: 20, Class: "shrink-0 mt-0.5"})
	}
}

// Banner renders an inline notice. It renders nothing when Title, Body and
// Details are all empty, so a feedback slot can stay in the page and only
// show up when there is something to say.
templ Banner(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.hasContent() {
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			class={ p.rootClass() }
			role={ p.role() }
			if p.Dismissible {
				x-data="{ open: true }"
				x-show="open"
			}
			{ p.Attributes... }
		>
			@variantIcon(p.Variant)
			<div class="min-w-0 flex-1">
				if p.Title != "" {
					<p class="font-semibold">{ p.Title }</p>
				}
				if p.Body != "" {
					<p class="text-sm text-foreground">{ p.Body }</p>
				}
				if p.Details != nil {
					<div class="mt-1 text-sm text-foreground">
						@p.Details
					</div>
				}
				if len(p.Actions) > 0 {
					<div class="mt-3">
						@action.Group(p.Actions)
					</div>
				}
			</div>
			if p.Dismissible {
				<button
					type="button"
					class="shrink-0 rounded-sm opacity-70 transition-opacity hover:opacity-100 focus:outline-hidden focus:ring-2 focus:ring-ring focus:ring-offset-2"
					aria-label="Dismiss"
					x-on:click="open = false"
				>
					@icon.X(icon.Props{Size: 16})
					<span class="sr-only">Dismiss</span>
				</button>
			}
		</div>
	}
}
