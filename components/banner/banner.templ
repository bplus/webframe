// Package banner renders an inline notice: a left-bordered, softly tinted
// block with a title, body, optional details (e.g. a list of field errors),
// actions and a dismiss button. It is the page-level error summary for form
// pages and the inline notice for anything that is not a one-shot flash
// (the server flash, banner.Flash, lands in batch 3).
//
// Phone width (390px): the banner is a full-width block; the icon column
// stays, title/body/details stack, and the actions row wraps under them.
package banner

import (
	"github.com/bplus/webframe/components/action"
	"github.com/bplus/webframe/components/icon"
	"github.com/bplus/webframe/utils"
)

// Variant selects the color and the ARIA role. The zero value is Info.
type Variant string

const (
	// VariantInfo is the neutral informational notice (zero value).
	VariantInfo Variant = ""
	// VariantSuccess confirms a completed state. Use sparingly: pages do not
	// show success messages unless the user asked for one.
	VariantSuccess Variant = "success"
	// VariantWarning flags something that needs attention but did not fail.
	VariantWarning Variant = "warning"
	// VariantError reports a failure; it renders with role="alert".
	VariantError Variant = "error"
)

// Props configures a Banner. All fields are optional; a banner with no
// Title, Body and Details renders nothing at all.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes

	Variant Variant
	// Title is the bold first line; Body the plain text under it.
	Title, Body string
	// Details renders after the body, e.g. a <ul> of field errors.
	Details templ.Component
	// Dismissible adds a close button; the banner hides client-side via
	// Alpine (x-data/x-show inside the component) and is not remembered.
	Dismissible bool
	// Actions render as a button row under the text.
	Actions []action.Action
}

// hasContent reports whether there is anything to show. Variant, Actions and
// Dismissible alone do not make a banner.
func (p Props) hasContent() bool {
	return p.Title != "" || p.Body != "" || p.Details != nil
}

// role returns the ARIA live-region role: alert for errors, status otherwise.
func (p Props) role() string {
	if p.Variant == VariantError {
		return "alert"
	}
	return "status"
}

// tone returns the color classes for the variant. Error uses the existing
// destructive token; the others use the success/warning/info tokens.
func (p Props) tone() string {
	switch p.Variant {
	case VariantError:
		return "border-destructive bg-destructive/10 text-destructive"
	case VariantSuccess:
		return "border-success bg-success/10 text-success"
	case VariantWarning:
		return "border-warning bg-warning/10 text-warning"
	default:
		return "border-info bg-info/10 text-info"
	}
}

func (p Props) rootClass() string {
	return utils.TwMerge(
		"flex items-start gap-3 rounded-md border-l-4 px-4 py-3",
		p.tone(),
		p.Class,
	)
}

// variantIcon picks the leading icon for the variant.
templ variantIcon(v Variant) {
	switch v {
		case VariantError:
			@icon.CircleAlert(icon.Props{Size: 20, Class: "shrink-0 mt-0.5"})
		case VariantSuccess:
			@icon.CircleCheck(icon.Props{Size: 20, Class: "shrink-0 mt-0.5"})
		case VariantWarning:
			@icon.TriangleAlert(icon.Props{Size: 20, Class: "shrink-0 mt-0.5"})
		default:
			@icon.Info(icon.Props{Size: 20, Class: "shrink-0 mt-0.5"})
	}
}

// Banner renders an inline notice. It renders nothing when Title, Body and
// Details are all empty (so a feedback slot stays silent on success, and
// nothing on the page moves). Error banners carry role="alert"; every other
// variant carries role="status". Only the first Props value is used.
templ Banner(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.hasContent() {
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			class={ p.rootClass() }
			role={ p.role() }
			if p.Dismissible {
				x-data="{ open: true }"
				x-show="open"
			}
			{ p.Attributes... }
		>
			@variantIcon(p.Variant)
			<div class="min-w-0 flex-1">
				if p.Title != "" {
					<p class="font-semibold">{ p.Title }</p>
				}
				if p.Body != "" {
					<p class="text-sm text-foreground">{ p.Body }</p>
				}
				if p.Details != nil {
					<div class="mt-1 text-sm text-foreground">
						@p.Details
					</div>
				}
				if len(p.Actions) > 0 {
					<div class="mt-3">
						@action.Group(p.Actions)
					</div>
				}
			</div>
			if p.Dismissible {
				<button
					type="button"
					class="shrink-0 rounded-sm opacity-70 transition-opacity hover:opacity-100 focus:outline-hidden focus:ring-2 focus:ring-ring focus:ring-offset-2"
					aria-label="Dismiss"
					x-on:click="open = false"
				>
					@icon.X(icon.Props{Size: 16})
					<span class="sr-only">Dismiss</span>
				</button>
			}
		</div>
	}
}
