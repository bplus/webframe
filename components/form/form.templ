// templui component form - version: v1.3.0 installed by templui v1.3.0
// 📚 Documentation: https://templui.io/docs/components/form
package form

import (
	"sort"

	"github.com/bplus/webframe/components/label"
	"github.com/bplus/webframe/utils"
)

// Props configures Form. The zero value renders <form method="post"> with no
// action (submits to the current URL). Attributes are spread last, so they
// win over anything Props emits.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// Action is the submit URL (sanitized by templ). Empty omits it.
	Action string
	// Method defaults to "post".
	Method string
	// HxPost, HxGet, HxTarget and HxSwap emit the matching hx-* attributes
	// when set. They are independent of Action/Method: set both for a form
	// that works with and without htmx.
	HxPost, HxGet, HxTarget, HxSwap string
	// Hidden renders one hidden input per entry before the children, in
	// sorted key order so markup is deterministic.
	Hidden map[string]string
	// NoValidate disables the browser's own required/pattern checks.
	NoValidate bool
	// Multipart sets enctype="multipart/form-data", required for file inputs.
	Multipart bool
}

// MessageVariant selects the color of a Message. The zero value inherits
// the surrounding text color.
type MessageVariant string

// Message variants: errors use the destructive color, hints the info color.
const (
	MessageVariantError MessageVariant = "error"
	MessageVariantInfo  MessageVariant = "info"
)

// ItemProps configures Item and ItemFlex.
type ItemProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// LabelProps configures Label.
type LabelProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// For is the id of the control this label describes. It must match the
	// control's rendered id, so give auto-id components like input an
	// explicit ID.
	For string
}

// DescriptionProps configures Description.
type DescriptionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// MessageProps configures Message.
type MessageProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Variant    MessageVariant
}

// Form renders a <form> element; app code uses it instead of a raw <form>
// tag, which wflint forbids. Hidden inputs render before the children. It
// has no layout of its own.
templ Form(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Method == "" {
		{{ p.Method = "post" }}
	}
	<form
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Class != "" {
			class={ utils.TwMerge(p.Class) }
		}
		if p.Action != "" {
			action={ p.Action }
		}
		method={ p.Method }
		if p.Multipart {
			enctype="multipart/form-data"
		}
		novalidate?={ p.NoValidate }
		if p.HxPost != "" {
			hx-post={ p.HxPost }
		}
		if p.HxGet != "" {
			hx-get={ p.HxGet }
		}
		if p.HxTarget != "" {
			hx-target={ p.HxTarget }
		}
		if p.HxSwap != "" {
			hx-swap={ p.HxSwap }
		}
		{ p.Attributes... }
	>
		for _, k := range hiddenKeys(p.Hidden) {
			<input type="hidden" name={ k } value={ p.Hidden[k] }/>
		}
		{ children... }
	</form>
}

// hiddenKeys returns the keys of m in sorted order.
func hiddenKeys(m map[string]string) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}

// Item stacks one form field vertically: typically Label, the control,
// Description and Message.
templ Item(props ...ItemProps) {
	{{ var p ItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("space-y-2", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// ItemFlex is the horizontal counterpart of Item, for fields where the
// control sits beside its label (checkboxes, radios, switches).
templ ItemFlex(props ...ItemProps) {
	{{ var p ItemProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("items-center flex space-x-2", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Label wraps label.Label so form markup reads uniformly
// (form.Item > form.Label > form.Message).
templ Label(props ...LabelProps) {
	{{ var p LabelProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	@label.Label(label.Props{
		ID:         p.ID,
		Class:      p.Class,
		Attributes: p.Attributes,
		For:        p.For,
	}) {
		{ children... }
	}
}

// Description renders muted, always-visible helper text under a control.
templ Description(props ...DescriptionProps) {
	{{ var p DescriptionProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<p
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("text-sm text-muted-foreground", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</p>
}

// Message renders a feedback line, such as a validation error, colored by
// Variant. It has no show/hide logic: the caller renders it only when there
// is something to say.
templ Message(props ...MessageProps) {
	{{ var p MessageProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<p
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			utils.TwMerge(
				"text-[0.8rem] font-medium",
				messageVariantClass(p.Variant),
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</p>
}

func messageVariantClass(variant MessageVariant) string {
	switch variant {
	case MessageVariantError:
		return "text-destructive"
	case MessageVariantInfo:
		return "text-info"
	default:
		return ""
	}
}
