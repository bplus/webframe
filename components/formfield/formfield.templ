package formfield

import (
	"strconv"

	"github.com/bplus/webframe/components/checkbox"
	"github.com/bplus/webframe/components/datetimepicker"
	"github.com/bplus/webframe/components/filedrop"
	"github.com/bplus/webframe/components/form"
	"github.com/bplus/webframe/components/input"
	"github.com/bplus/webframe/components/radio"
	"github.com/bplus/webframe/components/rating"
	"github.com/bplus/webframe/components/selectbox"
	"github.com/bplus/webframe/components/tagsinput"
	"github.com/bplus/webframe/components/textarea"
	"github.com/bplus/webframe/components/toggle"
	"github.com/bplus/webframe/utils"
)

func rootClass(f Field) string {
	return utils.TwMerge("wf-field flex flex-col gap-1", utils.If(f.Width == WidthFull, "md:col-span-2"))
}

// FormField renders one field: label, control, optional help line, and
// a Feedback wrapper (id f.FeedbackID()) holding the error or opt-in
// success text. With neither set, nothing below the control is visible
// and no space is reserved. TypeHidden renders only the hidden input.
// TypeCheckbox and TypeToggle put the label inline after the control on
// one row. TypeTags, TypeRating, the date and time types and TypeFile
// render the tagsinput, rating, datetimepicker and filedrop widgets with
// the same label, help, error and required wiring on the control that
// receives focus (the tags text input, the rating fieldset, the native
// date input, the hidden file input). With Validate set the control
// carries the htmx wiring that swaps the Feedback wrapper (see
// Field.Validate and RespondFeedback).
// Phone width: label, control and messages stack in one column; the
// Fieldset grid decides whether two fields share a row; each widget's
// own phone behavior is in its package doc.
templ FormField(f Field) {
	if f.Type == TypeHidden {
		@hiddenControl(f)
	} else {
		<div class={ rootClass(f) } data-wf-field={ f.Name }>
			switch f.Type {
				case TypeCheckbox:
					@checkboxControl(f)
				case TypeToggle:
					@toggleControl(f)
				case TypeRadio:
					@fieldLabel(f, "")
					@radioControl(f)
				case TypeSelect:
					@fieldLabel(f, f.ControlID())
					@selectControl(f)
				case TypeTextarea:
					@fieldLabel(f, f.ControlID())
					@textareaControl(f)
				case TypeTags:
					@fieldLabel(f, f.ControlID())
					@tagsControl(f)
				case TypeRating:
					@fieldLabel(f, "")
					@ratingControl(f)
				case TypeDate, TypeDateTime, TypeTime:
					@fieldLabel(f, f.ControlID())
					@dateControl(f)
				case TypeFile:
					@fieldLabel(f, fileProps(f).ControlID())
					@fileControl(f)
				default:
					@fieldLabel(f, f.ControlID())
					@textControl(f)
			}
			if f.Help != "" {
				@form.Description(form.DescriptionProps{ID: f.HelpID()}) {
					{ f.Help }
				}
			}
			@Feedback(f.FeedbackID(), f.Error, f.Success)
		</div>
	}
}

// fieldLabel renders the label (if any) with a required marker. forID
// empty omits the for attribute (radio groups label a div, not a control).
templ fieldLabel(f Field, forID string) {
	if f.Label != "" {
		@form.Label(form.LabelProps{ID: f.ControlID() + "-label", For: forID}) {
			{ f.Label }
			if f.Required {
				<span aria-hidden="true" class="text-destructive">*</span>
			}
		}
	}
}

templ textControl(f Field) {
	@input.Input(input.Props{
		ID:          f.ControlID(),
		Name:        f.Name,
		Type:        inputType(f.Type),
		Placeholder: f.Placeholder,
		Value:       f.Value,
		Disabled:    f.Disabled,
		HasError:    f.Error != "",
		Attributes:  f.controlAttrs(true),
	})
}

templ textareaControl(f Field) {
	@textarea.Textarea(textarea.Props{
		ID:          f.ControlID(),
		Name:        f.Name,
		Placeholder: f.Placeholder,
		Value:       f.Value,
		Disabled:    f.Disabled,
		HasError:    f.Error != "",
		Attributes:  f.controlAttrs(true),
	})
}

// selectControl: selectbox.Trigger spreads Attributes on its hidden
// input, which is what carries the value on submit and what a Validate
// hx-trigger="change" fires on, so name/required/hx-* go there. The
// announced state (aria-describedby, aria-invalid, aria-required) goes
// on the visible button through ButtonAttributes, because screen readers
// focus the button and ignore the hidden input.
templ selectControl(f Field) {
	@selectbox.SelectBox() {
		@selectbox.Trigger(selectbox.TriggerProps{
			ID:               f.ControlID(),
			Name:             f.Name,
			HasError:         f.Error != "",
			Disabled:         f.Disabled,
			Attributes:       f.controlAttrs(false),
			ButtonAttributes: f.ariaStateAttrs(),
		}) {
			@selectbox.Value(selectbox.ValueProps{Placeholder: f.Placeholder})
		}
		@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
			for _, opt := range f.Options {
				@selectbox.Item(selectbox.ItemProps{Value: opt.Value, Selected: opt.Value == f.Value}) {
					{ opt.Label }
				}
			}
		}
	}
}

templ checkboxControl(f Field) {
	<div class="flex items-center gap-2">
		@checkbox.Checkbox(checkbox.Props{
			ID:         f.ControlID(),
			Name:       f.Name,
			Checked:    f.Value != "",
			Disabled:   f.Disabled,
			Attributes: f.controlAttrs(true),
		})
		@fieldLabel(f, f.ControlID())
	</div>
}

// toggleControl renders toggle.Toggle with the label text as its
// children: the Toggle root is itself a <label> wrapping the switch, so
// a second form.Label would double-label the control. ID and Attributes
// land on the <input role="switch">, which is what submits and what a
// Validate hx-trigger="change" fires on.
templ toggleControl(f Field) {
	@toggle.Toggle(toggle.Props{
		ID:         f.ControlID(),
		Name:       f.Name,
		Checked:    f.Value != "",
		Disabled:   f.Disabled,
		Attributes: f.toggleAttrs(),
	}) {
		if f.Label != "" {
			<span>
				{ f.Label }
				if f.Required {
					<span aria-hidden="true" class="text-destructive">*</span>
				}
			</span>
		}
	}
}

templ radioControl(f Field) {
	<div
		id={ f.ControlID() }
		role="radiogroup"
		if f.Label != "" {
			aria-labelledby={ f.ControlID() + "-label" }
		}
		aria-describedby={ f.describedBy() }
		class="flex flex-col gap-2"
	>
		for i, opt := range f.Options {
			<label class="flex items-center gap-2 text-sm">
				@radio.Radio(radio.Props{
					ID:         f.ControlID() + "-" + strconv.Itoa(i),
					Name:       f.Name,
					Value:      opt.Value,
					Checked:    opt.Value == f.Value,
					Disabled:   f.Disabled,
					Attributes: f.controlAttrs(false),
				})
				{ opt.Label }
			</label>
		}
	</div>
}

// tagsControl renders tagsinput with f.ControlID() as the text input's
// id (the label's target and the focused control), the comma-split Value
// as chips and the Options' labels as suggestions. HasError puts
// aria-invalid on the text input; the attributes add aria-describedby
// (merged by the widget with its own hint id), aria-required and the
// Validate wiring, never `required` (the text input is not what submits).
templ tagsControl(f Field) {
	@tagsinput.TagsInput(tagsinput.Props{
		ID:          f.ControlID(),
		Name:        f.Name,
		Values:      f.tagValues(),
		Placeholder: f.Placeholder,
		Disabled:    f.Disabled,
		HasError:    f.Error != "",
		Suggestions: f.suggestions(),
		Attributes:  f.widgetAttrs(false, true),
	})
}

// ratingControl renders rating in input mode: the fieldset is
// f.ControlID() and carries aria-labelledby (the form.Label above it),
// aria-describedby, aria-invalid and aria-required; Required puts
// `required` on the radio group through the widget.
templ ratingControl(f Field) {
	@rating.Rating(rating.Props{
		ID:         f.ControlID(),
		Name:       f.Name,
		Value:      f.ratingValue(),
		Max:        f.ratingMax(),
		Required:   f.Required,
		Disabled:   f.Disabled,
		Attributes: f.ratingAttrs(),
	})
}

// dateControl renders datetimepicker for TypeDate, TypeDateTime and
// TypeTime with Value echoed verbatim (ValueString) and MinValue/MaxValue
// as min/max; aria-invalid lands on the <input>, which the input
// component styles as an error.
templ dateControl(f Field) {
	@datetimepicker.DateTimePicker(datetimepicker.Props{
		ID:          f.ControlID(),
		Name:        f.Name,
		Kind:        dateKind(f.Type),
		ValueString: f.Value,
		Min:         f.MinValue,
		Max:         f.MaxValue,
		Required:    f.Required,
		Disabled:    f.Disabled,
		Attributes:  f.widgetAttrs(true, false),
	})
}

// fileProps builds the filedrop Props for f: the root is f.ControlID()
// and the hidden <input type="file"> is fileProps(f).ControlID()
// (f.ControlID()+"-input"), which the label and the aria wiring target.
func fileProps(f Field) filedrop.Props {
	return filedrop.Props{
		ID:         f.ControlID(),
		Name:       f.Name,
		Accept:     f.Accept,
		Multiple:   f.Multiple,
		Preview:    f.Preview,
		Required:   f.Required,
		Disabled:   f.Disabled,
		Attributes: f.widgetAttrs(true, false),
	}
}

// fileControl renders filedrop; aria-invalid on the hidden input turns
// the zone's border destructive (has-aria-invalid).
templ fileControl(f Field) {
	@filedrop.FileDrop(fileProps(f))
}

templ hiddenControl(f Field) {
	<input type="hidden" id={ f.ControlID() } name={ f.Name } value={ f.Value }/>
}

// Feedback is the per-field message slot and the hx-swap target for
// single-field validation. errMsg renders as a red message with
// role="alert" (a freshly swapped-in alert node is what screen readers
// announce); otherwise a non-empty success renders as a muted line;
// otherwise the wrapper is empty and hidden by `empty:hidden`,
// reserving no space.
//
// The HTMX swap MUST be hx-swap="outerHTML" targeting "#"+id
// (Field.FeedbackID()): innerHTML would nest a second wrapper inside the
// first, duplicate the id, and defeat `empty:hidden`. For TypeSelect the
// Field Attributes land on a hidden input that never blurs, so validate
// it with hx-trigger="change".
templ Feedback(id, errMsg, success string) {
	<div id={ id } class="empty:hidden" data-wf-feedback>
		if errMsg != "" {
			@form.Message(form.MessageProps{
				Variant:    form.MessageVariantError,
				Attributes: templ.Attributes{"role": "alert"},
			}) {
				{ errMsg }
			}
		} else if success != "" {
			<p class="text-sm text-muted-foreground">{ success }</p>
		}
	</div>
}

// Fieldset renders a <fieldset> with an optional legend and a grid of
// FormFields: one column on phones, two on md+, where WidthFull fields
// span both columns.
templ Fieldset(p FieldsetProps) {
	<fieldset
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("wf-fieldset flex flex-col gap-4", p.Class) }
		{ p.Attributes... }
	>
		if p.Legend != "" {
			<legend class="text-base font-semibold">{ p.Legend }</legend>
		}
		<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
			for _, f := range p.Fields {
				@FormField(f)
			}
		</div>
	</fieldset>
}
