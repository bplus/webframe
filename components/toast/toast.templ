// Package toast renders a transient notice that floats over the page: the
// answer to an htmx action that did not re-render the thing the user acted
// on (a save that kept the form, a bulk action on a list). A toast has a
// title, an optional body, a dismiss button and a timer; it is colored by
// Kind from the same token mapping banner uses (banner.Tone, banner.Role),
// so a toast and a banner of the same kind look and are announced alike.
//
// Send is for htmx responses only: it appends the toast out-of-band to the
// #toast-container the appshell Document already renders, and writes
// nothing at all for a non-htmx request. A handler that redirects cannot
// carry a toast (the browser follows the redirect and the response body is
// never swapped); it sets a one-shot flash instead (package flash), which
// the shell renders on the next page.
//
// Error and Warning report failures; Success confirms an action whose
// result is not otherwise visible on the page (a job queued, a cache
// cleared, a save that leaves the user where they were); Info is a neutral
// notice. What webframe does not do is confirm every field: a valid field
// gets no "looks good" marker (formfield.Feedback stays empty on success).
//
// On a phone the toast stack sits at the top of the screen, full width
// minus gutters, above slide-over panels, so it never covers a sheet's
// buttons or the field above an on-screen keyboard.
package toast

import (
	"fmt"
	"time"

	"github.com/bplus/webframe/components/banner"
	"github.com/bplus/webframe/components/icon"
	"github.com/bplus/webframe/utils"
)

// Kind selects the color and the ARIA role. The zero value is KindInfo.
type Kind string

const (
	// KindInfo is the neutral notice (zero value).
	KindInfo Kind = ""
	// KindSuccess confirms a completed action.
	KindSuccess Kind = "success"
	// KindWarning flags something that needs attention but did not fail.
	KindWarning Kind = "warning"
	// KindError reports a failure; it renders with role="alert".
	KindError Kind = "error"
)

// DefaultTimeout is how long a toast stays when Props.Timeout is zero.
const DefaultTimeout = 4 * time.Second

// Props configures a Toast. A toast with neither Title nor Body renders
// nothing (and Send writes nothing).
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes

	Kind Kind
	// Title is the bold first line; Body the plain text under it.
	Title, Body string
	// Timeout is how long the toast stays before it dismisses itself.
	// Zero means DefaultTimeout (4s). Ignored when Sticky is set.
	Timeout time.Duration
	// Sticky keeps the toast until the user dismisses it.
	Sticky bool
}

// hasContent reports whether there is anything to show.
func (p Props) hasContent() bool {
	return p.Title != "" || p.Body != ""
}

// variant maps the Kind onto banner's Variant so the color and role
// mappings are shared, not copied.
func (p Props) variant() banner.Variant {
	switch p.Kind {
	case KindError:
		return banner.VariantError
	case KindSuccess:
		return banner.VariantSuccess
	case KindWarning:
		return banner.VariantWarning
	default:
		return banner.VariantInfo
	}
}

// timeoutMS is the auto-dismiss delay in milliseconds, DefaultTimeout when
// Timeout is zero or negative.
func (p Props) timeoutMS() int64 {
	if p.Timeout <= 0 {
		return DefaultTimeout.Milliseconds()
	}
	return p.Timeout.Milliseconds()
}

// initExpr is the Alpine x-init expression that hides the toast after the
// timeout. show=false runs the leave transition and then display:none, so
// the stack collapses around it; effectExpr then removes the element.
func (p Props) initExpr() string {
	return fmt.Sprintf("setTimeout(() => show = false, %d)", p.timeoutMS())
}

// removeDelayMS is how long after show=false the toast element is removed:
// longer than x-transition's default leave, and a plain timer so the toast
// is removed even when no transition runs.
const removeDelayMS = 300

// effectExpr is the Alpine x-effect expression that removes the toast
// element once show is false, so dismissed toasts do not accumulate in
// #toast-container.
func effectExpr() string {
	return fmt.Sprintf("if (!show) setTimeout(() => $el.remove(), %d)", removeDelayMS)
}

// rootClass is the floating card: opaque so the page does not bleed through
// the tone's soft tint, which sits on the inner block.
func (p Props) rootClass() string {
	return utils.TwMerge(
		"wf-toast overflow-hidden rounded-md bg-card shadow-lg",
		p.Class,
	)
}

// bodyClass carries banner's tone (left border, tint, text color).
func (p Props) bodyClass() string {
	return utils.TwMerge(
		"flex items-start gap-3 border-l-4 px-4 py-3",
		banner.Tone(p.variant()),
	)
}

// kindIcon picks the leading icon for the kind.
templ kindIcon(k Kind) {
	switch k {
		case KindError:
			@icon.CircleAlert(icon.Props{Size: 20, Class: "shrink-0 mt-0.5"})
		case KindSuccess:
			@icon.CircleCheck(icon.Props{Size: 20, Class: "shrink-0 mt-0.5"})
		case KindWarning:
			@icon.TriangleAlert(icon.Props{Size: 20, Class: "shrink-0 mt-0.5"})
		default:
			@icon.Info(icon.Props{Size: 20, Class: "shrink-0 mt-0.5"})
	}
}

// Toast renders one toast: role="alert" for errors, role="status"
// otherwise. The dismiss button and (unless Sticky) a timer hide it, and it
// is then removed from the DOM. Rendered on its own it appears where it is
// placed; OOB and Send route it to #toast-container. It renders nothing
// when Title and Body are both empty.
templ Toast(p Props) {
	if p.hasContent() {
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			class={ p.rootClass() }
			role={ banner.Role(p.variant()) }
			x-data="{ show: true }"
			x-show="show"
			x-transition
			x-effect={ effectExpr() }
			if !p.Sticky {
				x-init={ p.initExpr() }
			}
			{ p.Attributes... }
		>
			<div class={ p.bodyClass() }>
				@kindIcon(p.Kind)
				<div class="min-w-0 flex-1">
					if p.Title != "" {
						<p class="font-semibold">{ p.Title }</p>
					}
					if p.Body != "" {
						<p class="text-sm text-foreground">{ p.Body }</p>
					}
				</div>
				<button
					type="button"
					class="shrink-0 rounded-sm opacity-70 transition-opacity hover:opacity-100 focus:outline-hidden focus:ring-2 focus:ring-ring focus:ring-offset-2"
					aria-label="Dismiss"
					x-on:click="show = false"
				>
					@icon.X(icon.Props{Size: 16})
					<span class="sr-only">Dismiss</span>
				</button>
			</div>
		</div>
	}
}

// OOB renders Toast inside a wrapper carrying
// hx-swap-oob="beforeend:#toast-container", so htmx appends it to the
// toast container instead of the request's target. The wrapper is needed
// because for this swap style htmx inserts the element's content, not the
// element itself. Use OOB directly when the toast is one of several
// components in a response body.
templ OOB(p Props) {
	if p.Title != "" || p.Body != "" {
		<div hx-swap-oob="beforeend:#toast-container">
			@Toast(p)
		</div>
	}
}
