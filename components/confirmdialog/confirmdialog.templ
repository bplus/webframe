package confirmdialog

import (
	"github.com/bplus/webframe/components/button"
	"github.com/bplus/webframe/components/dialog"
	"github.com/bplus/webframe/utils"
)

// ConfirmDialog renders a closed alert dialog with a title, a message and
// Cancel / Confirm buttons; there is no close (X) button. It opens only
// through dialog.min.js, which must be on the page (appshell.Scripts
// includes it). Closed, it takes no space on the page. Below 400px the
// buttons stack.
templ ConfirmDialog(p Props) {
	{{ p = p.withDefaults() }}
	{{ id := p.ID }}
	if id == "" {
		{{ id = utils.RandomID() }}
	}
	@dialog.Dialog(dialog.Props{ID: id, Class: p.Class, Attributes: hostAttrs(p)}) {
		@dialog.Content(dialog.ContentProps{
			HideCloseButton:  true,
			DisableAutoFocus: true,
			Attributes: templ.Attributes{
				"role":             "alertdialog",
				"aria-modal":       "true",
				"aria-labelledby":  id + "-title",
				"aria-describedby": id + "-message",
			},
		}) {
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{ID: id + "-title", Attributes: templ.Attributes{"data-wf-confirm-part": "title"}}) {
					{ p.Title }
				}
				@dialog.Description(dialog.DescriptionProps{ID: id + "-message", Attributes: templ.Attributes{"data-wf-confirm-part": "message"}}) {
					{ p.Message }
				}
			}
			@dialog.Footer(dialog.FooterProps{Class: "flex-row flex-wrap justify-end"}) {
				@dialog.Close() {
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Class:      footerButtonClass,
						Attributes: templ.Attributes{"data-wf-confirm-part": "cancel"},
					}) {
						{ p.CancelLabel }
					}
				}
				@button.Button(button.Props{
					Variant:    button.VariantDefault,
					Class:      footerButtonClass,
					Attributes: templ.Attributes{"data-wf-confirm-part": "confirm", "hidden": p.Destructive},
				}) {
					{ p.ConfirmLabel }
				}
				@button.Button(button.Props{
					Variant:    button.VariantDestructive,
					Class:      footerButtonClass,
					Attributes: templ.Attributes{"data-wf-confirm-part": "confirm-destructive", "hidden": !p.Destructive},
				}) {
					{ p.ConfirmLabel }
				}
			}
		}
	}
}

// footerButtonClass makes a footer button full-width below 400px so the two
// wrap one per row there and sit side by side above it.
const footerButtonClass = "w-full min-[400px]:w-auto"

// Host renders the page's ConfirmDialog with ID HostID and the default
// texts. confirm.js fills and opens it for every hx-confirm request.
templ Host() {
	@ConfirmDialog(Props{ID: HostID})
}
