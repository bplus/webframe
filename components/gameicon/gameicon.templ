// Package gameicon renders icons from the game-icons.net SVG sprite.
// Icons are referenced by ID from /static/icons/game-icons.svg.
// Source: https://game-icons.net — License: CC BY 3.0
package gameicon

import "github.com/bplus/webframe/utils"

// Size is the rendered icon size. The zero value is medium.
type Size string

const (
	SizeSm Size = "sm" // h-6 w-6
	SizeMd Size = ""   // h-8 w-8
	SizeLg Size = "lg" // h-12 w-12
	SizeXL Size = "xl" // h-16 w-16
)

// Tone is the icon color, drawn from theme tokens. The zero value is the
// foreground color.
type Tone string

const (
	ToneDefault Tone = ""
	TonePrimary Tone = "primary"
	ToneAccent  Tone = "accent"
	ToneMuted   Tone = "muted"
)

// Props configures a game icon.
type Props struct {
	// Name is the icon ID without the "icon-" prefix (e.g. "broadsword", "armor-vest").
	Name string
	Size Size
	Tone Tone
	// Class is merged after Size and Tone, so it overrides them. Meant for
	// use inside webframe components; app code uses Size and Tone.
	Class string
}

func sizeClass(s Size) string {
	switch s {
	case SizeSm:
		return "h-6 w-6"
	case SizeLg:
		return "h-12 w-12"
	case SizeXL:
		return "h-16 w-16"
	default:
		return "h-8 w-8"
	}
}

func toneClass(t Tone) string {
	switch t {
	case TonePrimary:
		return "text-primary"
	case ToneAccent:
		return "text-accent-foreground"
	case ToneMuted:
		return "text-muted-foreground"
	default:
		return "text-foreground"
	}
}

// GameIcon renders an SVG use-reference to the game-icons sprite.
templ GameIcon(props Props) {
	<svg class={ utils.TwMerge(sizeClass(props.Size), toneClass(props.Tone), props.Class) } aria-hidden="true">
		<use href={ "/static/icons/game-icons.svg#icon-" + props.Name }></use>
	</svg>
}
