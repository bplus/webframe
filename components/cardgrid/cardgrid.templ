package cardgrid

import (
	"github.com/bplus/webframe/components/action"
	"github.com/bplus/webframe/components/aspectratio"
	"github.com/bplus/webframe/components/badge"
	"github.com/bplus/webframe/components/card"
	"github.com/bplus/webframe/components/emptystate"
	"github.com/bplus/webframe/components/image"
	"github.com/bplus/webframe/utils"
)

// CardGrid renders Props.Items as a responsive grid of cards: one column
// on phones, adding columns at the sm, lg and xl breakpoints up to the
// Columns cap. Sections of a card with nothing to show are omitted.
//
// When Href is set, the title link's ::after covers the whole card, so the
// entire card is clickable while the link stays its only focusable element.
// The footer sits above that overlay so its buttons remain clickable.
templ CardGrid(p Props) {
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge(p.gridClasses(), p.Class) }
		{ p.Attributes... }
	>
		if len(p.Items) == 0 {
			<div class="col-span-full">
				@emptystate.EmptyState(p.empty())
			</div>
		} else {
			for _, c := range p.Items {
				@gridCard(p, c)
			}
		}
	</div>
}

// gridCard renders one Card. The footer is pushed to the bottom so cards in
// a row line up their footers when their bodies differ in height.
templ gridCard(p Props, c Card) {
	@card.Card(card.Props{
		ID:    c.ID,
		Class: "relative flex h-full flex-col overflow-hidden transition-shadow hover:shadow-md",
	}) {
		if c.Art != nil {
			@aspectratio.AspectRatio(aspectratio.Props{Ratio: c.Art.ratio(), Class: "bg-muted"}) {
				@image.Image(image.Props{Src: c.Art.Src, Alt: c.Art.Alt, Fit: image.FitCover, Class: "h-full w-full"})
			}
		}
		@card.Content(card.ContentProps{Class: utils.TwMerge("flex flex-1 flex-col gap-2", p.padding())}) {
			@card.Title(card.TitleProps{Class: "text-base leading-snug break-words"}) {
				if c.Href != "" {
					<a
						href={ templ.URL(c.Href) }
						class="after:absolute after:inset-0 after:content-[''] hover:underline focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-inset focus-visible:after:ring-ring"
					>
						{ c.Title }
					</a>
				} else {
					{ c.Title }
				}
			}
			if c.Subtitle != "" {
				@card.Description() {
					{ c.Subtitle }
				}
			}
			if len(c.Badges) > 0 {
				<div class="flex flex-wrap gap-1.5">
					for _, b := range c.Badges {
						@badge.Badge(b.Props) {
							{ b.Label }
						}
					}
				</div>
			}
			if len(c.Meta) > 0 {
				<p class="text-xs text-muted-foreground break-words">
					{ c.metaLine() }
				</p>
			}
		}
		if c.hasFooter() {
			@card.Footer(card.FooterProps{Class: "relative z-10 mt-auto flex-wrap gap-2 " + p.padding() + " pt-0"}) {
				for _, a := range c.Actions {
					@action.Button(footerAction(a))
				}
				if c.Footer != nil {
					@c.Footer
				}
			}
		}
	}
}
