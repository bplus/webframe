package dashboardheader

import "github.com/bplus/webframe/utils"

// Props configures Header. Empty text fields omit their elements.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Title      string // the page's <h1>
	Subtitle   string
	TimeRange  string // a chip on the right, e.g. "Last 7 days"
	Sticky     bool   // pin to the top of the scroll container
}

// Header renders a dashboard page's title bar: the title and subtitle on
// the left, the time-range chip on the right.
templ Header(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			utils.TwMerge(
				"flex items-start justify-between pb-4 mb-2 border-b border-border",
				utils.If(p.Sticky, "sticky top-0 z-10 bg-background pt-4 -mt-4"),
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		<div>
			if p.Title != "" {
				<h1 class="text-2xl font-bold text-foreground tracking-tight">
					{ p.Title }
				</h1>
			}
			if p.Subtitle != "" {
				<p class="text-sm text-muted-foreground mt-1">
					{ p.Subtitle }
				</p>
			}
		</div>
		if p.TimeRange != "" {
			<span class="inline-flex items-center rounded-md bg-muted px-2.5 py-1 text-xs font-medium text-muted-foreground border border-border shrink-0">
				{ p.TimeRange }
			</span>
		}
	</div>
}
