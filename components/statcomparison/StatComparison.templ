package statcomparison

import "github.com/bplus/webframe/utils"

// Direction indicates which way a metric moved and controls both the
// delta's color and its arrow icon. The zero value (and any
// unrecognized value) renders like DirectionFlat: muted color and a
// horizontal-line icon.
type Direction string

const (
	// DirectionUp shows the delta in the success color with an up arrow.
	DirectionUp Direction = "up"
	// DirectionDown shows the delta in the destructive color with a down arrow.
	DirectionDown Direction = "down"
	// DirectionFlat shows the delta in muted gray with a flat line;
	// same rendering as the zero value.
	DirectionFlat Direction = "flat"
)

// Props configures a StatComparison tile. All display fields are
// preformatted strings — the component does no number formatting or
// delta math; callers supply Value, PrevValue, and Delta already
// rendered as text. Label, PrevValue, and Delta sections are each
// omitted when empty; Value is always emitted. Direction only matters
// when Delta is non-empty.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Label      string    // Metric name, e.g. "Total Nodes"
	Value      string    // Current value, e.g. "1,234"
	PrevValue  string    // Previous value, e.g. "1,100"
	Delta      string    // Change text, e.g. "+134" or "+12.2%"
	Direction  Direction // up, down, flat
}

// ToneClass is the theme text-color class for a direction: up →
// text-success, down → text-destructive, flat and the zero value →
// text-muted-foreground. It is the one place the direction→color mapping
// lives; stattile uses it so a tile's delta reads identically to a
// StatComparison's.
//
// @pure
func ToneClass(dir Direction) string {
	switch dir {
	case DirectionUp:
		return "text-success"
	case DirectionDown:
		return "text-destructive"
	default:
		return "text-muted-foreground"
	}
}

// Arrow renders the 16x16 trend icon for a direction as an inline SVG
// stroked in currentColor (so it takes the color of the ToneClass on its
// parent): an up arrow, a down arrow, or a flat line for DirectionFlat and
// the zero value. It is decorative (aria-hidden); the delta text beside it
// carries the meaning. Shared with stattile.
//
// @pure
templ Arrow(dir Direction) {
	if dir == DirectionUp {
		<svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<path d="M8 3v10M8 3l4 4M8 3L4 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	} else if dir == DirectionDown {
		<svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<path d="M8 13V3M8 13l4-4M8 13L4 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	} else {
		<svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<path d="M2 8h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
		</svg>
	}
}

// StatComparison renders a KPI tile that shows a current value against
// a previous one — label, big value with "from <prev>", and a colored
// delta row with a trend arrow. Use it in dashboards where the change
// matters as much as the number. Zero-value / omitted props render only
// an empty value line; only the first Props is used and extras are
// silently ignored. Returns a templ.Component rendering a vertical
// flex <div>; it takes no children — all content comes from Props.
//
// @pure
// @ai-context Colors are fixed to "up = success, down = destructive" via
// ToneClass; there is no way to flip the mapping for metrics where a
// decrease is good (e.g. error counts) other than choosing a different
// Direction than the arithmetic one. The arrow comes from Arrow, which
// stattile shares.
templ StatComparison(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("flex flex-col gap-1", p.Class) }
		{ p.Attributes... }
	>
		if p.Label != "" {
			<span class="text-xs font-medium text-muted-foreground uppercase tracking-wide">{ p.Label }</span>
		}
		<div class="flex items-baseline gap-2">
			<span class="text-2xl font-bold text-foreground">{ p.Value }</span>
			if p.PrevValue != "" {
				<span class="text-sm text-muted-foreground">from { p.PrevValue }</span>
			}
		</div>
		if p.Delta != "" {
			<div class={ utils.TwMerge("flex items-center gap-1 text-sm font-medium", ToneClass(p.Direction)) }>
				@Arrow(p.Direction)
				<span>{ p.Delta }</span>
			</div>
		}
	</div>
}
