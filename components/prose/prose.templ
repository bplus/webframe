package prose

// Prose renders a .wf-prose block holding either p.HTML verbatim (each
// top-level table wrapped in a scrolling div, see wrapTables) or p.Text
// escaped as paragraphs. With both set, HTML wins. Typography comes from the
// stylesheet, so the content needs no classes.
templ Prose(p Props) {
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ p.rootClass() }
		{ p.Attributes... }
	>
		if p.HTML != "" {
			@templ.Raw(wrapTables(string(p.HTML)))
		} else {
			for _, para := range p.paragraphs() {
				@paragraph(para)
			}
		}
	</div>
}

// paragraph renders one <p> holding paragraphHTML(lines): the lines
// escaped one by one and joined with <br>. Written as one Raw so templ
// adds no whitespace text nodes around the <br> (it keeps the whitespace
// between a text node and an adjacent control block as a space).
templ paragraph(lines []string) {
	<p>@templ.Raw(paragraphHTML(lines))</p>
}
