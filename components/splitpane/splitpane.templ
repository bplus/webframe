package splitpane

import (
	"github.com/bplus/webframe/components/action"
	"github.com/bplus/webframe/components/icon"
	"github.com/bplus/webframe/utils"
)

// widthClass maps the list column's tier to its md-and-up width. The
// strings live in this file so Tailwind's pinned source scan sees them.
func widthClass(w Width) string {
	switch w {
	case WidthSm:
		return "md:w-[280px]"
	case WidthLg:
		return "md:w-[440px]"
	default:
		return "md:w-[360px]"
	}
}

// listClass is the list column: full width on a phone, hidden there when
// the detail is showing; from md up a fixed-width, non-shrinking column
// that sticks under the shell's sticky chrome and scrolls on its own.
func listClass(p Props) string {
	return utils.TwMerge(
		"md:shrink-0 md:self-start md:sticky md:top-[var(--wf-sticky-top,0px)] md:max-h-[calc(100dvh-var(--wf-sticky-top,0px))] md:overflow-y-auto md:border-r md:border-border md:pr-6",
		widthClass(p.ListWidth),
		utils.If(p.Detail != nil, "hidden md:block"),
	)
}

// detailClass is the detail region: hidden on a phone while no item is
// selected, otherwise shown; from md up the flexible column.
func detailClass(p Props) string {
	return utils.TwMerge(
		"min-w-0 flex-1",
		utils.IfElse(p.Detail == nil, "hidden md:block", "block"),
	)
}

// SplitPane renders the list column and the detail region. From md up they
// are a flex row (list at its tier width, detail min-w-0 flex-1); below md
// one of them is hidden: the detail when Detail is nil, the list when it
// is set, in which case a ghost "Back" link (BackHref, BackLabel) precedes
// the detail and is itself hidden from md up. The detail region has id
// DetailID and, when Title is set, aria-label=Title. See the package doc
// for the routes and the list links.
//
// @pure
templ SplitPane(p Props) {
	<div
		id={ p.id() }
		class={ utils.TwMerge("md:flex md:items-start md:gap-6", p.Class) }
		{ p.Attributes... }
	>
		<div class={ listClass(p) }>
			if p.List != nil {
				@p.List
			}
		</div>
		<section
			id={ p.detailID() }
			class={ detailClass(p) }
			if p.Title != "" {
				aria-label={ p.Title }
			}
		>
			@detailContent(p)
		</section>
	</div>
}

// detailContent is the detail region's content: nothing when Detail is
// nil; otherwise the phone back link then Detail. Respond serves it alone
// for a list click from md up, so a swap leaves the region's innerHTML
// identical to a full render's.
templ detailContent(p Props) {
	if p.Detail != nil {
		<div class="md:hidden mb-4">
			@action.Button(backAction(p))
		</div>
		@p.Detail
	}
}

// backAction is the phone back link: a ghost link to BackHref with an
// arrow-left icon and BackLabel ("Back" when empty).
func backAction(p Props) action.Action {
	return action.Action{
		Href:    p.BackHref,
		Label:   p.backLabel(),
		Variant: action.VariantGhost,
		Icon:    icon.ArrowLeft(icon.Props{Size: 16}),
	}
}
