package autocomplete

import (
	"strconv"

	"github.com/bplus/webframe/components/form"
	"github.com/bplus/webframe/components/input"
	"github.com/bplus/webframe/utils"
)

// Props configures an Autocomplete. HxGet is required.
type Props struct {
	// ID is the text box's id; the listbox is ID+"-list". Defaults to a
	// random id.
	ID         string
	Class      string
	Attributes templ.Attributes // spread on the root

	// Name is the hidden field carrying the picked Value; "" renders no
	// hidden field, leaving free text only.
	Name string
	// TextName is the text box's name and the query parameter sent to
	// HxGet; defaults to "q".
	TextName    string
	Label       string // optional visible label
	Placeholder string
	Value       string // initial picked value (hidden field)
	Text        string // initial visible text

	// HxGet is the suggestions URL; it should return a Results fragment.
	// Empty renders an inline error.
	HxGet    string
	MinChars int // default 1: fewer typed characters → no request, list closed
	DelayMs  int // default 300: typing pause before the request fires
	// Required marks the text box required. With Name set, autocomplete.js
	// treats it as "an item was picked", not merely "text was typed".
	Required bool
	// Disabled disables the text box and the hidden value input, so a
	// disabled picker submits nothing.
	Disabled bool
}

// textName returns the visible input's name: TextName or "q".
func (p Props) textName() string {
	if p.TextName != "" {
		return p.TextName
	}
	return "q"
}

// Item is one suggestion. On pick, Label goes into the text box and Value
// into the hidden field. Description is muted text beside the label.
type Item struct{ Label, Value, Description string }

func (p Props) inputAttrs() templ.Attributes {
	a := templ.Attributes{
		"name":              p.textName(),
		"role":              "combobox",
		"aria-autocomplete": "list",
		"aria-expanded":     "false",
		"aria-controls":     p.ID + "-list",
		"autocomplete":      "off",
		"hx-get":            p.HxGet,
		"hx-trigger":        "input changed delay:" + strconv.Itoa(p.DelayMs) + "ms",
		"hx-target":         "#" + p.ID + "-list",
		"hx-swap":           "innerHTML",
		"data-wf-ac-input":  "",
	}
	if p.Required {
		a["required"] = true
	}
	return a
}

// Autocomplete renders a server-backed type-ahead: the text box fetches
// HxGet with htmx after DelayMs of typing and shows the returned Results.
// Picking an option fills the text box and hidden field and fires a
// bubbling "wf:autocomplete:select" event with detail {value, label}.
// Editing the text after a pick clears the hidden value. Picking and
// keyboard navigation need Script (included in appshell.Scripts).
templ Autocomplete(props Props) {
	{{ p := props }}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	if p.MinChars <= 0 {
		{{ p.MinChars = 1 }}
	}
	if p.DelayMs <= 0 {
		{{ p.DelayMs = 300 }}
	}
	<div
		class={ utils.TwMerge("relative", p.Class) }
		data-wf-autocomplete
		data-wf-ac-min={ strconv.Itoa(p.MinChars) }
		if p.Required && p.Name != "" {
			data-wf-ac-required
		}
		{ p.Attributes... }
	>
		if p.HxGet == "" {
			<span class="text-xs text-destructive">Error: Autocomplete missing required 'HxGet'</span>
		}
		if p.Label != "" {
			@form.Label(form.LabelProps{ID: p.ID + "-label", For: p.ID}) {
				{ p.Label }
			}
		}
		@input.Input(input.Props{
			ID:          p.ID,
			Type:        input.TypeSearch,
			Placeholder: p.Placeholder,
			Value:       p.Text,
			Disabled:    p.Disabled,
			Attributes:  p.inputAttrs(),
		})
		if p.Name != "" {
			<input type="hidden" name={ p.Name } value={ p.Value } disabled?={ p.Disabled } data-wf-ac-value/>
		}
		<div
			id={ p.ID + "-list" }
			role="listbox"
			if p.Label != "" {
				aria-labelledby={ p.ID + "-label" }
			}
			class="absolute left-0 right-0 z-20 mt-1 max-h-64 overflow-auto rounded-md border border-border bg-card shadow-md hidden"
			data-wf-ac-list
		></div>
	</div>
}

// Results renders the listbox contents for a query response, or a
// non-selectable "No matches" row when items is empty.
templ Results(items []Item) {
	if len(items) == 0 {
		<div role="option" aria-disabled="true" class="px-3 py-2 text-sm text-muted-foreground" data-wf-ac-empty>No matches</div>
	}
	for _, it := range items {
		<div role="option" tabindex="-1" class="cursor-pointer px-3 py-2 text-sm data-[active]:bg-muted hover:bg-muted" data-wf-ac-option data-wf-ac-item-value={ it.Value } data-wf-ac-item-label={ it.Label }>
			{ it.Label }
			if it.Description != "" {
				<span class="ml-2 text-muted-foreground">{ it.Description }</span>
			}
		</div>
	}
}

// Script loads autocomplete.js. Include it once per page; appshell.Scripts
// already does.
templ Script() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/static/js/autocomplete.js") }></script>
}
