// templui component avatar - version: v1.3.0 installed by templui v1.3.0
// 📚 Documentation: https://templui.io/docs/components/avatar
package avatar

import "github.com/bplus/webframe/utils"

// Props configures Avatar. The zero value is a 40px circle.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// Size sets the avatar's diameter; Class is merged after it and wins.
	Size Size
}

// Size is the avatar diameter. The zero value is medium.
type Size string

const (
	SizeSm Size = "sm" // h-8 w-8
	SizeMd Size = ""   // h-10 w-10
	SizeLg Size = "lg" // h-14 w-14
)

func sizeClass(s Size) string {
	switch s {
	case SizeSm:
		return "h-8 w-8"
	case SizeLg:
		return "h-14 w-14"
	default:
		return "h-10 w-10"
	}
}

// ImageProps configures Image. Src is URL-sanitized (an unsafe scheme such
// as javascript: renders as about:invalid). Alt is always emitted.
type ImageProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Alt        string
	Src        string
}

// FallbackProps configures Fallback.
type FallbackProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// Avatar renders a circular container for an image that falls back to
// initials or an icon. Children are an Image and/or a Fallback. The swap
// between them happens client-side in avatar.min.js (see Script); without
// it, both children stay visible.
templ Avatar(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		data-tui-avatar
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			utils.TwMerge(
				"relative flex shrink-0 overflow-hidden rounded-full",
				sizeClass(p.Size),
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Image renders the picture inside an Avatar. avatar.min.js finds it by
// the data-tui-avatar-image attribute and hides it if loading fails.
templ Image(props ...ImageProps) {
	{{ var p ImageProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<img
		data-tui-avatar-image
		if p.ID != "" {
			id={ p.ID }
		}
		if p.Src != "" {
			src={ templ.URL(p.Src) }
		}
		alt={ p.Alt }
		class={
			utils.TwMerge(
				"aspect-square h-full w-full",
				p.Class,
			),
		}
		{ p.Attributes... }
	/>
}

// Fallback renders the stand-in (typically initials or an icon, passed as
// children) shown when the Image is absent or fails to load. It renders
// visible and is hidden once the Image loads, so it can flash briefly.
templ Fallback(props ...FallbackProps) {
	{{ var p FallbackProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		data-tui-avatar-fallback
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			utils.TwMerge(
				"flex h-full w-full items-center justify-center rounded-full bg-muted",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

// Script loads avatar.min.js, which swaps Image and Fallback on load and
// error. Include it once per page that uses Avatar with a Fallback.
templ Script() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/static/js/avatar.min.js") }></script>
}
