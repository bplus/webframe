package sparkline

import (
	"fmt"
	"strings"
	"webframe/utils"
)

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Data       []float64 // Y-values (will be scaled to fit)
	Width      int       // SVG width in px (default 80)
	Height     int       // SVG height in px (default 24)
	Color      string    // Stroke color (Tailwind class-compatible, e.g. "currentColor" or hex)
	Fill       bool      // Fill area under line
}

func (p Props) resolveWidth() int {
	if p.Width > 0 {
		return p.Width
	}
	return 80
}

func (p Props) resolveHeight() int {
	if p.Height > 0 {
		return p.Height
	}
	return 24
}

// sparklinePadding is the SVG-pixel inset used by both the polyline
// and the fill polygon so they stay in sync.
const sparklinePadding = 2

func buildPolylinePoints(data []float64, w, h int) string {
	if len(data) == 0 {
		return ""
	}
	minVal, maxVal := data[0], data[0]
	for _, v := range data {
		if v < minVal {
			minVal = v
		}
		if v > maxVal {
			maxVal = v
		}
	}
	rang := maxVal - minVal
	if rang == 0 {
		rang = 1
	}
	plotW := float64(w - 2*sparklinePadding)
	plotH := float64(h - 2*sparklinePadding)
	pts := make([]string, len(data))
	for i, v := range data {
		x := float64(sparklinePadding) + float64(i)*plotW/float64(max(len(data)-1, 1))
		y := float64(sparklinePadding) + plotH - ((v-minVal)*plotH/rang)
		pts[i] = fmt.Sprintf("%.2f,%.2f", x, y)
	}
	return strings.Join(pts, " ")
}

templ Sparkline(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ w := p.resolveWidth() }}
	{{ h := p.resolveHeight() }}
	{{ points := buildPolylinePoints(p.Data, w, h) }}
	{{ var color string }}
	if p.Color == "" {
		{{ color = "currentColor" }}
	} else {
		{{ color = utils.SanitizeColor(p.Color) }}
	}
	<svg
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("inline-block", p.Class) }
		width={ fmt.Sprintf("%d", w) }
		height={ fmt.Sprintf("%d", h) }
		viewBox={ fmt.Sprintf("0 0 %d %d", w, h) }
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		{ p.Attributes... }
	>
		if len(p.Data) > 0 && p.Fill {
			{{ fillPoints := points + fmt.Sprintf(" %d,%d %d,%d", w-sparklinePadding, h-sparklinePadding, sparklinePadding, h-sparklinePadding) }}
			<polygon
				points={ fillPoints }
				fill={ color }
				fill-opacity="0.15"
			/>
		}
		if len(p.Data) > 0 {
			<polyline
				points={ points }
				stroke={ color }
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		}
	</svg>
}
