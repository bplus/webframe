package copybutton

import "github.com/bplus/webframe/utils"

// Size selects the button's size. "" renders as SizeDefault.
type Size string

// SizeDefault is a 32px button with a 16px icon; SizeSm is 24px with a 12px
// icon.
const (
	SizeDefault Size = "default"
	SizeSm      Size = "sm"
)

// Props configures CopyButton. Attributes cannot override the built-in id,
// type, class, x-data or x-on:click: a duplicate is emitted after them and
// HTML parsers keep the first.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Value      string // text copied to the clipboard
	Label      string // optional visible text beside the icon
	Size       Size
}

func (p Props) sizeClasses() string {
	switch p.Size {
	case SizeSm:
		return "h-6 w-6 [&>svg]:size-3"
	default:
		return "h-8 w-8 [&>svg]:size-4"
	}
}

// CopyButton renders an icon button that copies Props.Value to the
// clipboard and shows a check mark for 2 seconds. Value is JS-escaped, so
// any string is safe. It needs Alpine on the page, and the Clipboard API
// works only in secure contexts (HTTPS or localhost).
templ CopyButton(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<button
		if p.ID != "" {
			id={ p.ID }
		}
		type="button"
		class={
			utils.TwMerge(
				"inline-flex items-center justify-center rounded-md",
				"text-muted-foreground hover:text-foreground hover:bg-muted",
				"transition-colors cursor-pointer",
				p.sizeClasses(),
				utils.If(p.Label != "", "gap-1.5 px-2 w-auto"),
				p.Class,
			),
		}
		x-data="{ copied: false }"
		x-on:click={ "navigator.clipboard.writeText('" + utils.EscapeJS(p.Value) + "').then(() => { copied = true; setTimeout(() => copied = false, 2000) })" }
		{ p.Attributes... }
	>
		<template x-if="!copied">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
				<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
			</svg>
		</template>
		<template x-if="copied">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success">
				<polyline points="20 6 9 17 4 12"></polyline>
			</svg>
		</template>
		if p.Label != "" {
			<span class="text-xs">{ p.Label }</span>
		}
	</button>
}
