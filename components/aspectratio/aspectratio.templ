// templui component aspectratio - version: v1.3.0 installed by templui v1.3.0
// 📚 Documentation: https://templui.io/docs/components/aspect-ratio
package aspectratio

import "github.com/bplus/webframe/utils"

// Ratio names a preset width:height proportion. The zero value behaves
// like RatioAuto.
type Ratio string

const (
	// RatioAuto applies no ratio.
	RatioAuto Ratio = "auto"
	// RatioSquare is 1:1.
	RatioSquare Ratio = "square"
	// RatioVideo is 16:9.
	RatioVideo Ratio = "video"
	// RatioPortrait is 3:4.
	RatioPortrait Ratio = "portrait"
	// RatioWide is 2:1.
	RatioWide Ratio = "wide"
)

// Props configures AspectRatio.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Ratio      Ratio
}

// AspectRatio constrains its children to a fixed proportion, for media
// that should hold its shape while loading. Children are absolutely
// positioned to fill the box and should size themselves to 100%. With
// RatioAuto the box has zero height, since nothing in flow gives it one.
templ AspectRatio(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			utils.TwMerge(
				"relative w-full",
				ratioClass(p.Ratio),
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		<div class="absolute inset-0">
			{ children... }
		</div>
	</div>
}

func ratioClass(ratio Ratio) string {
	switch ratio {
	case RatioSquare:
		return "aspect-square"
	case RatioVideo:
		return "aspect-video"
	case RatioPortrait:
		return "aspect-[3/4]"
	case RatioWide:
		return "aspect-[2/1]"
	case RatioAuto:
		return "aspect-auto"
	default:
		return "aspect-auto"
	}
}
