package appshell

import (
	"context"
	"github.com/bplus/webframe/assets"
	"github.com/bplus/webframe/components/banner"
	"github.com/bplus/webframe/components/commandpalette"
	"github.com/bplus/webframe/components/confirmdialog"
	"github.com/bplus/webframe/components/toast"
)

// DocProps configures Document.
type DocProps struct {
	// Title is the page title; the document title is "{Title} — {AppName}",
	// just AppName when Title is empty, just Title when AppName is empty.
	Title   string
	AppName string
	// Lang is the <html lang> value; defaults to "en" when empty.
	Lang string
	// Head, when non-nil, renders extra content at the end of <head>.
	Head templ.Component
	// Palette, when non-nil, renders the command palette at the end of
	// <body>.
	Palette *commandpalette.Props
}

// htmxConfig makes htmx swap 4xx and 5xx responses like 2xx ones (htmx 2
// ignores error bodies by default), so the server can send a truthful
// status with a visible answer, such as a 422 form re-render. 204 still
// swaps nothing, and error statuses still fire htmx:responseError.
const htmxConfig = `{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true},{"code":"...","swap":true}]}`

// PageTitle returns the document title for title under the App in ctx,
// or "" when there is none. A fragment response can carry it in a <title>
// so htmx updates the tab after a swap.
func PageTitle(ctx context.Context, title string) string {
	app, ok := FromContext(ctx)
	if !ok {
		return ""
	}
	return docTitle(DocProps{Title: title, AppName: app.Name})
}

func docTitle(p DocProps) string {
	switch {
	case p.Title == "":
		return p.AppName
	case p.AppName == "":
		return p.Title
	}
	return p.Title + " — " + p.AppName
}

func docLang(p DocProps) string {
	if p.Lang == "" {
		return "en"
	}
	return p.Lang
}

// Document renders the full HTML document around its children: head with
// stylesheet, htmx, Alpine and an inline theme init (localStorage
// "wf-theme", default light, applied before paint), and a body ending in
// the optional palette, the LoadFailed toast template, #toast-container, the confirm dialog, the Scripts
// bundle, and a listener that initializes Alpine on htmx-swapped content.
templ Document(p DocProps) {
	<!DOCTYPE html>
	<html lang={ docLang(p) }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<title>{ docTitle(p) }</title>
			<link rel="stylesheet" href={ assets.URL("/static/css/output.css") }/>
			<script>
				// Flash-free theme init
				(function(){
					var t;
					try { t = localStorage.getItem('wf-theme'); } catch(e) {}
					// light is the product default; dark only applies via stored preference
					document.documentElement.setAttribute('data-theme', t || 'light');
				})();
			</script>
			<!-- htmx loads blocking, before the body is parsed; alpine is
			     deferred since it only needs to be ready before user
			     interaction, and it initializes swapped-in [x-data] itself. -->
			<meta name="htmx-config" content={ htmxConfig }/>
			<script src={ assets.URL("/static/js/htmx.min.js") }></script>
			<script defer src={ assets.URL("/static/js/alpine.min.js") }></script>
			if p.Head != nil {
				@p.Head
			}
		</head>
		<body class="wf-theme antialiased">
			@noscriptNotice()
			{ children... }
			if p.Palette != nil {
				@commandpalette.Palette(*p.Palette)
			}
			@loadFailedNotice()
			<div id="toast-container" class="wf-toast-container"></div>
			@confirmdialog.Host()
			@Scripts()
		</body>
	</html>
}

// LoadFailed is the toast shown when an htmx request that updates the
// element that sent it (a "Refresh" button with hx-get and no hx-target)
// fails: the element and the page stay as they were and this toast says
// so. errorpage.Respond sends it as the answer to such a request, and
// htmx-errors.js shows the copy Document renders when an error answer is
// not HTML and so cannot be swapped. An app changes the wording by
// assigning to it before serving, for example:
//
//	appshell.LoadFailed = toast.Error("Not loaded", "Check your connection and try again.")
var LoadFailed = toast.Props{
	Kind:  toast.KindError,
	Title: "Could not load that",
	Body:  "Nothing on the page changed. Try again in a moment.",
}

// loadFailedNotice renders LoadFailed inside an inert <template> (not
// shown, not read by screen readers, not started by Alpine) for
// htmx-errors.js to copy into #toast-container.
templ loadFailedNotice() {
	<template data-wf-load-failed>
		@toast.Toast(LoadFailed)
	</template>
}

// noscriptTitle and noscriptBody are the words of the notice a browser
// with JavaScript turned off shows at the top of every page. The list
// names the kinds of control that need JavaScript in any webframe app
// (htmx buttons, the filter bar, tabs, dropdown menus, the command
// palette, selectbox pickers, polling); a given app may use only some.
const (
	noscriptTitle = "JavaScript is turned off"
	noscriptBody  = "Pages, links and most forms still work. Delete and other in-place buttons, filters, tabs, menus, drop-down pickers, search and live updates need JavaScript."
)

// noscriptNotice is a warning banner inside <noscript>, so a browser
// running JavaScript ignores it and pays nothing for it.
templ noscriptNotice() {
	<noscript>
		<div class="p-3 sm:p-4">
			@banner.Banner(banner.Props{Variant: banner.VariantWarning, Title: noscriptTitle, Body: noscriptBody})
		</div>
	</noscript>
}
