package appshell

import (
	"github.com/bplus/webframe/assets"
	"github.com/bplus/webframe/components/autocomplete"
	"github.com/bplus/webframe/components/avatar"
	"github.com/bplus/webframe/components/checkbox"
	"github.com/bplus/webframe/components/dialog"
	"github.com/bplus/webframe/components/dropdown"
	"github.com/bplus/webframe/components/filterbar"
	"github.com/bplus/webframe/components/input"
	"github.com/bplus/webframe/components/label"
	"github.com/bplus/webframe/components/popover"
	"github.com/bplus/webframe/components/selectbox"
	"github.com/bplus/webframe/components/slideover"
	"github.com/bplus/webframe/components/tabs"
	"github.com/bplus/webframe/components/textarea"
)

// Scripts renders the standard script bundle: confirm.js (the htmx:confirm
// interceptor; htmx itself loads in <head>, so this is the first tag of the
// bundle and runs before any component script), then htmx-errors.js (the
// htmx:beforeSwap guard that refuses to swap a non-HTML error body or an
// error body aimed at a data-wf-swallow-errors element), then the Script()
// tag of tabs, popover, dropdown, dialog, selectbox, autocomplete, input,
// checkbox, textarea, avatar, label, slideover and filterbar, followed by
// theme-toggle.js. Document renders it at the end of <body>. It
// deliberately omits trafficstream and graphwidget; pages using those add
// their own Script(). The three first-party scripts each guard against a
// second run (window.wf.confirm, window.wf.errors, window.wf.theme), since
// htmx re-executes <script src> tags found in swapped content.
//
// @boundary
templ Scripts() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ assets.URL("/static/js/confirm.js") }></script>
	<script defer nonce={ templ.GetNonce(ctx) } src={ assets.URL("/static/js/htmx-errors.js") }></script>
	@tabs.Script()
	@popover.Script()
	@dropdown.Script()
	@dialog.Script()
	@selectbox.Script()
	@autocomplete.Script()
	@input.Script()
	@checkbox.Script()
	@textarea.Script()
	@avatar.Script()
	@label.Script()
	@slideover.Script()
	@filterbar.Script()
	<script defer nonce={ templ.GetNonce(ctx) } src={ assets.URL("/static/js/theme-toggle.js") }></script>
}
