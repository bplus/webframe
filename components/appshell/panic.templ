package appshell

// PanicPage is the body of the default 500 page: a short message, the
// request id and a plain link home to homeHref ("/" when empty). It uses
// no components, so it renders even when the app is broken.
templ PanicPage(requestID, homeHref string) {
	<main class="mx-auto w-full max-w-md px-4 py-12 text-center">
		<h1 class="text-2xl font-semibold tracking-tight">Something went wrong</h1>
		<p class="mt-2 text-muted-foreground">The server hit an error. Try again, and if it keeps happening, tell us the request id below.</p>
		if requestID != "" {
			<p class="mt-4 font-mono text-xs text-muted-foreground break-all">Request id: { requestID }</p>
		}
		<p class="mt-6"><a href={ panicHome(homeHref) } class="text-primary underline underline-offset-4">Go home</a></p>
	</main>
}
