package dashboardpage

import (
	"github.com/bplus/webframe/components/dashboardgrid"
	"github.com/bplus/webframe/components/layout"
	"github.com/bplus/webframe/components/pageheader"
	"github.com/bplus/webframe/components/stattile"
	"github.com/bplus/webframe/utils"
)

// Page renders the dashboard page in this order: pageheader, then one
// dashboardgrid.Grid (Flush, Gap from Props) holding a Slot per Tile with
// its stattile.StatTile, then a Slot per Section with its layout.Section
// (Level, Title, Description, Actions) wrapping Content. Tiles and
// sections share the one grid, so a 12-column row of tiles is followed by
// sections that may sit beside each other (8 + 4) on md and up. With no
// tiles and no sections only the header renders.
//
// Phone: dashboardgrid's root carries wf-dashgrid and every slot
// wf-dashslot; static/css/input.css collapses those below md (48rem,
// 768px at the default root font size) to one column with every span reset
// to 1 (!important, because the grid's columns and spans are inline styles
// computed from runtime values). So at 390px every tile and every section
// is full width, one per row, in declaration order, whatever ColSpan says;
// nothing in a tile overflows its cell because the slot is min-w-0 and
// stattile wraps its value row at a fixed graphic width. The collapse point
// is the same md every other layout uses (it was 900px until batch 5, so
// between 768 and 900 a dashboard was one column while layout.TwoColumn
// and cardgrid were two).
//
// @pure
templ Page(p Props) {
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("flex flex-col gap-6", p.Class) }
		{ p.Attributes... }
	>
		@pageheader.PageHeader(p.Header)
		if p.hasGrid() {
			@dashboardgrid.Grid(p.gridProps()) {
				for _, t := range p.Tiles {
					@dashboardgrid.Slot(t.slotProps()) {
						@stattile.StatTile(t.Props)
					}
				}
				for _, s := range p.Sections {
					@dashboardgrid.Slot(s.slotProps()) {
						@layout.Section(s.sectionProps()) {
							if s.Content != nil {
								@s.Content
							}
						}
					}
				}
			}
		}
	</div>
}
