// templui component dialog - version: v1.3.0 installed by templui v1.3.0
// 📚 Documentation: https://templui.io/docs/components/dialog
package dialog

import (
	"context"
	"github.com/bplus/webframe/components/icon"
	"github.com/bplus/webframe/utils"
)

type contextKey string

const (
	instanceKey contextKey = "dialogInstance"
	openKey     contextKey = "dialogOpen"
)

// Props configures Dialog. The zero value starts closed, dismissable by
// click-away and Escape, with a generated instance ID. Set ID only when a
// Trigger or Close outside the Dialog needs to reference it via For.
type Props struct {
	ID               string
	Class            string
	Attributes       templ.Attributes
	DisableClickAway bool // when true, clicking the backdrop does not close the dialog
	DisableESC       bool // when true, the Escape key does not close the dialog
	Open             bool // initial open state, propagated to Content via render context
}

// TriggerProps configures Trigger. Inside a Dialog the instance is
// inherited; set For only for a trigger placed outside it.
type TriggerProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	For        string // Reference to a specific dialog ID (for external triggers)
}

// ContentProps configures Content. Inside a Dialog, ID and Open come from
// the Dialog and these fields are ignored; set them only for a standalone
// Content.
type ContentProps struct {
	ID               string
	Class            string
	Attributes       templ.Attributes
	HideCloseButton  bool // suppress the default top-right X close button
	Open             bool // Initial open state for standalone usage (when no context)
	DisableAutoFocus bool // when true, focus is not moved into the dialog on open
}

// CloseProps configures Close. The zero value closes the nearest enclosing
// dialog; For targets a dialog by ID from anywhere on the page.
type CloseProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	For        string // ID of the dialog to close (optional, defaults to closest dialog)
}

// HeaderProps configures Header.
type HeaderProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// FooterProps configures Footer.
type FooterProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// TitleProps configures Title.
type TitleProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// DescriptionProps configures Description.
type DescriptionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// Dialog is the root that ties a Trigger and its Content together: it
// passes its instance ID and open state to nested parts through the render
// context. The parts compose as Dialog > Trigger, Content > Header > Title,
// Description, Footer, Close. Open and close are driven by dialog.min.js
// (see Script), not Alpine; without Script the markup is inert.
templ Dialog(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ instanceID := p.ID }}
	if instanceID == "" {
		{{ instanceID = utils.RandomID() }}
	}
	{{ ctx = context.WithValue(ctx, instanceKey, instanceID) }}
	{{ ctx = context.WithValue(ctx, openKey, p.Open) }}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-tui-dialog
		data-dialog-instance={ instanceID }
		if p.DisableClickAway {
			data-tui-dialog-disable-click-away="true"
		}
		if p.DisableESC {
			data-tui-dialog-disable-esc="true"
		}
		class={ utils.TwMerge("", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Trigger makes its children (typically a button) open the dialog. It
// targets For when set, otherwise the enclosing Dialog; with neither it is
// bound to nothing.
templ Trigger(props ...TriggerProps) {
	{{ var p TriggerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ instanceID := "" }}
	// Explicit For prop takes priority over inherited context
	if p.For != "" {
		{{ instanceID = p.For }}
	} else if val := ctx.Value(instanceKey); val != nil {
		{{ instanceID = val.(string) }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		data-tui-dialog-trigger={ instanceID }
		data-dialog-instance={ instanceID }
		data-tui-dialog-trigger-open="false"
		class={ utils.TwMerge("contents", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

// Content renders the modal: a full-screen backdrop and a centered panel
// holding the children and, unless HideCloseButton is set, an X close
// button.
templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	// Start with prop values as defaults
	{{ instanceID := p.ID }}
	{{ open := p.Open }}
	// Override with context values if available
	if val := ctx.Value(instanceKey); val != nil {
		{{ instanceID = val.(string) }}
	}
	if val := ctx.Value(openKey); val != nil {
		{{ open = val.(bool) }}
	}
	// Apply defaults if still empty
	if instanceID == "" {
		{{ instanceID = utils.RandomID() }}
	}
	<!-- Overlay -->
	<div
		class={ utils.TwMerge(
				// Black, not a theme color, so the scrim darkens in both
				// themes. Overlay ladder: slideover 55/60 < dialog 65 <
				// toast 70, so a confirm opened from a sheet sits on top.
				"fixed inset-0 z-[65] bg-black/50",
				"transition-opacity duration-300",
				"data-[tui-dialog-open=false]:opacity-0",
				"data-[tui-dialog-open=true]:opacity-100",
				"data-[tui-dialog-open=false]:pointer-events-none",
				"data-[tui-dialog-open=true]:pointer-events-auto",
				"data-[tui-dialog-hidden=true]:!hidden",
			) }
		data-tui-dialog-backdrop
		data-dialog-instance={ instanceID }
		if open {
			data-tui-dialog-open="true"
		} else {
			data-tui-dialog-open="false"
			data-tui-dialog-hidden="true"
		}
	></div>
	<!-- Content -->
	<div
		class={
			utils.TwMerge(
				// Base positioning
				"fixed z-[65] left-[50%] top-[50%] translate-x-[-50%] translate-y-[-50%]",
				// Style
				"bg-background rounded-lg border shadow-lg",
				// Layout
				"grid gap-4 p-6",
				// Size
				"w-full max-w-[calc(100%-2rem)] sm:max-w-lg",
				// Transitions
				"transition-all duration-200",
				// Scale animation
				"data-[tui-dialog-open=false]:scale-95",
				"data-[tui-dialog-open=true]:scale-100",
				// Opacity
				"data-[tui-dialog-open=false]:opacity-0",
				"data-[tui-dialog-open=true]:opacity-100",
				// Pointer events
				"data-[tui-dialog-open=false]:pointer-events-none",
				"data-[tui-dialog-open=true]:pointer-events-auto",
				// Hidden state
				"data-[tui-dialog-hidden=true]:!hidden",
				p.Class,
			),
		}
		data-tui-dialog-content
		data-dialog-instance={ instanceID }
		if p.DisableAutoFocus {
			data-tui-dialog-disable-autofocus="true"
		}
		if open {
			data-tui-dialog-open="true"
		} else {
			data-tui-dialog-open="false"
			data-tui-dialog-hidden="true"
		}
		{ p.Attributes... }
	>
		{ children... }
		if !p.HideCloseButton {
			<button
				class={ utils.TwMerge(
						// Positioning
						"absolute top-4 right-4",
						// Style
						"rounded-xs opacity-70",
						// Interactions
						"transition-opacity hover:opacity-100",
						// Focus states
						"focus:outline-none focus:ring-2",
						"focus:ring-ring focus:ring-offset-2",
						"ring-offset-background",
						// Hover/Data states
						"data-[tui-dialog-open=true]:bg-accent",
						"data-[tui-dialog-open=true]:text-muted-foreground",
						// Disabled state
						"disabled:pointer-events-none",
						// Icon styles
						"[&_svg]:pointer-events-none",
						"[&_svg]:shrink-0",
						"[&_svg:not([class*='size-'])]:size-4",
					) }
				data-tui-dialog-close={ instanceID }
				aria-label="Close"
				type="button"
			>
				@icon.X()
				<span class="sr-only">Close</span>
			</button>
		}
	</div>
}

// Close makes its children (e.g. a Cancel button) close a dialog: the one
// named by For, otherwise the nearest enclosing one.
templ Close(props ...CloseProps) {
	{{ var p CloseProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<span
		if p.ID != "" {
			id={ p.ID }
		}
		if p.For != "" {
			data-tui-dialog-close={ p.For }
		} else {
			data-tui-dialog-close
		}
		class={ utils.TwMerge("contents cursor-pointer", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</span>
}

// Header groups the Title and Description at the top of Content.
templ Header(props ...HeaderProps) {
	{{ var p HeaderProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("flex flex-col gap-2 text-center sm:text-left", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Footer holds the action row: stacked in reverse on mobile, right-aligned
// from sm up. Wrap buttons in Close to make them dismiss the dialog.
templ Footer(props ...FooterProps) {
	{{ var p FooterProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("flex flex-col-reverse gap-2 sm:flex-row sm:justify-end", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Title renders the dialog heading as an h2.
templ Title(props ...TitleProps) {
	{{ var p TitleProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<h2
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("text-lg leading-none font-semibold", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</h2>
}

// Description renders muted supporting text under the Title.
templ Description(props ...DescriptionProps) {
	{{ var p DescriptionProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<p
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("text-muted-foreground text-sm", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</p>
}

// Script loads dialog.min.js, which wires triggers, backdrop and Escape
// dismissal, and focus handling. Include it once per page that uses Dialog.
templ Script() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/static/js/dialog.min.js") }></script>
}
