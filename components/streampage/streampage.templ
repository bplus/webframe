package streampage

import (
	"github.com/bplus/webframe/components/layout"
	"github.com/bplus/webframe/components/pageheader"
	"github.com/bplus/webframe/components/trafficstream"
	"github.com/bplus/webframe/utils"
)

// introClass styles the intro <p>, the same muted line listpage uses.
const introClass = "text-sm text-muted-foreground"

// Page renders the stream page body (no shell) in this order: pageheader;
// then the intro line (when set) and
// the trafficstream panel, those three directly under the header or, when
// Aside is set, inside the main column of a layout.TwoColumn whose aside
// is Aside; then trafficstream.Script() once, unless NoScript. The root is
// a <div> carrying ID (when set), Class and Attributes. Phone behavior is
// in the package doc.
//
// @pure
templ Page(p Props) {
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("flex flex-col gap-6", p.Class) }
		{ p.Attributes... }
	>
		@pageheader.PageHeader(p.Header)
		if p.Aside != nil {
			@layout.TwoColumn(p.twoColumnProps()) {
				@body(p)
			}
		} else {
			@body(p)
		}
		if !p.NoScript {
			@trafficstream.Script()
		}
	</div>
}

// body is everything under the header: intro, stream.
templ body(p Props) {
	<div class="flex flex-col gap-4">
		if p.Intro != "" {
			<p class={ introClass }>{ p.Intro }</p>
		}
		@trafficstream.TrafficStream(p.Stream)
	</div>
}
