package detailpage

import (
	"github.com/bplus/webframe/components/descriptionlist"
	"github.com/bplus/webframe/components/layout"
	"github.com/bplus/webframe/components/pageheader"
	"github.com/bplus/webframe/components/tabs"
	"github.com/bplus/webframe/utils"
)

// Page renders the pageheader, then the summary, the tabs and the
// children, in that order. With Aside set, everything after the header sits
// in the main column of a layout.TwoColumn.
templ Page(p Props) {
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("flex flex-col gap-6", p.Class) }
		{ p.Attributes... }
	>
		@pageheader.PageHeader(p.Header)
		if p.Aside != nil {
			@layout.TwoColumn(p.twoColumnProps()) {
				@body(p) {
					{ children... }
				}
			}
		} else {
			@body(p) {
				{ children... }
			}
		}
	</div>
}

// body is everything under the header: summary, tabs, then children.
templ body(p Props) {
	<div class="flex flex-col gap-6">
		if len(p.Summary) > 0 {
			@descriptionlist.DescriptionList(p.summaryProps())
		}
		if len(p.Tabs) > 0 {
			@tabGroup(p)
		}
		{ children... }
	</div>
}

// tabGroup renders the tabs: the List of Triggers, then one Content panel
// per tab. active is resolved once so Trigger and Content agree.
templ tabGroup(p Props) {
	{{ active := p.activeTab() }}
	@tabs.Tabs(p.tabsProps()) {
		@tabs.List() {
			for _, t := range p.Tabs {
				@tabs.Trigger(tabs.TriggerProps{Value: t.ID, IsActive: t.ID == active, Attributes: t.triggerAttrs(t.ID == active)}) {
					{ t.Label }
				}
			}
		}
		for _, t := range p.Tabs {
			@tabs.Content(tabs.ContentProps{ID: t.PanelID(), Value: t.ID, IsActive: t.ID == active}) {
				if !t.Lazy() && t.Content != nil {
					@t.Content
				}
			}
		}
	}
}
