package authpage

import (
	"github.com/bplus/webframe/components/action"
	"github.com/bplus/webframe/components/banner"
	"github.com/bplus/webframe/components/card"
	"github.com/bplus/webframe/components/form"
	"github.com/bplus/webframe/components/formfield"
	"github.com/bplus/webframe/components/formpage"
	"github.com/bplus/webframe/components/layout"
	"github.com/bplus/webframe/utils"
)

// AuthPage renders the whole page body: a full-height centered card with
// the optional Logo, the app name, the error banner, the mode's content
// and the Footer. Respond wraps it in a document.
templ AuthPage(p Props) {
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("wf-authpage min-h-dvh flex items-center justify-center p-4", p.Class) }
		{ p.Attributes... }
	>
		@card.Card(card.Props{Class: "max-w-sm w-full"}) {
			@card.Content(card.ContentProps{Class: "flex flex-col gap-6"}) {
				if p.Logo != nil {
					<div class="flex justify-center">
						@p.Logo
					</div>
				}
				<h1 class="text-xl font-semibold text-center">{ p.heading() }</h1>
				if p.hasBanner() {
					@banner.Banner(banner.Props{
						Variant: banner.VariantError,
						Title:   p.bannerTitle(),
						Details: formpage.ErrorDetails(p.Fields, p.Errors),
					})
				}
				switch p.mode() {
					case ModeSignedOut, ModeForbidden:
						@messagePage(p)
					default:
						@signIn(p)
				}
				if p.Footer != nil {
					<div class="text-center text-sm text-muted-foreground">
						@p.Footer
					</div>
				}
			}
		}
	</div>
}

// signIn is the sign-in content: Message, the form, then Providers.
templ signIn(p Props) {
	if p.Message != "" {
		<p class="text-center text-sm text-muted-foreground">{ p.Message }</p>
	}
	@form.Form(p.formProps()) {
		for _, f := range p.fields() {
			@formfield.FormField(f)
		}
		@action.Button(p.submit())
	}
	if len(p.Providers) > 0 {
		@layout.Divider(layout.DividerProps{Label: "or"})
		<div class="flex flex-col gap-2">
			for _, a := range p.Providers {
				@action.Button(provider(a))
			}
		</div>
	}
}

// messagePage is the signed-out and forbidden content.
templ messagePage(p Props) {
	<p class="text-center text-sm text-muted-foreground">{ p.message() }</p>
	@action.Button(p.submit())
}

