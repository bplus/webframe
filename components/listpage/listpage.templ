package listpage

import (
	"github.com/bplus/webframe/components/action"
	"github.com/bplus/webframe/components/appshell"
	"github.com/bplus/webframe/components/datatable"
	"github.com/bplus/webframe/components/filterbar"
	"github.com/bplus/webframe/components/form"
	"github.com/bplus/webframe/components/layout"
	"github.com/bplus/webframe/components/pageheader"
	"github.com/bplus/webframe/components/pagination"
	"github.com/bplus/webframe/components/toolbar"
	"github.com/bplus/webframe/utils"
)

// Page renders the whole list page body without the shell: the page
// header, then (inside a layout.TwoColumn when Aside is set) the intro
// line, the filter bar, the toolbar and Results. See the package doc.
templ Page(p Props) {
	{{ base := p.base(appshell.PathFromContext(ctx)) }}
	<div
		id={ p.id() }
		class={ utils.TwMerge(p.Class) }
		{ p.Attributes... }
	>
		@pageheader.PageHeader(p.Header)
		if p.Aside != nil {
			@layout.TwoColumn(layout.TwoColumnProps{Aside: p.Aside}) {
				@body(p, base)
			}
		} else {
			@body(p, base)
		}
	</div>
}

// body is everything under the header: intro, filter bar, toolbar, results.
templ body(p Props, base string) {
	<div class="space-y-4">
		if p.Intro != "" {
			<p id={ p.introID() } class={ introClass }>{ p.Intro }</p>
		}
		if p.hasFilterBar() {
			@filterbar.FilterBar(p.filterbarProps(base))
		}
		if p.hasToolbar() {
			@toolbar.Toolbar(toolbar.Props{Left: p.Toolbar, Right: p.createActions()}) {
				if p.hasBulk() {
					@bulkForm(p)
				}
			}
		}
		@Results(p)
	</div>
}

// bulkForm is the bulk-actions form: one button per action; row
// checkboxes join it through their form attribute (see the package doc).
templ bulkForm(p Props) {
	@form.Form(form.Props{ID: p.bulkFormID(), Class: "flex flex-wrap items-center gap-2"}) {
		for _, a := range p.BulkActions {
			@action.Button(p.bulkAction(a))
		}
	}
}

// Results renders the swap region: <div id={ResultsID()}> holding only the
// datatable and the pagination, so sort, filter and page requests can
// replace it in place.
templ Results(p Props) {
	{{ base := p.base(appshell.PathFromContext(ctx)) }}
	<div id={ p.ResultsID() } class="space-y-3">
		@datatable.DataTable(p.tableProps(base))
		@pagination.Pagination(p.paginationProps())
	</div>
}

// resultsPart is what a results-only response carries: Results, then
// out-of-band copies of the filter bar's hidden sort/dir/per inputs (or the
// Sort select), of the Filters controls that have counts and of the intro
// line, so a header sort carries into the next filter change, a filter's
// counts are those of this response, and the intro's counts follow a
// delete. It is never rendered inside Page.
templ resultsPart(p Props) {
	@Results(p)
	if p.hasFilterBar() {
		@filterbar.HiddenOOB(p.filterbarID(), p.hiddenInputs(), p.sortControls()...)
	}
	if counted := p.filterControls(); len(counted) > 0 {
		@filterbar.ControlsOOB(p.filterbarID(), counted...)
	}
	if p.Intro != "" {
		<p id={ p.introID() } class={ introClass } hx-swap-oob="true">{ p.Intro }</p>
	}
}
