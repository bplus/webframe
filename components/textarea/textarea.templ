// templui component textarea - version: v1.3.0 installed by templui v1.3.0
// 📚 Documentation: https://templui.io/docs/components/textarea
package textarea

import (
	"github.com/bplus/webframe/utils"
	"strconv"
)

// Props configures Textarea. The zero value renders an enabled, empty
// textarea (min-height 80px) with a generated id. Class merges after
// the built-in classes via utils.TwMerge; Attributes spread onto the
// <textarea>.
type Props struct {
	// ID is auto-generated via utils.RandomID when empty. Set it
	// explicitly when a Label must reference this field via For.
	ID         string
	Class      string
	Attributes templ.Attributes
	Name       string
	// Value becomes the element's text content (the initial value).
	Value string
	// Form associates the textarea with a <form> by id, allowing it to
	// live outside the form element.
	Form        string
	Placeholder string
	// Rows is only emitted as the rows attribute when > 0.
	Rows int
	// AutoResize makes the field grow with its content (via
	// textarea.min.js) and hides the scrollbar/resize handle.
	AutoResize bool
	Disabled   bool
	Readonly   bool
	// HasError sets aria-invalid="true" and destructive border/ring styling.
	HasError bool
}

// Textarea renders a styled <textarea> whose initial content is
// Props.Value; it takes no children. With an empty ID the id is random on
// every render, so set ID whenever a stable id matters. AutoResize needs
// Script on the page.
templ Textarea(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	<textarea
		id={ p.ID }
		data-tui-textarea
		if p.Name != "" {
			name={ p.Name }
		}
		if p.Form != "" {
			form={ p.Form }
		}
		if p.Placeholder != "" {
			placeholder={ p.Placeholder }
		}
		if p.Rows > 0 {
			rows={ strconv.Itoa(p.Rows) }
		}
		disabled?={ p.Disabled }
		readonly?={ p.Readonly }
		if p.HasError {
			aria-invalid="true"
		}
		if p.AutoResize {
			data-tui-textarea-auto-resize="true"
		}
		class={
			utils.TwMerge(
				// Base styles
				"flex w-full min-w-0 rounded-md border border-input bg-transparent px-3 py-1 text-base shadow-xs transition-[color,box-shadow] outline-none md:text-sm",
				"min-h-[80px]", // Default min-height
				// Dark mode background
				"dark:bg-input/30",
				// Selection styles
				"selection:bg-primary selection:text-primary-foreground",
				// Placeholder
				"placeholder:text-muted-foreground",
				// Focus styles
				"focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]",
				// Disabled styles
				"disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50",
				// Error/Invalid styles
				"aria-invalid:ring-destructive/20 aria-invalid:border-destructive dark:aria-invalid:ring-destructive/40",
				utils.If(p.HasError, "border-destructive ring-destructive/20 dark:ring-destructive/40"),
				// Add overflow-hidden only if auto-resizing to prevent scrollbar flicker
				utils.If(p.AutoResize, "overflow-hidden resize-none"),
				p.Class,
			),
		}
		{ p.Attributes... }
	>{ p.Value }</textarea>
}

// Script emits the deferred script tag implementing AutoResize. Include it
// once per page when any Textarea uses AutoResize.
templ Script() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/static/js/textarea.min.js") }></script>
}
