// templui component label - version: v1.3.0 installed by templui v1.3.0
// 📚 Documentation: https://templui.io/docs/components/label
package label

import "github.com/bplus/webframe/utils"

// Props configures Label. Class merges after the built-in classes via
// utils.TwMerge; Attributes spread onto the <label>.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// For is the id of the control this label describes. Controls that
	// generate random ids (input, textarea) need an explicit matching ID.
	For string
	// Error, when non-empty, switches the label text to the destructive
	// color. The string itself is not rendered; use form.Message for it.
	Error string
}

// Label renders a <label> linked to a form control through Props.For.
// When Script is on the page, the label dims while its control is
// disabled.
templ Label(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<label
		if p.ID != "" {
			id={ p.ID }
		}
		if p.For != "" {
			for={ p.For }
		}
		class={
			utils.TwMerge(
				"text-sm font-medium leading-none inline-block",
				utils.If(len(p.Error) > 0, "text-destructive"),
				p.Class,
			),
		}
		data-tui-label-disabled-style="opacity-50 cursor-not-allowed"
		{ p.Attributes... }
	>
		{ children... }
	</label>
}

// Script emits the deferred script tag that dims a label while its control
// is disabled. Include it once per page.
templ Script() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/static/js/label.min.js") }></script>
}
