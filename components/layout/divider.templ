package layout

import "github.com/bplus/webframe/utils"

// DividerProps configures a Divider.
type DividerProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Label      string
}

// Divider renders a horizontal rule, optionally with a centered label
// between two rules.
templ Divider(props ...DividerProps) {
	{{ var p DividerProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Label == "" {
		<hr
			if p.ID != "" {
				id={ p.ID }
			}
			class={ utils.TwMerge("border-border", p.Class) }
			{ p.Attributes... }
		/>
	} else {
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			class={ utils.TwMerge("flex flex-row items-center gap-3", p.Class) }
			{ p.Attributes... }
		>
			<hr class="flex-1 border-border"/>
			<span class="text-sm text-muted-foreground">{ p.Label }</span>
			<hr class="flex-1 border-border"/>
		</div>
	}
}
