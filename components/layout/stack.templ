package layout

import "github.com/bplus/webframe/utils"

// StackProps configures a Stack.
type StackProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Gap        Gap
	Align      Align
}

// InlineProps configures an Inline row. A zero Align centers items
// vertically.
type InlineProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Gap        Gap
	Align      Align
	Justify    Justify
	Wrap       bool
}

func inlineAlign(a Align) string {
	if a == AlignStretch {
		return "items-center"
	}
	return alignClass(a)
}

func wrapClass(w bool) string {
	if w {
		return "flex-wrap"
	}
	return ""
}

// Stack lays children out vertically with a uniform gap.
//
// @pure
templ Stack(props ...StackProps) {
	{{ var p StackProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={ utils.TwMerge("flex flex-col", gapClass(p.Gap), alignClass(p.Align), p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Inline lays children out horizontally with a uniform gap, centered
// vertically by default.
//
// @pure
templ Inline(props ...InlineProps) {
	{{ var p InlineProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		class={
			utils.TwMerge(
				"flex flex-row",
				gapClass(p.Gap),
				inlineAlign(p.Align),
				justifyClass(p.Justify),
				wrapClass(p.Wrap),
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}
