package filterbar

import (
	"strings"

	"github.com/bplus/webframe/utils"
)

// FilterType selects which control a FilterConfig renders inside the
// bar. A FilterConfig with an unrecognized or empty Type renders
// nothing.
type FilterType string

// Filter control kinds.
const (
	// TypeSelect is a single-choice <select> dropdown built from Options.
	TypeSelect FilterType = "select"
	// TypeSearch is a text input debounced 400ms before triggering an update.
	TypeSearch FilterType = "search"
	// TypeToggle is a row of pill buttons; multiple pills may be
	// selected and their values are submitted comma-joined.
	TypeToggle FilterType = "toggle"
)

// FilterOption is one choice within a select or toggle filter.
// Selected marks it active in the initial render (the selected
// <option>, or a highlighted toggle pill).
type FilterOption struct {
	Label    string
	Value    string
	Selected bool
	// Attributes spread onto the <option> (TypeSelect only). One attribute
	// has a meaning: data-tui-filterbar-set-<name>="<value>" on the selected
	// option writes <value> into the bar's control named <name> before every
	// update, so one choice can set two parameters (e.g. a sort select whose
	// "Name ↓" option also sets dir=desc).
	Attributes templ.Attributes
}

// FilterConfig describes one control in a FilterBar.
type FilterConfig struct {
	// ID doubles as the control's name attribute and therefore the
	// query parameter key sent to Props.HxGet.
	ID string
	// Label is the small caption rendered beside the control.
	Label string
	// Placeholder is the empty first <option> for TypeSelect and the
	// input placeholder for TypeSearch; unused by TypeToggle.
	Placeholder string
	Type        FilterType
	// Options populate TypeSelect and TypeToggle controls; unused by
	// TypeSearch.
	Options []FilterOption
	// Value is the initial text of a TypeSearch input (rendered as its
	// value attribute when non-empty); unused by TypeSelect and
	// TypeToggle, whose state lives in Options[i].Selected. WithSelected
	// fills it from the query.
	Value string
	// PhoneOnly hides the control from md (768px) up. Its value is still
	// sent on every update, so the page should offer the same choice another
	// way on wider screens (listpage's Sort select stands in for the table's
	// sort headers).
	PhoneOnly bool
}

// Props configures FilterBar.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// Filters render in order as the bar's controls.
	Filters  []FilterConfig
	HxGet    string // HTMX endpoint to call on change
	HxTarget string // swap target selector
	HxSwap   string // swap strategy (default "innerHTML")
	// ShowReset appends a "Clear filters" button that resets every
	// control and re-triggers the update.
	ShowReset bool
	// Hidden renders one hidden input per entry (sorted by key), sent along
	// with every filter change. It is meant for list state that is not a
	// filter (sort, dir, per), so changing a filter keeps the sort; "Clear
	// filters" leaves it alone. With Props.ID set each input gets id
	// HiddenID(ID, name), so another response can replace it out of band
	// (see HiddenOOB).
	//
	// A key that is also the ID of a TypeSelect or TypeSearch control renders
	// no input: that control carries the state instead, taking the input's id
	// and surviving "Clear filters" the same way, and the map value is
	// ignored. Toggles are not promoted this way.
	Hidden map[string]string
	// Drop names query parameters, beyond the bar's own controls, removed
	// from the page URL on every change. A list page names its page
	// parameter, since a filter change goes back to page 1.
	Drop []string
}

// FilterBar renders a row of filter controls (selects, debounced search
// inputs, toggle pills) and an optional reset button that drive htmx partial
// reloads. On any change filterbar.min.js collects every control's value into
// query parameters keyed by FilterConfig.ID (multi-selected toggles
// comma-joined), GETs HxGet, swaps the response into HxTarget, dispatches a
// bubbling "filterbar-change" event, and mirrors the parameters into the page
// URL. Parameters the bar does not own stay in the URL. Controls come only
// from Props.Filters; children are not accepted. It is inert unless Script
// and htmx are both on the page.
//
// The script is exposed as window.tui.filterbar with getParams(bar),
// trigger(bar) and reset(bar), where bar is the root <div>; reset does what
// the "Clear filters" button does.
templ FilterBar(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ hxSwap := p.HxSwap }}
	if hxSwap == "" {
		{{ hxSwap = "innerHTML" }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-tui-filterbar
		data-tui-filterbar-hx-get={ p.HxGet }
		data-tui-filterbar-hx-target={ p.HxTarget }
		data-tui-filterbar-hx-swap={ hxSwap }
		if len(p.Drop) > 0 {
			data-tui-filterbar-drop={ strings.Join(p.Drop, ",") }
		}
		class={
			utils.TwMerge(
				"flex flex-wrap items-center gap-3 p-3 bg-card border border-border rounded-lg",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		for _, k := range sortedKeys(p.Hidden) {
			{{ _, promoted := stateControl(p.Filters, k) }}
			if !promoted {
				@hiddenInput(p.ID, k, p.Hidden[k], false)
			}
		}
		for _, f := range p.Filters {
			{{ _, state := p.Hidden[f.ID] }}
			{{ state = state && (f.Type == TypeSelect || f.Type == TypeSearch) }}
			{{ id := utils.If(state, HiddenID(p.ID, f.ID)) }}
			switch f.Type {
				case TypeSelect:
					@filterSelect(f, id, state)
				case TypeSearch:
					@filterSearch(f, id, state)
				case TypeToggle:
					@filterToggle(f)
			}
		}
		if p.ShowReset {
			<button
				type="button"
				data-tui-filterbar-reset
				class="ml-auto text-xs text-muted-foreground hover:text-foreground transition-colors"
			>
				Clear filters
			</button>
		}
	</div>
}

// hiddenInput is one hidden control: an id only when the bar has one
// (HiddenID), the control marker so filterbar.min.js reads it, and
// hx-swap-oob="true" when rendered by HiddenOOB.
templ hiddenInput(barID, name, value string, oob bool) {
	<input
		type="hidden"
		if barID != "" {
			id={ HiddenID(barID, name) }
		}
		name={ name }
		value={ value }
		data-tui-filterbar-control
		if oob {
			hx-swap-oob="true"
		}
	/>
}

// HiddenOOB renders a bar's hidden inputs again with hx-swap-oob="true", for
// a response that swaps some other region of the page. htmx then replaces the
// bar's inputs, so list state changed outside the bar (a sort chosen from a
// table header) is what the next filter change sends. barID and hidden must
// match what FilterBar rendered; render it at the top level of the response.
// Nothing renders without a barID.
//
// controls are the bar's state-carrying controls (see Props.Hidden) with
// their current values; each is rendered bare in its input's place so it
// shows the state the response served. Controls whose ID is not a key of
// hidden are ignored.
templ HiddenOOB(barID string, hidden map[string]string, controls ...FilterConfig) {
	if barID != "" {
		for _, k := range sortedKeys(hidden) {
			{{ f, promoted := stateControl(controls, k) }}
			if promoted && f.Type == TypeSelect {
				@selectControl(f, HiddenID(barID, k), true, true)
			} else if promoted {
				@searchControl(f, HiddenID(barID, k), true, true)
			} else {
				@hiddenInput(barID, k, hidden[k], true)
			}
		}
	}
}

// wrapperClass is the class list of a control's label+control wrapper:
// md:hidden when the control is PhoneOnly.
func wrapperClass(f FilterConfig) string {
	return utils.TwMerge("flex items-center gap-2", utils.If(f.PhoneOnly, "md:hidden"))
}

// filterSelect is a labelled select; id and state are set when the
// control carries list state (see Props.Hidden).
templ filterSelect(f FilterConfig, id string, state bool) {
	<div class={ wrapperClass(f) }>
		<label
			if id != "" {
				for={ id }
			}
			class="text-xs font-medium text-muted-foreground whitespace-nowrap"
		>{ f.Label }</label>
		@selectControl(f, id, state, false)
	</div>
}

// selectControl is the bare <select>: an id when given, the control
// marker, the state marker when it carries list state, and
// hx-swap-oob="true" when rendered by HiddenOOB. Each option spreads its
// Attributes last.
templ selectControl(f FilterConfig, id string, state, oob bool) {
	<select
		if id != "" {
			id={ id }
		}
		name={ f.ID }
		data-tui-filterbar-control
		if state {
			data-tui-filterbar-state
		}
		if oob {
			hx-swap-oob="true"
		}
		class="h-8 rounded-md border border-input bg-background px-2 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-ring"
	>
		if f.Placeholder != "" {
			<option value="">{ f.Placeholder }</option>
		}
		for _, opt := range f.Options {
			<option
				value={ opt.Value }
				if opt.Selected {
					selected
				}
				{ opt.Attributes... }
			>{ opt.Label }</option>
		}
	</select>
}

// filterSearch is a labelled search box; id and state as for
// filterSelect.
templ filterSearch(f FilterConfig, id string, state bool) {
	<div class={ wrapperClass(f) }>
		<label
			if id != "" {
				for={ id }
			}
			class="text-xs font-medium text-muted-foreground whitespace-nowrap"
		>{ f.Label }</label>
		@searchControl(f, id, state, false)
	</div>
}

// searchControl is the bare search <input>; id, state and oob as for
// selectControl.
templ searchControl(f FilterConfig, id string, state, oob bool) {
	<input
		type="search"
		if id != "" {
			id={ id }
		}
		name={ f.ID }
		data-tui-filterbar-control
		if state {
			data-tui-filterbar-state
		}
		if oob {
			hx-swap-oob="true"
		}
		if f.Value != "" {
			value={ f.Value }
		}
		data-tui-filterbar-debounce="400"
		placeholder={ f.Placeholder }
		class="h-8 rounded-md border border-input bg-background px-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring w-48"
	/>
}

templ filterToggle(f FilterConfig) {
	<div class="flex items-center gap-2">
		<span class="text-xs font-medium text-muted-foreground whitespace-nowrap">{ f.Label }</span>
		<div class="flex gap-1">
			for _, opt := range f.Options {
				<button
					type="button"
					name={ f.ID }
					value={ opt.Value }
					data-tui-filterbar-toggle
					if opt.Selected {
						data-tui-filterbar-toggle-selected="true"
						class="px-2.5 py-1 rounded-full text-xs font-medium border transition-colors border-primary bg-primary text-primary-foreground"
					} else {
						data-tui-filterbar-toggle-selected="false"
						class="px-2.5 py-1 rounded-full text-xs font-medium border transition-colors border-border bg-background text-muted-foreground hover:bg-accent hover:text-accent-foreground"
					}
				>{ opt.Label }</button>
			}
		</div>
	</div>
}

// Script loads filterbar.min.js. Include it once per page, alongside htmx.
templ Script() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/static/js/filterbar.min.js") }></script>
}
