package filterbar

import "github.com/bplus/webframe/utils"

// FilterType selects which control a FilterConfig renders inside the
// bar. A FilterConfig with an unrecognized or empty Type renders
// nothing.
type FilterType string

// Filter control kinds.
const (
	// TypeSelect is a single-choice <select> dropdown built from Options.
	TypeSelect FilterType = "select"
	// TypeSearch is a text input debounced 400ms before triggering an update.
	TypeSearch FilterType = "search"
	// TypeToggle is a row of pill buttons; multiple pills may be
	// selected and their values are submitted comma-joined.
	TypeToggle FilterType = "toggle"
)

// FilterOption is one choice within a select or toggle filter.
// Selected marks it active in the initial render (the selected
// <option>, or a highlighted toggle pill).
type FilterOption struct {
	Label    string
	Value    string
	Selected bool
}

// FilterConfig describes one control in a FilterBar.
type FilterConfig struct {
	// ID doubles as the control's name attribute and therefore the
	// query parameter key sent to Props.HxGet.
	ID string
	// Label is the small caption rendered beside the control.
	Label string
	// Placeholder is the empty first <option> for TypeSelect and the
	// input placeholder for TypeSearch; unused by TypeToggle.
	Placeholder string
	Type        FilterType
	// Options populate TypeSelect and TypeToggle controls; unused by
	// TypeSearch.
	Options []FilterOption
	// Value is the initial text of a TypeSearch input (rendered as its
	// value attribute when non-empty); unused by TypeSelect and
	// TypeToggle, whose state lives in Options[i].Selected. WithSelected
	// fills it from the query.
	Value string
}

// Props configures FilterBar. Class merges after the built-in classes
// via utils.TwMerge; Attributes spread onto the container <div>.
type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// Filters render in order as the bar's controls.
	Filters  []FilterConfig
	HxGet    string // HTMX endpoint to call on change
	HxTarget string // swap target selector
	HxSwap   string // swap strategy (default "innerHTML")
	// ShowReset appends a "Clear filters" button that resets every
	// control and re-triggers the update.
	ShowReset bool
	// Hidden renders one <input type="hidden"> per entry (sorted by key)
	// carrying the control marker, so filterbar.min.js sends these
	// parameters along with every filter change. Meant for list state
	// that is not a filter — sort, dir, per — so changing a filter keeps
	// the sort. "Clear filters" leaves hidden inputs alone. nil renders
	// nothing.
	Hidden map[string]string
}

// FilterBar renders a horizontal bar of filter controls (selects,
// debounced search inputs, toggle pills) plus an optional reset
// button, built to drive HTMX partial reloads: on any change,
// /static/js/filterbar.min.js collects every control's value into
// query parameters (keyed by FilterConfig.ID; multi-selected toggle
// values comma-joined), issues htmx.ajax GET to HxGet, and swaps the
// response into HxTarget using HxSwap (default "innerHTML"). The
// script also dispatches a bubbling "filterbar-change" CustomEvent and
// mirrors the params into the page URL via history.replaceState.
//
// Accepts zero or one Props (elements past the first are ignored).
// The markup itself only carries data-tui-filterbar-* attributes;
// children are not accepted — controls come solely from Props.
// Filters. Returns a templ.Component rooted at the container <div>.
//
// @boundary at runtime the bar issues GET requests to HxGet and
// rewrites the browser URL — server handlers must accept the
// FilterConfig.ID query parameters.
// @temporal-coupling inert unless both Script() and htmx are loaded
// on the page.
// The root <div> emits id={ p.ID } only when Props.ID is non-empty, so a
// bar without an explicit ID renders no id attribute at all (contrast
// graphwidget, which renders id={ id } unconditionally).
//
// Props.Hidden entries render first, as hidden inputs in sorted key
// order; they take no space, so the bar's phone-width wrapping is
// unchanged by them.
templ FilterBar(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ hxSwap := p.HxSwap }}
	if hxSwap == "" {
		{{ hxSwap = "innerHTML" }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-tui-filterbar
		data-tui-filterbar-hx-get={ p.HxGet }
		data-tui-filterbar-hx-target={ p.HxTarget }
		data-tui-filterbar-hx-swap={ hxSwap }
		class={
			utils.TwMerge(
				"flex flex-wrap items-center gap-3 p-3 bg-card border border-border rounded-lg",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		for _, k := range sortedKeys(p.Hidden) {
			<input type="hidden" name={ k } value={ p.Hidden[k] } data-tui-filterbar-control/>
		}
		for _, f := range p.Filters {
			switch f.Type {
				case TypeSelect:
					@filterSelect(f)
				case TypeSearch:
					@filterSearch(f)
				case TypeToggle:
					@filterToggle(f)
			}
		}
		if p.ShowReset {
			<button
				type="button"
				data-tui-filterbar-reset
				class="ml-auto text-xs text-muted-foreground hover:text-foreground transition-colors"
			>
				Clear filters
			</button>
		}
	</div>
}

templ filterSelect(f FilterConfig) {
	<div class="flex items-center gap-2">
		<label class="text-xs font-medium text-muted-foreground whitespace-nowrap">{ f.Label }</label>
		<select
			name={ f.ID }
			data-tui-filterbar-control
			class="h-8 rounded-md border border-input bg-background px-2 text-sm text-foreground focus:outline-none focus:ring-1 focus:ring-ring"
		>
			if f.Placeholder != "" {
				<option value="">{ f.Placeholder }</option>
			}
			for _, opt := range f.Options {
				<option
					value={ opt.Value }
					if opt.Selected {
						selected
					}
				>{ opt.Label }</option>
			}
		</select>
	</div>
}

templ filterSearch(f FilterConfig) {
	<div class="flex items-center gap-2">
		<label class="text-xs font-medium text-muted-foreground whitespace-nowrap">{ f.Label }</label>
		<input
			type="search"
			name={ f.ID }
			data-tui-filterbar-control
			if f.Value != "" {
				value={ f.Value }
			}
			data-tui-filterbar-debounce="400"
			placeholder={ f.Placeholder }
			class="h-8 rounded-md border border-input bg-background px-2 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring w-48"
		/>
	</div>
}

templ filterToggle(f FilterConfig) {
	<div class="flex items-center gap-2">
		<span class="text-xs font-medium text-muted-foreground whitespace-nowrap">{ f.Label }</span>
		<div class="flex gap-1">
			for _, opt := range f.Options {
				<button
					type="button"
					name={ f.ID }
					value={ opt.Value }
					data-tui-filterbar-toggle
					if opt.Selected {
						data-tui-filterbar-toggle-selected="true"
						class="px-2.5 py-1 rounded-full text-xs font-medium border transition-colors border-primary bg-primary text-primary-foreground"
					} else {
						data-tui-filterbar-toggle-selected="false"
						class="px-2.5 py-1 rounded-full text-xs font-medium border transition-colors border-border bg-background text-muted-foreground hover:bg-accent hover:text-accent-foreground"
					}
				>{ opt.Label }</button>
			}
		</div>
	</div>
}

// Script emits the deferred <script> tag implementing FilterBar
// behavior: change listeners, per-attribute search debounce, toggle
// pill state, reset, URL sync, and the htmx.ajax dispatch. CSP-nonced
// via templ.GetNonce, cache-busted via utils.ScriptURL; include once
// per page alongside htmx.
//
// @idempotent same output for a given render context (the ?v= version
// is fixed at startup; only the CSP nonce from templ.GetNonce varies
// per request).
templ Script() {
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/static/js/filterbar.min.js") }></script>
}
