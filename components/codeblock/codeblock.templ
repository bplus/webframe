package codeblock

import "github.com/bplus/webframe/components/copybutton"

// CodeBlock renders Props.Code in a <figure>, with a header row only when
// Language or Copy is set. Line numbers are pure CSS (the .wf-code rules in
// static/css/input.css). A <pre> that can scroll gets tabindex="0" so
// keyboard users can scroll it.
templ CodeBlock(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<figure
		if p.ID != "" {
			id={ p.ID }
		}
		class={ p.rootClass() }
		if p.LineNumbers {
			data-wf-code-numbered
			style={ p.digitsStyle() }
		}
		{ p.Attributes... }
	>
		if p.hasHeader() {
			<div class="flex flex-wrap items-center justify-between gap-2 border-b border-border px-3 py-1.5">
				if p.Language != "" {
					<span class="font-mono text-xs text-muted-foreground">{ p.Language }</span>
				} else {
					<span></span>
				}
				if p.Copy {
					@copybutton.CopyButton(copybutton.Props{
						Value:      p.Code,
						Size:       copybutton.SizeSm,
						Attributes: templ.Attributes{"aria-label": "Copy code", "title": "Copy code"},
					})
				}
			</div>
		}
		<pre
			class={ p.preClass() }
			if p.scrollable() {
				tabindex="0"
			}
		>
			<code
				if p.codeClass() != "" {
					class={ p.codeClass() }
				}
			>
				if p.LineNumbers {
					for _, line := range p.lines() {
						<span class="wf-code-line">{ line }</span>
					}
				} else {
					{ p.text() }
				}
			</code>
		</pre>
		if p.Caption != "" {
			<figcaption class="border-t border-border px-3 py-1.5 text-xs text-muted-foreground">{ p.Caption }</figcaption>
		}
	</figure>
}
