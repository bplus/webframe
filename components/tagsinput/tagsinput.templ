package tagsinput

import (
	"github.com/bplus/webframe/components/badge"
	"github.com/bplus/webframe/components/icon"
	"github.com/bplus/webframe/components/input"
	"github.com/bplus/webframe/utils"
)

// TagsInput renders the tag editor: the hidden field, a framed box holding
// the chip list and the text input, then a hint paragraph (screen-reader
// instructions plus the "n/max" count when MaxTags is set).
templ TagsInput(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{ p = p.resolve() }}
	<div
		id={ p.rootID() }
		class={ utils.TwMerge("w-full", p.Class) }
		x-data={ alpineData }
		data-max={ p.maxAttr() }
		data-sep={ p.Separator }
		data-placeholder={ p.Placeholder }
		if p.Disabled {
			data-disabled
		}
	>
		if p.Name != "" {
			<input
				type="hidden"
				name={ p.Name }
				value={ p.joined() }
				x-bind:value="tags.join(sep)"
				disabled?={ p.Disabled }
			/>
		}
		<div class={ p.frameClass() }>
			<ul id={ p.listID() } role="list" aria-label="Tags" class="contents">
				for _, tag := range p.Values {
					<li data-tag={ tag } class="max-w-full">
						@chip(p, tag, false)
					</li>
				}
				<template x-for="(tag, i) in tags" :key="tag">
					<li class="max-w-full">
						@chip(p, "", true)
					</li>
				</template>
			</ul>
			<div class="min-w-32 flex-1">
				@input.Input(input.Props{
					ID:          p.ID,
					Placeholder: utils.IfElse(p.atMax(), "Limit reached", p.Placeholder),
					Readonly:    p.atMax(),
					Disabled:    p.Disabled,
					HasError:    p.HasError,
					Class:       textInputClass,
					Attributes:  p.inputAttrs(),
				})
			</div>
		</div>
		<p id={ p.HintID() } class="mt-1 text-xs text-muted-foreground">
			<span class="sr-only">{ p.hintText() }</span>
			if p.MaxTags > 0 {
				<span x-text="tags.length + '/' + max">{ p.count() }</span>
			}
		</p>
		if len(p.Suggestions) > 0 {
			<datalist id={ p.optionsID() }>
				for _, s := range p.Suggestions {
					<option value={ s }></option>
				}
			</datalist>
		}
	</div>
}

// chip renders one tag as a secondary badge with a remove button. With
// live set the text and the button are bound to the x-for scope (tag, i);
// otherwise label is the server-rendered tag. The remove button is a 24px
// target inside the chip (negative vertical margin keeps the chip height).
templ chip(p Props, label string, live bool) {
	@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "max-w-full gap-1 pr-0.5"}) {
		if live {
			<span class="truncate" x-text="tag"></span>
		} else {
			<span class="truncate">{ label }</span>
		}
		<button
			type="button"
			class="-my-1.5 inline-flex size-6 shrink-0 items-center justify-center rounded-sm opacity-70 transition-opacity hover:opacity-100 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none"
			if live {
				x-bind:aria-label="'Remove ' + tag"
				x-bind:disabled="disabled"
				x-on:click="removeAt(i)"
			} else {
				aria-label={ "Remove " + label }
				disabled?={ p.Disabled }
			}
		>
			@icon.X(icon.Props{Size: 12})
		</button>
	}
}
